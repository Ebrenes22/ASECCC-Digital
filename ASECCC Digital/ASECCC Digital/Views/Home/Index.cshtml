@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section id="hero" class="hero section">
    <div class="hero-background">
        <img src="~/assets/img/wallpaper/wp3404276.jpg" alt="Fondo" class="img-fluid" />
    </div>
    <div class="container hero-content text-center text-black">
        <h1 class="display-4">¡Bienvenidos a ASECCC Digital!</h1>
        <p class="lead">Estamos comprometidos a brindarte lo mejor.</p>
    </div>
</section>

<section id="info-section" class="py-5">
    <div class="container">
        <div class="row">
            <!-- Misión -->
            <div class="col-md-6 mb-4">
                <div class="card shadow">
                    <div class="card-body">
                        <h2 class="card-title text-center">Misión</h2>
                        <p class="card-text">Ofrecer servicios y beneficios innovadores que impulsen el bienestar económico, social y personal de nuestros asociados, fomentando valores de solidaridad, cooperación y responsabilidad compartida para mejorar su calidad de vida y fortalecer la comunidad.</p>
                    </div>
                </div>
            </div>

            <!-- Visión -->
            <div class="col-md-6 mb-4">
                <div class="card shadow">
                    <div class="card-body">
                        <h2 class="card-title text-center">Visión</h2>
                        <p class="card-text">Convertirnos en un pilar fundamental para el progreso económico y social de nuestros asociados, promoviendo la solidaridad y el trabajo conjunto como herramientas para alcanzar el bienestar común y el desarrollo sostenible de nuestras comunidades.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>



