@model ASECCC_Digital.ViewModels.EstadoCuentaViewModel

@{
    ViewBag.Title = "Estado de Cuenta";
    Layout = "~/Views/Shared/_Layout.cshtml";
    @Html.Partial("_MenuModulos");
}

<link href="~/assets/css/estadodecuenta.css" rel="stylesheet" />

<div class="documento-container">

    <a href="@Url.Action("GenerarEstadoAsociado", "Reportes")">
    </a>

    <div class="pdf-hide" style="border-bottom: 1px solid #ccc; margin: 20px 0;"></div>

    @if (Model.UsuarioSeleccionado != null)
    {
        <div class="documento-header" style="display: flex; align-items: center; justify-content: space-between;">
            <img src="~/Assets/img/logos/ASECCC_LOGO_1.png" alt="Logo" style="height: 150px;" />
            <div style="flex: 1; text-align: center;">
                <h1>Asociación Solidarista De Empleados De Cadena Comercial Cartaginesa</h1>
                <h2>Estado de Cuenta</h2>
                <h6 id="fechaActual"></h6>
            </div>
        </div>

        <table class="table documento-datos-usuario ">
            <tr>
                <th>Nombre del asociado:</th>
                <td>@Model.UsuarioSeleccionado.nombreCompleto</td>
            </tr>
            <tr>
                <th>Identificación:</th>
                <td>@Model.UsuarioSeleccionado.identificacion</td>
            </tr>
            <tr>
                <th>Estado de afiliación:</th>
                <td>
                    @(!string.IsNullOrEmpty(Model.UsuarioSeleccionado.estadoAfiliacion)
        ? char.ToUpper(Model.UsuarioSeleccionado.estadoAfiliacion[0]) + Model.UsuarioSeleccionado.estadoAfiliacion.Substring(1)
        : "")
                </td>
            </tr>
            <tr>
                <th>Fecha de ingreso:</th>
                <td>@Convert.ToDateTime(Model.UsuarioSeleccionado.fechaIngreso).ToString("dd/MM/yyyy")</td>
            </tr>
        </table>
    }

    @if (Model.UsuarioIdSeleccionado > 0)
    {
        <div class="seccion-titulo page-break">Aportes</div>
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Tipo Aporte</th>
                    <th>Monto</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Aportes != null && Model.Aportes.Any())
                {
                    foreach (var ap in Model.Aportes)
                    {
                        <tr>
                            <td>@(char.ToUpper(ap.tipoAporte[0]) + ap.tipoAporte.Substring(1).ToLower())</td>
                            <td>@ap.monto.ToString("N2")</td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="2" class="text-center">Sin datos</td></tr>
                }
            </tbody>
        </table>

        <div class="seccion-titulo page-break">Ahorros</div>
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Fecha Inicio</th>
                    <th>Nombre Ahorro</th>
                    <th>Monto Actual</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Ahorros != null && Model.Ahorros.Any())
                {
                    foreach (var a in Model.Ahorros)
                    {
                        <tr>
                            <td>
                                @(a.fechaInicio != null ? Convert.ToDateTime(a.fechaInicio).ToString("dd/MM/yyyy") : "Sin fecha")
                            </td>

                            <td>
                                @(a.CatalogoTipoAhorro != null && !string.IsNullOrEmpty(a.CatalogoTipoAhorro.tipoAhorro)
                        ? char.ToUpper(a.CatalogoTipoAhorro.tipoAhorro[0]) + a.CatalogoTipoAhorro.tipoAhorro.Substring(1).ToLower()
                        : "Sin nombre")
                            </td>
                            <td>@a.montoActual.ToString("N2")</td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="5" class="text-center">Sin datos</td></tr>
                }
            </tbody>

        </table>

        <div class="seccion-titulo page-break">Préstamos</div>
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Tipo Préstamo</th>
                    <th>Monto Aprobado</th>
                    <th>Saldo</th>

                </tr>
            </thead>
            <tbody>
                @if (Model.Prestamos != null && Model.Prestamos.Any())
                {
                    foreach (var p in Model.Prestamos)
                    {
                        <tr>
                            <td>
                                @(p.fechaEstado != null ? Convert.ToDateTime(p.fechaEstado).ToString("dd/MM/yyyy") : "Sin fecha")
                            </td>

                            <td>@(char.ToUpper(p.tipoPrestamo[0]) + p.tipoPrestamo.Substring(1).ToLower())</td>
                            <td>@(p.montoAprobado.HasValue ? p.montoAprobado.Value.ToString("N2") : "0.00")</td>
                            <td>@(p.saldoPendiente.HasValue ? p.saldoPendiente.Value.ToString("N2") : "0.00")</td>

                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="5" class="text-center">Sin datos</td></tr>
                }
            </tbody>
        </table>

        <div class="seccion-titulo page-break">Beneficios</div>
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Nombre Servicio</th>
                    <th>Monto Total</th>
                    <th>Monto Pendiente</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Beneficios != null && Model.Beneficios.Any())
                {
                    foreach (var b in Model.Beneficios)
                    {
                        <tr>
                            <td>
                                @(b.fechaCreacion != null ? Convert.ToDateTime(b.fechaCreacion).ToString("dd/MM/yyyy") : "Sin fecha")
                            </td>
                            <td>
                                @(b.BeneficiosServicios != null && !string.IsNullOrEmpty(b.BeneficiosServicios.nombre)
                        ? char.ToUpper(b.BeneficiosServicios.nombre[0]) + b.BeneficiosServicios.nombre.Substring(1).ToLower()
                        : "Sin nombre")
                            </td>
                            <td>@b.montoTotal.ToString("N2")</td>
                            <td>@b.montoPendiente.ToString("N2")</td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="3" class="text-center">Sin datos</td></tr>
                }
            </tbody>


        </table>

        <div style="display: flex; justify-content: center;">
            <table class="table table-bordered" style="max-width: 500px; margin-top: 30px;">
                <thead>
                    <tr style="background-color: #f1f6fc;">
                        <th colspan="2" style="text-align: center; color: #2e6da4;"> Resumen Financiero</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Total aportes</td>
                        <td>₡@Model.Aportes.Sum(x => x.monto).ToString("N2")</td>
                    </tr>
                    <tr>
                        <td>Saldo actual en ahorros</td>
                        <td>₡@Model.Ahorros.Sum(x => x.montoActual).ToString("N2")</td>
                    </tr>
                    <tr>
                        <td>Total préstamos pendientes</td>
                        <td>₡@Model.Prestamos.Sum(x => x.saldoPendiente ?? 0).ToString("N2")</td>
                    </tr>
                    <tr>
                        <td>Total beneficios pendientes</td>
                        <td>₡@Model.Beneficios.Sum(x => x.montoPendiente).ToString("N2")</td>
                    </tr>
                </tbody>
            </table>
        </div>


        <div class="btn-pdf pdf-hide">
            <button type="button" class="btn btn-success" onclick="descargarVistaComoPDF()">Descargar PDF</button>
        </div>

        <div class="only-pdf-force" style="display: none; margin-top: 50px; font-size: 12px; text-align: center; border-top: 1px solid #ccc; padding-top: 15px;">
            <p><strong>Asociación Solidarista Cadena Comercial Cartaginesa</strong></p>
            <p>Cartago, Costa Rica · Tel: 2551-0782 · aseccc.cartago2009@gmail.com · www.asecccdigital.com</p>
            <p>Estado generado el @DateTime.Now.ToString("dd/MM/yyyy")</p>
            <p style="font-style: italic;">Este documento es confidencial y exclusivo para el asociado.</p>
            <br /><br />
        </div>

    }



</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

<script>
    const hoy = new Date();
    const dia = String(hoy.getDate()).padStart(2, '0');
    const mes = String(hoy.getMonth() + 1).padStart(2, '0');
    const anio = hoy.getFullYear();
    const fechaFormateada = `${dia}/${mes}/${anio}`;

    document.getElementById("fechaActual").textContent = "Fecha: " + fechaFormateada;

    function descargarVistaComoPDF() {
        const element = document.querySelector(".documento-container");


        document.querySelectorAll('.only-pdf-force').forEach(el => el.style.display = 'block');

        document.querySelectorAll('.pdf-hide').forEach(el => el.style.display = 'none');

        const opt = {
            margin: [0.5, 0.5, 0.5, 0.5],
            filename: 'EstadoCuenta.pdf',
            image: { type: 'jpeg', quality: 0.98 },
            html2canvas: { scale: 3 },
            jsPDF: { unit: 'in', format: 'letter', orientation: 'portrait' }
        };

        html2pdf().set(opt).from(element).save().then(() => {
            document.querySelectorAll('.only-pdf-force').forEach(el => el.style.display = 'none');
            document.querySelectorAll('.pdf-hide').forEach(el => el.style.display = 'block');
        });
    }
</script>
