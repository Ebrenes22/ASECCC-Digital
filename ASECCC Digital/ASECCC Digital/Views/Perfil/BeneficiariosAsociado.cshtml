@model ASECCC_Digital.Entities.Beneficiario
@{
    ViewBag.Title = "Administración beneficiarios";
    Layout = "~/Views/Shared/_Layout.cshtml";
    @Html.Partial("_MenuModulos");
}

<section class="container mt-5">
    <h1 class="text-center mb-4">ADMINISTRAR BENEFICIARIOS</h1>

    <div class="text-end mb-3">
        <button class="btn btn-success" onclick="abrirModalRegistro()">Agregar</button>
    </div>

    <!-- Contenedor de Beneficiarios -->
    <div id="contenedorBeneficiarios" class="row g-3">
        <!-- Aquí se insertarán los beneficiarios dinámicamente -->
    </div>
</section>

<!-- Modal de Registro/Edición de Beneficiarios -->
<div class="modal fade" id="modalBeneficiario" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Gestionar Beneficiario</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                @using (Html.BeginForm("", "", FormMethod.Post, new { id = "formBeneficiario" }))
                {
                    @Html.HiddenFor(model => model.BeneficiarioId, new { id = "beneficiarioId" })

                    <div class="mb-2">
                        @Html.LabelFor(model => model.NombreCompleto, "Nombre Completo: ", new { @class = "form-label" })
                        @Html.TextBoxFor(model => model.NombreCompleto, new { @class = "form-control", id = "nombreBeneficiario", placeholder = "Ingrese el nombre", required = "required" })
                    </div>

                    <div class="mb-2">
                        @Html.LabelFor(model => model.Relacion, "Relación: ", new { @class = "form-label" })
                        @Html.TextBoxFor(model => model.Relacion, new { @class = "form-control", id = "relacionBeneficiario", placeholder = "Ejemplo: Hijo, Cónyuge", required = "required" })
                    </div>

                    <div class="mb-3">
                        @Html.LabelFor(model => model.PorcentajeBeneficio, "Porcentaje de beneficio: ", new { @class = "form-label" })
                        @Html.TextBoxFor(model => model.PorcentajeBeneficio, new { @class = "form-control", id = "porcentajeBeneficio", type = "number", min = "1", max = "100", required = "required" })
                    </div>

                    <div class="text-end">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="button" class="btn btn-primary" onclick="guardarBeneficiario()">Guardar</button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        $(document).ready(function () {
            cargarBeneficiarios();
        });

        // Validación en tiempo real para el porcentaje
        $("#porcentajeBeneficio").on("input", function () {
            let valor = $(this).val().replace(/[^0-9]/g, ""); 
            let numero = parseInt(valor, 10);

            if (isNaN(numero)) {
                $(this).val(""); 
            } else if (numero < 0) {
                $(this).val("0"); 
            } else if (numero > 100) {
                $(this).val("100"); 
            } else {
                $(this).val(numero); 
            }
        });

        function cargarBeneficiarios() {
            $.get("/Perfil/ObtenerBeneficiarios", function (data) {
                let contenedor = $("#contenedorBeneficiarios").empty();
                if (data.success) {
                    data.beneficiarios.forEach(b => {
                        contenedor.append(`
                                <div class="col-12 col-md-6">
                                    <div class="card shadow-sm p-3">
                                        <h5 class="fw-bold">${b.nombreCompleto}</h5>
                                        <p class="text-muted">Relación: ${b.relacion}</p>
                                        <p><strong>Porcentaje:</strong> ${b.porcentajeBeneficio}%</p>
                                        <div class="d-flex justify-content-end">
                                            <button class="btn btn-warning btn-sm me-2" onclick="editarBeneficiario(${b.beneficiarioId}, '${b.nombreCompleto}', '${b.relacion}', ${b.porcentajeBeneficio})">Editar</button>
                                            <button class="btn btn-danger btn-sm" onclick="eliminarBeneficiario(${b.beneficiarioId})">Eliminar</button>
                                        </div>
                                    </div>
                                </div>
                            `);
                    });
                }
            });
        }

        function abrirModalRegistro() {
            $("#beneficiarioId").val("");
            $("#nombreBeneficiario").val("");
            $("#relacionBeneficiario").val("");
            $("#porcentajeBeneficio").val("");
            $("#modalBeneficiario").modal("show");
        }

        function editarBeneficiario(id, nombre, relacion, porcentaje) {
            $("#beneficiarioId").val(id);
            $("#nombreBeneficiario").val(nombre);
            $("#relacionBeneficiario").val(relacion);
            $("#porcentajeBeneficio").val(porcentaje);
            $("#modalBeneficiario").modal("show");
        }

        function guardarBeneficiario() {
            let id = $("#beneficiarioId").val();
            let nombre = $("#nombreBeneficiario").val().trim();
            let relacion = $("#relacionBeneficiario").val().trim();
            let porcentaje = parseFloat($("#porcentajeBeneficio").val()) || 0;

            if (nombre === "" || relacion === "" || porcentaje <= 0 || porcentaje > 100) {
                Swal.fire("Error", "Por favor complete todos los campos correctamente.", "error");
                return;
            }

            let url = id ? "/Perfil/ModificarBeneficiario" : "/Perfil/RegistrarBeneficiario";
            let datos = {
                BeneficiarioId: id,
                NombreCompleto: nombre,
                Relacion: relacion,
                PorcentajeBeneficio: porcentaje
            };

            $.post(url, datos, function (data) {
                Swal.fire(data.success ? "¡Éxito!" : "Error", data.message, data.success ? "success" : "error");
                if (data.success) {
                    $("#modalBeneficiario").modal("hide");
                    cargarBeneficiarios();
                }
            });
        }

        function eliminarBeneficiario(id) {
            Swal.fire({
                title: "¿Eliminar beneficiario?",
                text: "El porcentaje se redistribuirá entre los demás beneficiarios.",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#d33",
                cancelButtonColor: "#3085d6",
                confirmButtonText: "Sí, eliminar",
                cancelButtonText: "Cancelar"
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post("/Perfil/EliminarBeneficiario", { beneficiarioId: id }, function (data) {
                        Swal.fire("Información", data.message, data.success ? "success" : "error");
                        cargarBeneficiarios();
                    });
                }
            });
        }
    </script>
}