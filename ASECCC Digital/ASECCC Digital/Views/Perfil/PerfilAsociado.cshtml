@model ASECCC_Digital.Entities.Usuario

@{
    ViewBag.Title = "Mi Información Personal";
    Layout = "~/Views/Shared/_Layout.cshtml";
    @Html.Partial("_MenuModulos");
}

<section class="container mt-5">
    <h1 class="text-center mb-4">Mi Información Personal</h1>

    <div class="card shadow p-4 mx-auto" style="max-width: 700px;">
        <div class="row">
            <div class="col-md-6 col-12 mb-3">
                @Html.LabelFor(model => model.NombreCompleto, "Nombre Completo:", new { @class = "fw-bold" })
                <div id="nombreCompleto">@Html.DisplayFor(model => model.NombreCompleto)</div>
            </div>
            <div class="col-md-6 col-12 mb-3">
                @Html.LabelFor(model => model.Identificacion, "Identificación: ", new { @class = "fw-bold" })
                <div id="identificacion">@Html.DisplayFor(model => model.Identificacion)</div>
            </div>
            <div class="col-md-6 col-12 mb-3">
                @Html.LabelFor(model => model.FechaNacimiento, "Fecha de Nacimiento: ", new { @class = "fw-bold" })
                <div id="fechaNacimiento">@Html.DisplayFor(model => model.FechaNacimiento)</div>
            </div>
            <div class="col-md-6 col-12 mb-3">
                @Html.LabelFor(model => model.CorreoElectronico, "Correo Electrónico: ", new { @class = "fw-bold" })
                <div id="correoElectronico">@Html.DisplayFor(model => model.CorreoElectronico)</div>
            </div>
            <div class="col-md-6 col-12 mb-3">
                @Html.LabelFor(model => model.Telefono, "Teléfono: ", new { @class = "fw-bold" })
                <div id="telefono">@Html.DisplayFor(model => model.Telefono)</div>
            </div>
            <div class="col-md-6 col-12 mb-3">
                @Html.LabelFor(model => model.Direccion, "Dirección: ", new { @class = "fw-bold" })
                <div id="direccion">@Html.DisplayFor(model => model.Direccion)</div>
            </div>
            <div class="col-md-6 col-12 mb-3">
                @Html.LabelFor(model => model.FechaIngreso, "Fecha de ingreso: ", new { @class = "fw-bold" })
                <div id="fechaIngreso">@Html.DisplayFor(model => model.FechaIngreso)</div>
            </div>
        </div>

        <div class="text-center mt-4">
            <button class="btn btn-primary w-100" onclick="abrirModal()">Actualizar Información Personal</button>
        </div>
    </div>
</section>

<!-- Modal de actualización -->
<div class="modal fade" id="modalActualizar" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Actualizar Información</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                @using (Html.BeginForm(null, null, FormMethod.Post, new { id = "formActualizar" }))
                {
                    <div class="mb-3">
                        @Html.LabelFor(model => model.CorreoElectronico, "Correo Electrónico", new { @class = "form-label" })
                        @Html.TextBox("nuevoCorreo", null, new { @class = "form-control", type = "email", required = "required" })
                    </div>
                    <div class="mb-3">
                        @Html.LabelFor(model => model.Telefono, "Teléfono", new { @class = "form-label" })
                        @Html.TextBox("nuevoTelefono", null, new { @class = "form-control", type = "tel", required = "required" })
                    </div>
                    <div class="mb-3">
                        @Html.LabelFor(model => model.Direccion, "Dirección", new { @class = "form-label" })
                        @Html.TextBox("nuevaDireccion", null, new { @class = "form-control", required = "required" })
                    </div>
                    <div class="text-end">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-success">Actualizar</button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        $(document).ready(function () {
            obtenerInformacionPersonal();
        });

        function obtenerInformacionPersonal() {
            $.ajax({
                url: "/Asociados/ObtenerInformacionPersonal",
                type: "GET",
                success: function (data) {
                    console.log("Datos recibidos:", data);

                    if (data.success) {
                        $("#nombreCompleto").text(data.usuario.nombreCompleto);
                        $("#identificacion").text(data.usuario.identificacion);
                        $("#fechaNacimiento").text(formatearFecha(data.usuario.fechaNacimiento));
                        $("#correoElectronico").text(data.usuario.correoElectronico);
                        $("#telefono").text(data.usuario.telefono);
                        $("#direccion").text(data.usuario.direccion);
                        $("#fechaIngreso").text(formatearFecha(data.usuario.fechaIngreso));
                    } else {
                        Swal.fire("Error", data.message, "error");
                    }
                },
                error: function (xhr, status, error) {
                    console.error("Error en AJAX:", error);
                    Swal.fire("Error", "Hubo un problema al cargar la información.", "error");
                }
            });
        }

        function formatearFecha(jsonFecha) {
            if (!jsonFecha) return "No disponible";

            let fecha = new Date(parseInt(jsonFecha.replace("/Date(", "").replace(")/", ""), 10));
            let dia = fecha.getDate().toString().padStart(2, "0");
            let mes = (fecha.getMonth() + 1).toString().padStart(2, "0");
            let anio = fecha.getFullYear();

            return `${dia}/${mes}/${anio}`;
        }

        function abrirModal() {
            $("#nuevoCorreo").val($("#correoElectronico").text());
            $("#nuevoTelefono").val($("#telefono").text());
            $("#nuevaDireccion").val($("#direccion").text());
            $("#modalActualizar").modal("show");
        }

        $("#formActualizar").submit(function (e) {
            e.preventDefault();
            $.post("/Asociados/ActualizarInformacionPersonal", {
                correo: $("#nuevoCorreo").val(),
                telefono: $("#nuevoTelefono").val(),
                direccion: $("#nuevaDireccion").val()
            }, function (data) {
                Swal.fire(data.success ? "¡Éxito!" : "Error", data.message, data.success ? "success" : "error")
                    .then(() => {
                        if (data.success) {
                            $("#modalActualizar").modal("hide");
                            obtenerInformacionPersonal();
                        }
                    });
            });
        });

        // Formatear el teléfono en tiempo real dentro del modal
        $(document).ready(function () {
            $("#nuevoTelefono").on("input", function () {
                var value = $(this).val().replace(/\D/g, ''); // Solo números

                if (value.length > 8) {
                    value = value.substring(0, 8); // Limita a 8 caracteres
                }

                $(this).val(value); // Asigna el valor limpio sin guiones
            });
        });

    </script>
}
