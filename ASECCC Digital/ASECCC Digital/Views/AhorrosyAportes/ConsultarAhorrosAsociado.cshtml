@model IEnumerable<ASECCC_Digital.Entities.Ahorro>

@{
    ViewBag.Title = "ConsultaAhorros";
    Layout = "~/Views/Shared/_Layout.cshtml";
    @Html.Partial("_MenuModulos");
}

<div class="container my-5">
    <h1 class="text-center mb-4">GESTION DE AHORROS</h1>

    <div class="mb-4">
        <label for="filtroTipoAhorro" class="form-label">Filtrar por Tipo de Ahorro:</label>
        <select id="filtroTipoAhorro" class="form-select" onchange="filtrarAhorros()">
            <option value="">Todos</option>
            <option value="A la Vista">A la Vista</option>
            <option value="Navideño">Navideño</option>
            <option value="Marchamo">Marchamo</option>
            <option value="Escolar">Escolar</option>
        </select>
    </div>

    <button class="btn btn-primary mb-4" data-bs-toggle="modal" data-bs-target="#modalCrearAhorro">Crear Nuevo Ahorro</button>

    <div class="row d-flex justify-content-center flex-wrap" id="cardsAhorros">
        <!-- Cards serán cargadas dinámicamente -->
    </div>
</div>

<!-- Modal para Crear Nuevo Ahorro -->
<div class="modal fade" id="modalCrearAhorro" tabindex="-1" aria-labelledby="modalCrearAhorroLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalCrearAhorroLabel">Crear Nuevo Ahorro</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label for="tipoAhorro" class="form-label">Tipo de Ahorro</label>
                    <select class="form-select" id="tipoAhorro" required>
                        <option value="A la Vista">A la Vista</option>
                        <option value="Navideño">Navideño</option>
                        <option value="Marchamo">Marchamo</option>
                        <option value="Escolar">Escolar</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label for="montoAhorro" class="form-label">Monto</label>
                    <input type="number" class="form-control" id="montoAhorro" min="1" required>
                </div>
                <div class="mb-3">
                    <label for="plazoAhorro" class="form-label">Plazo (en meses)</label>
                    <input type="number" class="form-control" id="plazoAhorro" min="1" required>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-primary" onclick="crearAhorro()">Guardar Ahorro</button>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        cargarAhorros();
    });

    function cargarAhorros() {
        $.getJSON('/AhorrosyAportes/ObtenerAhorrosAsociado', function (response) {
            if (response.success) {
                let html = '';

                response.data.forEach(ahorro => {

                    html += `
                    <div class="col-12 col-md-6 col-lg-4 mb-4 ahorro-card"
                         data-tipo="${ahorro.TipoAhorro}"
                         data-id="${ahorro.AhorroId}">

                        <div class="card shadow-sm">
                            <div class="card-body">

                                <h5 class="card-title fw-normal text-capitalize">
                                    ${ahorro.TipoAhorro}
                                </h5>

                                <p class="card-text">
                                    <strong>Fecha:</strong> ${formatearFecha(ahorro.FechaInicio)}<br>
                                    <strong>Monto Inicial:</strong> ${ahorro.MontoInicial.toLocaleString('es-CR')}<br>
                                    <strong>Monto Actual:</strong> ${ahorro.MontoActual.toLocaleString('es-CR')}<br>
                                    <strong>Plazo:</strong> ${ahorro.Plazo ?? 'N/A'} meses<br>
                                    <strong>Estado:</strong> ${ahorro.Estado.charAt(0).toUpperCase() + ahorro.Estado.slice(1)}
                                </p>

                                <button class="btn btn-info btn-sm text-white me-1 mb-1"
                                        onclick="verDetalles(${ahorro.AhorroId})">
                                    Historial
                                </button>

                                <button class="btn btn-warning btn-sm text-white me-1 mb-1"
                                        onclick="modificarMonto(${ahorro.AhorroId})">
                                    Modificar Monto
                                </button>

                                ${ahorro.TipoAhorro?.trim().toLowerCase() === 'a la vista' ? `
                                    <button class="btn btn-success btn-sm text-white me-1 mb-1"
                                            onclick="solicitarRetiro(${ahorro.AhorroId},${ahorro.MontoActual})">
                                        Solicitar Retiro
                                    </button>
                                ` : ''}

                            </div>
                        </div>

                    </div>`;
                });

                $('#cardsAhorros').html(html);

            } else {

                $('#cardsAhorros').html(
                    '<div class="text-center">No se encontraron ahorros.</div>'
                );
            }
        });
    }

    function crearAhorro() {
        const tipo = document.getElementById('tipoAhorro').value;
        const monto = document.getElementById('montoAhorro').value;
        const plazo = document.getElementById('plazoAhorro').value;

        if (tipo && monto && plazo) {
            $.ajax({
                url: '/AhorrosyAportes/RegistrarAhorro',
                type: 'POST',
                data: {
                    tipoAhorro: tipo,
                    monto: monto,
                    plazo: plazo
                },
                success: function (response) {
                    if (response.success) {
                        const el = document.getElementById('modalCrearAhorro');
                        const modal = bootstrap.Modal.getOrCreateInstance(el);
                        modal.hide();
                        document.body.classList.remove('modal-open');
                        $('.modal-backdrop').remove();


                        el.addEventListener('hidden.bs.modal', () => {
                            $('#tipoAhorro').val('A la Vista');
                            $('#montoAhorro').val('');
                            $('#plazoAhorro').val('');
                        }, { once: true });

                        cargarAhorros();
                        Swal.fire({ icon: 'success', title: '¡Ahorro creado!', text: 'El ahorro se registró exitosamente.' });
                    } else {
                        Swal.fire({ icon: 'error', title: 'Error', text: response.message });
                    }
                }
            });
        } else {
            Swal.fire({
                icon: 'warning',
                title: 'Campos incompletos',
                text: 'Por favor, completa todos los campos.'
            });
        }
    }

    function finalizarAhorro(ahorroId) {
        if (!ahorroId) {
            Swal.fire({
                icon: 'error',
                title: 'ID no válido',
                text: 'No se pudo identificar el ahorro a finalizar.'
            });
            return;
        }

        Swal.fire({
            title: '¿Estas seguro?',
            text: 'Esta acción eliminara permanentemente el ahorro.',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Sí, finalizar',
            cancelButtonText: 'Cancelar'
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: '/AhorrosyAportes/FinalizarAhorro',
                    type: 'POST',
                    data: { ahorroId: ahorroId },
                    success: function (response) {
                        if (response.success) {
                            Swal.fire({
                                icon: 'success',
                                title: '¡Ahorro Finalizado!',
                                text: response.message || 'El ahorro fue eliminado exitosamente.'
                            });
                            cargarAhorros();
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error al finalizar',
                                text: response.message || 'No se pudo finalizar el ahorro.'
                            });
                        }
                    },
                    error: function (xhr, status, error) {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error AJAX',
                            text: 'Ocurrió un error al intentar finalizar el ahorro.'
                        });
                        console.error('Error AJAX:', error);
                    }
                });
            }
        });
    }

    function solicitarRetiro(ahorroId, montoActual) {

        Swal.fire({
            title: 'Solicitud de Retiro',
            html: `
            <div class="text-start">
                <p>
                    <strong>Saldo disponible:</strong><br>
                    ₡${montoActual.toLocaleString('es-CR')}
                </p>

                <label class="form-label">Monto a retirar</label>

                <input id="montoRetiro"
                       type="number"
                       class="form-control"
                       min="1"
                       max="${montoActual}"
                       placeholder="Ingrese el monto">
            </div>
        `,
            showCancelButton: true,
            confirmButtonText: 'Enviar Solicitud',
            cancelButtonText: 'Cancelar',

            preConfirm: () => {

                const montoRetiro = parseFloat(
                    document.getElementById('montoRetiro').value
                );

                if (isNaN(montoRetiro)) {
                    Swal.showValidationMessage(
                        'Debe ingresar un monto.'
                    );
                    return false;
                }

                if (montoRetiro <= 0) {
                    Swal.showValidationMessage(
                        'El monto debe ser mayor a cero.'
                    );
                    return false;
                }

                if (montoRetiro > montoActual) {
                    Swal.showValidationMessage(
                        'El monto solicitado supera el saldo disponible.'
                    );
                    return false;
                }

                return montoRetiro;
            }

        }).then((result) => {

            if (result.isConfirmed) {

                $.ajax({
                    url: '/AhorrosyAportes/SolicitarRetiro',
                    type: 'POST',
                    data: {
                        ahorroId: ahorroId,
                        montoRetiro: result.value
                    },

                    success: function (response) {

                        if (response.success) {

                            Swal.fire({
                                icon: 'success',
                                title: 'Solicitud enviada',
                                text: response.message
                            });

                        } else {

                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: response.message
                            });
                        }
                    },

                    error: function () {

                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'Ocurrió un error al procesar la solicitud.'
                        });
                    }
                });
            }
        });
    }

    function modificarMonto(ahorroId) {
        const card = $(`.ahorro-card[data-id='${ahorroId}']`);
        const montoTexto = card.find("p").html().match(/Monto Inicial:<\/strong>\s?([\d.,]+)/);
        const montoActual = montoTexto ? parseFloat(montoTexto[1].replace(/\./g, '').replace(',', '.')) : 0;

        Swal.fire({
            title: 'Modificar Monto Inicial',
            html: `
            <p class="mb-2">Este cambio solo afecta el <strong>monto inicial</strong> del ahorro.</p>
            <input type="number" id="nuevoMonto" class="form-control" value="${montoActual}" min="1" style="margin-top:10px;">
        `,
            showCancelButton: true,
            confirmButtonText: 'Guardar',
            cancelButtonText: 'Cancelar',
            preConfirm: () => {
                const nuevoMonto = document.getElementById('nuevoMonto').value;
                if (!nuevoMonto || nuevoMonto <= 0) {
                    Swal.showValidationMessage('Debes ingresar un monto válido mayor a 0.');
                }
                return nuevoMonto;
            }
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: '/AhorrosyAportes/ModificarAhorro',
                    type: 'POST',
                    data: {
                        ahorroId: ahorroId,
                        nuevoMonto: result.value
                    },
                    success: function (response) {
                        if (response.success) {
                            Swal.fire({
                                icon: 'success',
                                title: '¡Monto actualizado!',
                                text: response.message || 'El monto inicial fue modificado correctamente.'
                            });
                            cargarAhorros();
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: response.message
                            });
                        }
                    },
                    error: function () {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error AJAX',
                            text: 'No se pudo modificar el monto.'
                        });
                    }
                });
            }
        });
    }

    function verDetalles(ahorroId) {
        $.ajax({
            url: '/AhorrosyAportes/ObtenerHistorialTransacciones',
            type: 'GET',
            data: { ahorroId: ahorroId },
            success: function (response) {
                if (response.success && response.data.length > 0) {
                    let html = '<table class="table text-start"><thead><tr><th>Fecha</th><th>Monto</th><th>Tipo</th><th>Descripción</th></tr></thead><tbody>';
                    response.data.forEach(t => {
                        html += `<tr>
                        <td>${formatearFecha(t.Fecha)}</td>
                        <td>${t.Monto.toLocaleString('es-CR')}</td>
                        <td>${t.Tipo}</td>
                        <td>${t.Descripcion}</td>
                    </tr>`;
                    });
                    html += '</tbody></table>';

                    Swal.fire({
                        title: 'Historial de Transacciones',
                        html: html,
                        width: '60%',
                        confirmButtonText: 'Cerrar'
                    });
                } else {
                    Swal.fire({
                        icon: 'info',
                        title: 'Sin transacciones',
                        text: 'Este ahorro no tiene historial de movimientos.'
                    });
                }
            },
            error: function () {
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'No se pudo cargar el historial del ahorro.'
                });
            }
        });
    }

    function filtrarAhorros() {
        const filtro = document.getElementById("filtroTipoAhorro").value.toLowerCase();
        $('.ahorro-card').each(function () {
            const tipo = $(this).data('tipo').toLowerCase();
            if (filtro === "" || tipo === filtro) {
                $(this).show();
            } else {
                $(this).hide();
            }
        });
    }


    function formatearFecha(fechaString) {
        const match = /\/Date\((\d+)\)\//.exec(fechaString);
        const timestamp = match ? parseInt(match[1]) : Date.parse(fechaString);
        const fecha = new Date(timestamp);

        if (isNaN(fecha)) return "Fecha inválida";

        const dia = String(fecha.getDate()).padStart(2, '0');
        const mes = String(fecha.getMonth() + 1).padStart(2, '0');
        const año = fecha.getFullYear();

        return `${dia}/${mes}/${año}`;
    }

</script>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
