@{
    ViewBag.Title = "ConsultaAhorros";
    Layout = "~/Views/Shared/_Layout.cshtml";
    @Html.Partial("_MenuModulos");
}

<div class="container my-5">
    <h1 class="text-center mb-4">Gestión de Ahorros</h1>

    <!-- Crear Nuevo Ahorro -->
    <button class="btn btn-primary mb-4" data-bs-toggle="modal" data-bs-target="#modalCrearAhorro">Crear Nuevo Ahorro</button>

    <!-- Cards de Ahorros -->
    <div class="row d-flex justify-content-center flex-wrap" id="cardsAhorros">
        <!-- Cards dinámicas generadas por JavaScript -->
    </div>
</div>

<!-- Modal para Crear Nuevo Ahorro -->
<div class="modal fade" id="modalCrearAhorro" tabindex="-1" aria-labelledby="modalCrearAhorroLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalCrearAhorroLabel">Crear Nuevo Ahorro</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label for="tipoAhorro" class="form-label">Tipo de Ahorro</label>
                    <select class="form-select" id="tipoAhorro">
                        <option value="vista">A la Vista</option>
                        <option value="marchamo">Marchamo</option>
                        <option value="navideno">Navideño</option>
                        <option value="escolar">Escolar</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label for="montoAhorro" class="form-label">Monto</label>
                    <input type="number" class="form-control" id="montoAhorro" min="1" required>
                </div>
                <div class="mb-3">
                    <label for="plazoAhorro" class="form-label">Plazo (en meses)</label>
                    <input type="number" class="form-control" id="plazoAhorro" min="1" required>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-primary" onclick="crearAhorro()">Crear Ahorro</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal para Historial de Ahorro -->
<div class="modal fade" id="modalHistorialAhorro" tabindex="-1" aria-labelledby="modalHistorialAhorroLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalHistorialAhorroLabel">Historial de Ahorro</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div class="table-responsive">
                    <table class="table table-bordered" id="tablaHistorialAhorro">
                        <thead class="table-light">
                            <tr>
                                <th>Fecha</th>
                                <th>Monto</th>
                                <th>Tipo de Movimiento</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Historial dinámico generado por JavaScript -->
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal para Modificar Monto de Ahorro -->
<div class="modal fade" id="modalModificarMonto" tabindex="-1" aria-labelledby="modalModificarMontoLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalModificarMontoLabel">Modificar Monto de Ahorro</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label for="nuevoMonto" class="form-label">Nuevo Monto</label>
                    <input type="number" class="form-control" id="nuevoMonto" min="1" required>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-primary" onclick="modificarMontoAhorro()">Modificar</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal para Finalizar Ahorro -->
<div class="modal fade" id="modalFinalizarAhorro" tabindex="-1" aria-labelledby="modalFinalizarAhorroLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalFinalizarAhorroLabel">Finalizar Ahorro</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p>¿Estás seguro de que deseas finalizar este ahorro?</p>
                <p>Una vez finalizado, no podrás modificarlo.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-danger" onclick="finalizarAhorro()">Finalizar Ahorro</button>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
    const ahorros = [
        { id: 1, tipo: 'A la Vista', monto: 50000, fecha: '2024-01-15', plazo: 12, estado: 'Activo' },
        { id: 2, tipo: 'Marchamo', monto: 15000, fecha: '2023-11-01', plazo: 6, estado: 'Activo' },
        { id: 3, tipo: 'Navideño', monto: 200000, fecha: '2024-05-20', plazo: 8, estado: 'Finalizado' },
        { id: 4, tipo: 'Escolar', monto: 100000, fecha: '2024-02-10', plazo: 10, estado: 'Activo' }
    ];

    const historialAhorros = {
        1: [
            { fecha: '2024-02-15', monto: 20000, tipo: 'Deposito' },
            { fecha: '2024-03-10', monto: 15000, tipo: 'Retiro' }
        ],
        2: [
            { fecha: '2023-12-01', monto: 5000, tipo: 'Deposito' }
        ],
        3: [
            { fecha: '2023-11-15', monto: 50000, tipo: 'Deposito' }
        ]
    };

    function mostrarAhorros() {
        const cardsAhorros = document.getElementById('cardsAhorros');
        cardsAhorros.innerHTML = '';

        ahorros.forEach(ahorro => {
            const card = document.createElement('div');
            card.classList.add('col-12', 'col-md-6', 'col-lg-4', 'mb-4');
            card.innerHTML = `
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">${ahorro.tipo}</h5>
                        <p class="card-text">
                            <strong>Fecha:</strong> ${ahorro.fecha}<br>
                            <strong>Monto:</strong> ${formatearMonto(ahorro.monto)}<br>
                            <strong>Plazo:</strong> ${ahorro.plazo} meses<br>
                            <strong>Estado:</strong> ${ahorro.estado}
                        </p>
                        <button class="btn btn-info btn-sm" onclick="verHistorial(${ahorro.id})" data-bs-toggle="modal" data-bs-target="#modalHistorialAhorro">
                            <i class="bi bi-clock-history"></i> Ver Historial
                        </button>
                        <button class="btn btn-warning btn-sm" onclick="modificarMonto(${ahorro.id})" data-bs-toggle="modal" data-bs-target="#modalModificarMonto">
                            <i class="bi bi-pencil"></i> Modificar Monto
                        </button>
                        <button class="btn btn-danger btn-sm" onclick="finalizarAhorroModal(${ahorro.id})" data-bs-toggle="modal" data-bs-target="#modalFinalizarAhorro">
                            <i class="bi bi-x-circle"></i> Finalizar Ahorro
                        </button>
                    </div>
                </div>
            `;
            cardsAhorros.appendChild(card);
        });
    }

    function formatearMonto(monto) {
        return monto.toLocaleString('es-CR', { style: 'currency', currency: 'CRC' });
    }

    function verHistorial(ahorroId) {
        const tablaHistorial = document.querySelector('#tablaHistorialAhorro tbody');
        tablaHistorial.innerHTML = '';

        if (!historialAhorros[ahorroId] || historialAhorros[ahorroId].length === 0) {
            tablaHistorial.innerHTML = '<tr><td colspan="3" class="text-center">No hay historial de movimientos para este ahorro.</td></tr>';
            return;
        }

        historialAhorros[ahorroId].forEach(movimiento => {
            const fila = document.createElement('tr');
            fila.innerHTML = `
                <td>${movimiento.fecha}</td>
                <td>${formatearMonto(movimiento.monto)}</td>
                <td>${movimiento.tipo}</td>
            `;
            tablaHistorial.appendChild(fila);
        });
    }

    function modificarMonto(ahorroId) {
        // Lógica para obtener y modificar el monto
        const ahorro = ahorros.find(a => a.id === ahorroId);
        document.getElementById('nuevoMonto').value = ahorro.monto;
    }

    function modificarMontoAhorro() {
        const nuevoMonto = document.getElementById('nuevoMonto').value;
        alert('Nuevo monto: ' + nuevoMonto); // Lógica para actualizar el monto del ahorro
    }

    function finalizarAhorroModal(ahorroId) {
        // Prepara el modal para confirmar la finalización del ahorro
    }

    function finalizarAhorro() {
        alert('Ahorro finalizado.');
    }

    function crearAhorro() {
        const tipo = document.getElementById('tipoAhorro').value;
        const monto = document.getElementById('montoAhorro').value;
        const plazo = document.getElementById('plazoAhorro').value;

        ahorros.push({ id: ahorros.length + 1, tipo, monto, fecha: new Date().toISOString().split('T')[0], plazo, estado: 'Activo' });
        mostrarAhorros(); // Actualiza la lista de ahorros

        // Cierra el modal
        const modal = bootstrap.Modal.getInstance(document.getElementById('modalCrearAhorro'));
        modal.hide();
    }

    // Llamar a la función para mostrar los ahorros al cargar la página
    mostrarAhorros();
</script>
