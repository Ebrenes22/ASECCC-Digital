@model IEnumerable<ASECCC_Digital.Entities.Aporte>

@{
    ViewBag.Title = "ConsultaAportesAsociado";
    Layout = "~/Views/Shared/_Layout.cshtml";
    @Html.Partial("_MenuModulos");
}

<div class="container my-5">
    <h1 class="text-center mb-4 fw-normal">GESTIÓN DE APORTES</h1>

    <div class="row mb-4">
        <div class="col-12">
            <h3 class="text-center">Aportes del Asociado</h3>
        </div>
    </div>

    <div class="row d-flex justify-content-center flex-wrap" id="cardsAportes">
        @if (Model != null && Model.Any())
        {
            foreach (var aporte in Model)
            {
                <div class="col-12 col-md-6 col-lg-4 mb-4 aporte-card" data-id="@aporte.AporteId">
                    <div class="card shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title fw-normal">@aporte.TipoAporte</h5>
                            <p class="card-text">
                                <strong>Fecha:</strong> @(aporte.FechaRegistro != null ? string.Format("{0:yyyy-MM-dd}", aporte.FechaRegistro) : "-")<br>
                                <strong>Monto:</strong> @aporte.Monto.ToString("C", System.Globalization.CultureInfo.CreateSpecificCulture("es-CR"))<br>
                                <strong>Estado:</strong> Activo
                            </p>
                            <button class="btn btn-info btn-sm text-white" onclick="verHistorial(@aporte.AporteId)">
                                <i class="bi bi-clock-history"></i> Ver Historial
                            </button>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center">No se encontraron aportes.</div>
        }
    </div>
</div>

<!-- Modal para Historial -->
<div class="modal fade" id="modalHistorialRegistro" tabindex="-1" aria-labelledby="modalHistorialRegistroLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalHistorialRegistroLabel">Historial de Abonos</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div class="table-responsive">
                    <table class="table table-bordered" id="tablaHistorial">
                        <thead class="table-light">
                            <tr>
                                <th>Fecha</th>
                                <th>Monto</th>
                                <th>Descripción</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Historial dinámico generado por JavaScript -->
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<script>

    function verHistorial(aporteId) {
        Swal.fire({
            title: 'Cargando historial...',
            allowOutsideClick: false,
            didOpen: () => {
                Swal.showLoading();
            }
        });

        $.ajax({
            url: '/AhorrosyAportes/ObtenerHistorialAporte',
            type: 'GET',
            data: { aporteId: aporteId },
            success: function (response) {
                Swal.close();

                if (response.success && response.data.length > 0) {
                    const tablaHistorial = document.querySelector('#tablaHistorial tbody');
                    tablaHistorial.innerHTML = '';

                    response.data.forEach(function (item) {
                        const fila = document.createElement('tr');
                        fila.innerHTML = `
                        <td>${formatearFecha(item.Fecha)}</td>
                        <td>${item.Monto.toLocaleString('es-CR', { style: 'currency', currency: 'CRC' })}</td>
                        <td>${item.Descripcion || '-'}</td>
                    `;
                        tablaHistorial.appendChild(fila);
                    });

                    const modal = new bootstrap.Modal(document.getElementById('modalHistorialRegistro'));
                    modal.show();
                } else {
                    Swal.fire({
                        icon: 'info',
                        title: 'Sin transacciones',
                        text: 'Este aporte no tiene transacciones registradas.'
                    });
                }
            },
            error: function () {
                Swal.close();
                Swal.fire("Error", "No se pudo cargar el historial del aporte.", "error");
            }
        });
    }

    function formatearFecha(fechaJson) {
        const match = /\d+/.exec(fechaJson);
        const timestamp = match ? parseInt(match[0]) : Date.parse(fechaJson);
        const fecha = new Date(timestamp);
        const dia = String(fecha.getDate()).padStart(2, '0');
        const mes = String(fecha.getMonth() + 1).padStart(2, '0');
        const año = fecha.getFullYear();
        return `${dia}/${mes}/${año}`;
    }


</script>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
