@{
    ViewBag.Title = "Gestionar Ahorros";
    Layout = "~/Views/Shared/_Layout.cshtml";
    @Html.Partial("_MenuModulos");
}

<div class="container my-5">
    <h1 class="text-center mb-4">Gestión de Ahorros</h1>

    <div class="row mb-4">
        <div class="col-12 mb-3">
            <label for="asociado" class="form-label">Buscar Asociado</label>
            <input type="text" id="asociado" class="form-control" placeholder="Ingrese el nombre del asociado">
        </div>
    </div>

    <div class="d-flex justify-content-between mb-4">
        <button class="btn btn-primary" onclick="consultarAhorros()">
            <i class="bi bi-search"></i> Consultar
        </button>
        <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#modalRegistrarAhorro">
            <i class="bi bi-plus-circle"></i> Registrar Ahorro
        </button>
    </div>

    <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
        <table class="table table-bordered table-sm" id="tablaAhorros" style="font-size: 14px;">
            <thead class="table-light">
                <tr>
                    <th>Tipo de Ahorro</th>
                    <th>Fecha</th>
                    <th>Monto</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
    </div>

    <!-- Modal para Registrar Ahorro -->
    <div class="modal fade" id="modalRegistrarAhorro" tabindex="-1" aria-labelledby="modalRegistrarAhorroLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalRegistrarAhorroLabel">Registrar Nuevo Ahorro</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <form id="formRegistrarAhorro">
                        <div class="mb-3">
                            <label for="tipoAhorro" class="form-label">Tipo de Ahorro</label>
                            <select id="tipoAhorro" class="form-select">
                                <option value="A la Vista">A la Vista</option>
                                <option value="Navideño">Navideño</option>
                                <option value="Marchamo">Marchamo</option>
                                <option value="Escolar">Escolar</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label for="montoAhorro" class="form-label">Monto</label>
                            <input type="number" id="montoAhorro" class="form-control" placeholder="Ingrese el monto del ahorro">
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-primary" onclick="registrarAhorro()">Registrar</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- JAVASCRIPT Y AJAX -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    function consultarAhorros() {
        let asociado = $("#asociado").val().trim();

        if (asociado === "") {
            alert("Por favor, ingrese el nombre del asociado.");
            return;
        }

        $.ajax({
            url: "/AhorrosyAportes/ConsultarAhorrosAsociado",
            type: "GET",
            data: { nombreAsociado: asociado },
            success: function (response) {
                let tablaBody = $("#tablaAhorros tbody");
                tablaBody.empty();

                if (!response.success || response.data.length === 0) {
                    tablaBody.append("<tr><td colspan='5' class='text-center'>No se encontraron ahorros para este asociado.</td></tr>");
                    return;
                }

                response.data.forEach(ahorro => {
                    let fila = `<tr>
                    <td>${ahorro.TipoAhorro}</td>
                    <td>${new Date(ahorro.FechaInicio).toLocaleDateString()}</td>
                    <td>₡${parseFloat(ahorro.MontoActual).toLocaleString('es-CR')}</td>
                    <td>${ahorro.Estado}</td>
                    <td>
                        <button class='btn btn-warning btn-sm' onclick='editarAhorro(${ahorro.AhorroId})'>Editar</button>
                        <button class='btn btn-danger btn-sm' onclick='eliminarAhorro(${ahorro.AhorroId})'>Eliminar</button>
                    </td>
                </tr>`;
                    tablaBody.append(fila);
                });
            },
            error: function () {
                alert("Error al consultar los ahorros.");
            }
        });
    }


    function registrarAhorro() {
        let asociado = $("#asociado").val().trim();
        let tipoAhorro = $("#tipoAhorro").val();
        let monto = $("#montoAhorro").val();
        let plazo = 12;

        if (asociado === "" || monto === "") {
            alert("Debe ingresar el nombre del asociado y el monto.");
            return;
        }

        $.ajax({
            url: "/AhorrosyAportes/RegistrarAhorro",
            type: "POST",
            data: { nombreAsociado: asociado, tipoAhorro: tipoAhorro, monto: monto, plazo: plazo },
            success: function (response) {
                alert(response.message);
                if (response.success) {
                    $("#modalRegistrarAhorro").modal("hide");
                    consultarAhorros();
                }
            },
            error: function () {
                alert("Error al registrar el ahorro.");
            }
        });
    }

    function editarAhorro(ahorroId) {
        let nuevoMonto = prompt("Ingrese el nuevo monto del ahorro:");
        if (!nuevoMonto) return;

        $.ajax({
            url: "/AhorrosyAportes/ModificarAhorro",
            type: "POST",
            data: { ahorroId: ahorroId, nuevoMonto: nuevoMonto },
            success: function (response) {
                alert(response.message);
                if (response.success) {
                    consultarAhorros();
                }
            },
            error: function () {
                alert("Error al modificar el ahorro.");
            }
        });
    }

    function eliminarAhorro(ahorroId) {
        if (!confirm("¿Está seguro de eliminar este ahorro?")) return;

        $.ajax({
            url: "/AhorrosyAportes/EliminarAhorro",
            type: "POST",
            data: { ahorroId: ahorroId },
            success: function (response) {
                alert(response.message);
                if (response.success) {
                    consultarAhorros();
                }
            },
            error: function () {
                alert("Error al eliminar el ahorro.");
            }
        });
    }

</script>
