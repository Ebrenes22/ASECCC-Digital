@{
    ViewBag.Title = "Gestionar Aportes";
    Layout = "~/Views/Shared/_Layout.cshtml";
    @Html.Partial("_MenuModulos");
}

<link rel="stylesheet" href="https://code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css">

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://code.jquery.com/ui/1.12.1/jquery-ui.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<div class="container my-5">
    <h1 class="text-center mb-4">GESTION DE APORTES</h1>

    <div class="row mb-4">
        <div class="col-12 mb-3">
            <label for="asociado" class="form-label">Buscar Asociado</label>
            <input type="text" id="asociado" class="form-control" placeholder="Ingrese el nombre del asociado">
        </div>
    </div>

    <div class="d-flex justify-content-between mb-4">
        <button class="btn btn-primary" onclick="consultarAportes()">
            <i class="bi bi-search"></i> Consultar
        </button>
        <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#modalRegistrarAporte">
            <i class="bi bi-plus-circle"></i> Registrar Aporte
        </button>
    </div>

    <h4 id="tituloAportes" style="display:none;">
        Aportes de <strong id="nombreAsociadoTitulo"></strong>
    </h4>

    <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
        <table class="table table-bordered table-sm" id="tablaAportes">
            <thead class="table-light">
                <tr>
                    <th>Tipo de Aporte</th>
                    <th>Fecha</th>
                    <th>Monto</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="modalRegistrarAporte" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Registrar Nuevo Aporte</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <form id="formRegistrarAporte">
                    <div class="mb-3">
                        <label class="form-label">Nombre del Asociado</label>
                        <input type="text" id="nombreAsociado" class="form-control" readonly>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Tipo de Aporte</label>
                        <select id="tipoAporte" class="form-select">
                            <option value="Personal">Personal</option>
                            <option value="Patronal">Patronal</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Monto</label>
                        <input type="number" id="montoAporte" class="form-control">
                    </div>
                </form>
            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button class="btn btn-primary" onclick="registrarAporte()">Registrar</button>
            </div>
        </div>
    </div>
</div>

<script>

    function formatearFecha(fecha) {

        if (!fecha) return "-";

        // Formato .NET: /Date(123456789)/
        let match = /\/Date\((\d+)\)\//.exec(fecha);
        if (match) {
            return new Date(parseInt(match[1])).toLocaleDateString('es-CR');
        }

        // Formato ISO u otros
        let date = new Date(fecha);
        if (!isNaN(date.getTime())) {
            return date.toLocaleDateString('es-CR');
        }

        return "-";
    }

    $(document).ready(function () {

        $("#asociado").autocomplete({
            source: function (request, response) {
                $.ajax({
                    url: "/AhorrosyAportes/BuscarAsociados",
                    type: "GET",
                    dataType: "json",
                    data: { termino: request.term },
                    success: function (data) {
                        response(data);
                    }
                });
            },
            minLength: 2,
            select: function (event, ui) {

                $("#asociado").val(ui.item.label);
                $("#nombreAsociado").val(ui.item.label);

                return false;
            }
        });

    });

    function consultarAportes() {

        let asociado = $("#asociado").val().trim();

        if (asociado === "") {
            Swal.fire("Atención", "Ingrese el nombre del asociado.", "warning");
            return;
        }

        $.ajax({
            url: "/AhorrosyAportes/ConsultarAportesPorNombre",
            type: "GET",
            data: { nombreAsociado: asociado },
            success: function (response) {

                let tablaBody = $("#tablaAportes tbody");
                tablaBody.empty();

                $("#nombreAsociadoTitulo").text(asociado);
                $("#tituloAportes").show();

                if (!response.success || response.data.length === 0) {
                    tablaBody.append("<tr><td colspan='4' class='text-center'>No se encontraron aportes.</td></tr>");
                    return;
                }

                response.data.forEach(aporte => {

                    let fecha = formatearFecha(aporte.FechaRegistro);

                    let monto = new Intl.NumberFormat('es-CR', {
                        style: 'currency',
                        currency: 'CRC'
                    }).format(aporte.Monto);

                    tablaBody.append(`
                    <tr>
                        <td>${aporte.TipoAporte}</td>
                        <td>${fecha}</td>
                        <td>${monto}</td>
                        <td>
                            <button class='btn btn-success btn-sm' onclick='agregarAporte(${aporte.AporteId})'>Abonar</button>
                            <button class="btn btn-info btn-sm text-white" onclick='verHistorial(${aporte.AporteId})'>Historial</button>
                            <button class='btn btn-danger btn-sm' onclick='eliminarAporte(${aporte.AporteId})'>Eliminar</button>
                        </td>
                    </tr>
                `);
                });

            }
        });
    }

    function registrarAporte() {

        let nombreAsociado = $("#nombreAsociado").val().trim();
        let tipo = $("#tipoAporte").val();
        let monto = $("#montoAporte").val();

        if (nombreAsociado === "" || monto === "") {
            Swal.fire("Atención", "Complete todos los campos.", "warning");
            return;
        }

        $.post("/AhorrosyAportes/RegistrarAportePorNombre", {
            nombreAsociado: nombreAsociado,
            tipoAporte: tipo,
            monto: monto
        }, function (res) {

            Swal.fire("Resultado", res.message, res.success ? "success" : "error");

            if (res.success) {
                $("#modalRegistrarAporte").modal("hide");
                consultarAportes();
            }
        });
    }

    function agregarAporte(id) {

        Swal.fire({
            title: "Agregar Abono",
            input: "number",
            showCancelButton: true,
            inputValidator: v => !v || v <= 0 ? "Monto inválido" : null
        }).then(r => {

            if (!r.isConfirmed) return;

            $.post("/AhorrosyAportes/AgregarAporte", {
                aporteId: id,
                monto: r.value
            }, function (res) {

                Swal.fire("Resultado", res.message, res.success ? "success" : "error");

                if (res.success) consultarAportes();
            });
        });
    }

    function eliminarAporte(id) {

        Swal.fire({
            title: "¿Eliminar?",
            icon: "warning",
            showCancelButton: true
        }).then(r => {

            if (!r.isConfirmed) return;

            $.post("/AhorrosyAportes/EliminarAporte", {
                aporteId: id
            }, function (res) {

                Swal.fire("Resultado", res.message, res.success ? "success" : "error");

                if (res.success) consultarAportes();
            });
        });
    }

    function verHistorial(id) {

        $.get("/AhorrosyAportes/ObtenerHistorialAporte", { aporteId: id }, function (res) {

            if (!res.success || res.data.length === 0) {
                Swal.fire("Info", "Sin historial", "info");
                return;
            }

            let html = `
            <div style="max-height:300px; overflow-y:auto;">
                <table class="table table-bordered table-sm mb-0">
                    <thead class="table-light sticky-top">
                        <tr>
                            <th>Fecha</th>
                            <th>Monto</th>
                        </tr>
                    </thead>
                    <tbody>
        `;

            res.data.forEach(x => {
                html += `
                <tr>
                    <td>${formatearFecha(x.Fecha)}</td>
                    <td>${new Intl.NumberFormat('es-CR', {
                    style: 'currency',
                    currency: 'CRC'
                }).format(x.Monto)}</td>
                </tr>
            `;
            });

            html += `
                    </tbody>
                </table>
            </div>
        `;

            Swal.fire({
                title: "Historial de Aportes",
                html: html,
                width: 600
            });

        });
    }

</script>