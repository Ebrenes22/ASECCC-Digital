@{
    ViewBag.Title = "ConsultaAportesAsociado";
    Layout = "~/Views/Shared/_Layout.cshtml";
    @Html.Partial("_MenuModulos");
}

<div class="container my-5">
    <h1 class="text-center mb-4">Gestion de Aportes</h1>

    <!-- Filtros de búsqueda -->
    <div class="row mb-4">
        <!-- Filtro de asociado -->
        <div class="col-12 mb-3">
            <label for="asociado" class="form-label">Buscar Asociado</label>
            <input type="text" id="asociado" class="form-control" placeholder="Ingrese el nombre del asociado">
        </div>
        <!-- Botón de consulta -->
        <div class="col-12 d-flex justify-content-center">
            <button class="btn btn-primary w-100" onclick="consultarAportes()">
                <i class="bi bi-search"></i> Consultar
            </button>
        </div>
    </div>

    <!-- Resultados en forma de tabla -->
    <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
        <table class="table table-bordered table-sm" id="tablaAportes" style="font-size: 14px;">
            <thead class="table-light">
                <tr>
                    <th style="width: 15%;">Aportes</th>
                    <th style="width: 20%;">Fecha</th>
                    <th style="width: 20%;">Monto</th>
                    <th style="width: 15%;">Estado</th>
                    <th style="width: 30%;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                <!-- Filas dinámicas generadas por JavaScript -->
            </tbody>
        </table>
    </div>

    <!-- Modal para Registrar Aporte -->
    <div class="modal fade" id="modalRegistrarAporte" tabindex="-1" aria-labelledby="modalRegistrarAporteLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalRegistrarAporteLabel">Registrar Nuevo Aporte</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <form id="formRegistrarAporte">
                        <div class="mb-3">
                            <label for="nombreAsociado" class="form-label">Nombre del Asociado</label>
                            <input type="text" id="nombreAsociado" class="form-control" readonly>
                        </div>
                        <div class="mb-3">
                            <label for="fechaAporte" class="form-label">Fecha</label>
                            <input type="date" id="fechaAporte" class="form-control">
                        </div>
                        <div class="mb-3">
                            <label for="montoAporte" class="form-label">Monto</label>
                            <input type="number" id="montoAporte" class="form-control" placeholder="Ingrese el monto del aporte">
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-primary" onclick="registrarAporte()">Registrar</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal para Historial de Registro -->
    <div class="modal fade" id="modalHistorialRegistro" tabindex="-1" aria-labelledby="modalHistorialRegistroLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalHistorialRegistroLabel">Historial de Abonos</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <div class="table-responsive">
                        <table class="table table-bordered" id="tablaHistorial">
                            <thead class="table-light">
                                <tr>
                                    <th>Fecha</th>
                                    <th>Monto</th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- Historial dinámico generado por JavaScript -->
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
    const asociados = [
        { id: 1, nombre: 'Carlos Pérez', identificacion: '101010101' },
        { id: 2, nombre: 'Ana Rodríguez', identificacion: '202020202' }
    ];

    const aportes = [
        { id: 1, asociadoId: 1, tipo: 'Personal', monto: 50000, fecha: '2024-10-01', estado: 'Activo' },
        { id: 2, asociadoId: 1, tipo: 'Patronal', monto: 200000, fecha: '2023-05-15', estado: 'Activo' },
        { id: 3, asociadoId: 2, tipo: 'Personal', monto: 15000, fecha: '2024-11-10', estado: 'Inactivo' },
        { id: 4, asociadoId: 2, tipo: 'Patronal', monto: 250000, fecha: '2022-02-20', estado: 'Inactivo' }
    ];

    const historialAbonos = {
        1: [
            { fecha: '2024-09-15', monto: 20000 },
            { fecha: '2024-09-30', monto: 30000 }
        ],
        2: [
            { fecha: '2023-06-01', monto: 100000 },
            { fecha: '2023-06-15', monto: 100000 }
        ]
    };

    function consultarAportes() {
        const nombreAsociado = document.getElementById('asociado').value.toLowerCase();
        const asociado = asociados.find(a =>
            a.nombre.toLowerCase().includes(nombreAsociado) ||
            a.identificacion.includes(nombreAsociado)
        );

        if (!asociado) {
            alert('No se encontró el asociado.');
            return;
        }

        const aportesFiltrados = aportes.filter(aporte => aporte.asociadoId === asociado.id);
        const tablaBody = document.querySelector('#tablaAportes tbody');
        tablaBody.innerHTML = '';

        if (aportesFiltrados.length === 0) {
            tablaBody.innerHTML = '<tr><td colspan="5" class="text-center">No se encontraron aportes para este asociado.</td></tr>';
            return;
        }

        document.getElementById('nombreAsociado').value = asociado.nombre;

        aportesFiltrados.forEach(aporte => {
            const fila = document.createElement('tr');
            fila.innerHTML = `
                <td>${aporte.tipo}</td>
                <td>${aporte.fecha}</td>
                <td>${formatearMonto(aporte.monto)}</td>
                <td>${aporte.estado}</td>
                <td>
                    <button class="btn btn-success btn-sm" data-bs-toggle="modal" data-bs-target="#modalRegistrarAporte">
                        <i class="bi bi-plus-circle"></i> Registrar Aporte
                    </button>
                    <button class="btn btn-info btn-sm" onclick="verHistorial(${aporte.id})" data-bs-toggle="modal" data-bs-target="#modalHistorialRegistro">
                        <i class="bi bi-clock-history"></i> Historial de Registro
                    </button>
                </td>
            `;
            tablaBody.appendChild(fila);
        });
    }

    function formatearMonto(monto) {
        return monto.toLocaleString('es-CR', { style: 'currency', currency: 'CRC' });
    }

    function registrarAporte() {
        const nombreAsociado = document.getElementById('nombreAsociado').value;
        const fechaAporte = document.getElementById('fechaAporte').value;
        const montoAporte = document.getElementById('montoAporte').value;

        if (!nombreAsociado || !fechaAporte || !montoAporte) {
            alert('Por favor, complete todos los campos.');
            return;
        }

        alert(`Aporte registrado exitosamente para ${nombreAsociado} con monto de ${formatearMonto(Number(montoAporte))}.`);
        document.getElementById('formRegistrarAporte').reset();
        const modal = bootstrap.Modal.getInstance(document.getElementById('modalRegistrarAporte'));
        modal.hide();
    }

    function verHistorial(aporteId) {
        const tablaHistorial = document.querySelector('#tablaHistorial tbody');
        tablaHistorial.innerHTML = '';

        if (!historialAbonos[aporteId] || historialAbonos[aporteId].length === 0) {
            tablaHistorial.innerHTML = '<tr><td colspan="2" class="text-center">No hay historial de abonos para este aporte.</td></tr>';
            return;
        }

        historialAbonos[aporteId].forEach(abono => {
            const fila = document.createElement('tr');
            fila.innerHTML = `
                <td>${abono.fecha}</td>
                <td>${formatearMonto(abono.monto)}</td>
            `;
            tablaHistorial.appendChild(fila);
        });
    }
</script>
    