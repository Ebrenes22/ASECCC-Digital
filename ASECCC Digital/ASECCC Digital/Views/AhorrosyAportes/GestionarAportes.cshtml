@{
    ViewBag.Title = "Gestionar Aportes";
    Layout = "~/Views/Shared/_Layout.cshtml";
    @Html.Partial("_MenuModulos");
}

<link rel="stylesheet" href="https://code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css">

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://code.jquery.com/ui/1.12.1/jquery-ui.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<div class="container my-5">
    <h1 class="text-center mb-4">GESTION DE APORTES</h1>

    <div class="row mb-4">
        <div class="col-12 mb-3">
            <label for="asociado" class="form-label">Buscar Asociado</label>
            <input type="text" id="asociado" class="form-control" placeholder="Ingrese el nombre del asociado">
        </div>
    </div>

    <div class="d-flex justify-content-between mb-4">
        <button class="btn btn-primary" onclick="consultarAportes()">
            <i class="bi bi-search"></i> Consultar
        </button>
        <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#modalRegistrarAporte">
            <i class="bi bi-plus-circle"></i> Registrar Aporte
        </button>
    </div>

    <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
        <table class="table table-bordered table-sm" id="tablaAportes" style="font-size: 14px;">
            <thead class="table-light">
                <tr>
                    <th>Tipo de Aporte</th>
                    <th>Fecha</th>
                    <th>Monto</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

<!-- Modal para Registrar Aporte -->
<div class="modal fade" id="modalRegistrarAporte" tabindex="-1" aria-labelledby="modalRegistrarAporteLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalRegistrarAporteLabel">Registrar Nuevo Aporte</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <form id="formRegistrarAporte">
                    <div class="mb-3">
                        <label for="nombreAsociado" class="form-label">Nombre del Asociado</label>
                        <input type="text" id="nombreAsociado" class="form-control" readonly>
                    </div>
                    <div class="mb-3">
                        <label for="tipoAporte" class="form-label">Tipo de Aporte</label>
                        <select id="tipoAporte" class="form-select">
                            <option value="Personal">Personal</option>
                            <option value="Patronal">Patronal</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="montoAporte" class="form-label">Monto</label>
                        <input type="number" id="montoAporte" class="form-control" placeholder="Ingrese el monto del aporte">
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" onclick="registrarAporte()">Registrar</button>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        $("#asociado").autocomplete({
            source: function (request, response) {
                $.ajax({
                    url: "/AhorrosyAportes/BuscarAsociados",
                    type: "GET",
                    dataType: "json",
                    data: { termino: request.term },
                    success: function (data) {
                        response(data);
                    }
                });
            },
            minLength: 2,
            select: function (event, ui) {
                $("#asociado").val(ui.item.label);
                $("#nombreAsociado").val(ui.item.label);
                return false;
            }
        });
    });

    function consultarAportes() {
        let asociado = $("#asociado").val().trim();

        if (asociado === "") {
            Swal.fire("Atencion", "Por favor, ingrese el nombre del asociado.", "warning");
            return;
        }

        $.ajax({
            url: "/AhorrosyAportes/ConsultarAportesPorNombre",
            type: "GET",
            data: { nombreAsociado: asociado },
            success: function (response) {
                let tablaBody = $("#tablaAportes tbody");
                tablaBody.empty();

                if (!response.success || response.data.length === 0) {
                    tablaBody.append("<tr><td colspan='4' class='text-center'>No se encontraron aportes para este asociado.</td></tr>");
                    return;
                }

                response.data.forEach(aporte => {
                    let fecha = "No disponible";
                    if (aporte.FechaRegistro) {
                        let match = aporte.FechaRegistro.match(/\d+/);
                        if (match) {
                            let timestamp = parseInt(match[0]);
                            let fechaObj = new Date(timestamp);
                            fecha = fechaObj.toLocaleDateString('es-CR');
                        }
                    }

                    let montoFormateado = new Intl.NumberFormat('es-CR', { style: 'currency', currency: 'CRC' }).format(aporte.Monto);

                    let fila = `<tr>
                    <td>${aporte.TipoAporte}</td>
                    <td>${fecha}</td>
                    <td>${montoFormateado}</td>
                    <td>
                        <button class='btn btn-success btn-sm' onclick='agregarAporte(${aporte.AporteId})'>Agregar abono</button>
                        <button class="btn btn-info btn-sm text-white" onclick='verHistorial(${aporte.AporteId})'>Historial</button>
                        <button class='btn btn-danger btn-sm' onclick='eliminarAporte(${aporte.AporteId})'>Eliminar</button>
                    </td>
                </tr>`;
             
                    tablaBody.append(fila);
                });

            }
        });
    }


    function registrarAporte() {
        let nombreAsociado = $("#nombreAsociado").val().trim();
        let tipoAporte = $("#tipoAporte").val();
        let monto = $("#montoAporte").val();

        if (nombreAsociado === "" || monto === "") {
            Swal.fire("Atencion", "Debe ingresar el nombre del asociado y el monto.", "warning");
            return;
        }

        $.ajax({
            url: "/AhorrosyAportes/RegistrarAportePorNombre",
            type: "POST",
            data: { nombreAsociado: nombreAsociado, tipoAporte: tipoAporte, monto: monto },
            success: function (response) {
                Swal.fire("Exito", response.message, "success");
                if (response.success) {
                    $("#modalRegistrarAporte").modal("hide");
                    consultarAportes();
                }
            }
        });
    }

    function agregarAporte(aporteId) {
        Swal.fire({
            title: "Agregar Abono",
            input: "number",
            inputLabel: "Ingrese el monto a agregar:",
            showCancelButton: true,
            confirmButtonText: "Guardar",
            cancelButtonText: "Cancelar",
            inputValidator: (value) => {
                if (!value || value <= 0) {
                    return "Ingrese un monto válido";
                }
            }
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: "/AhorrosyAportes/AgregarAporte",
                    type: "POST",
                    data: { aporteId: aporteId, monto: result.value },
                    success: function (response) {
                        Swal.fire("Exito", response.message, "success");
                        if (response.success) {
                            consultarAportes();
                        }
                    }
                });
            }
        });
    }

    function eliminarAporte(aporteId) {
        $.ajax({
            url: "/AhorrosyAportes/EliminarAporte",
            type: "POST",
            data: { aporteId: aporteId },
            success: function (response) {
                Swal.fire("Exito", response.message, "success");
                consultarAportes();
            }
        });
    }

    function verHistorial(aporteId) {
        $.ajax({
            url: "/AhorrosyAportes/ObtenerHistorialAporte",
            type: "GET",
            data: { aporteId: aporteId },
            success: function (response) {
                if (!response || response.success === false) {
                    Swal.fire("Error", (response && response.message) ? response.message : "No se pudo cargar el historial.", "error");
                    return;
                }
                if (!response.data || response.data.length === 0) {
                    Swal.fire("Sin historial", "No hay transacciones registradas.", "info");
                    return;
                }

                function toCRC(v) {
                    return new Intl.NumberFormat('es-CR', { style: 'currency', currency: 'CRC' }).format(v);
                }
                function fmtDate(f) {
                    var m = /\/Date\((\d+)\)\//.exec(f);
                    var ts = m ? parseInt(m[1], 10) : Date.parse(f);
                    if (isNaN(ts)) return "-";
                    return new Date(ts).toLocaleDateString('es-CR');
                }

                var data = response.data;
                var pageSize = 11;
                var totalPages = Math.ceil(data.length / pageSize);

                var pagesHtml = "";
                for (var p = 1; p <= totalPages; p++) {
                    var start = (p - 1) * pageSize;
                    var end = Math.min(start + pageSize, data.length);

                    var table =
                        '<div class="hist-page" data-page="' + p + '" style="display:' + (p === 1 ? 'block' : 'none') + ';">' +
                        '<table class="table table-bordered mb-2">' +
                        '<thead>' +
                        '<tr>' +
                        '<th>Fecha</th>' +
                        '<th>Monto</th>' +
                        '</tr>' +
                        '</thead>' +
                        '<tbody>';

                    for (var i = start; i < end; i++) {
                        var t = data[i];
                        table +=
                            '<tr>' +
                            '<td>' + fmtDate(t.Fecha) + '</td>' +
                            '<td>' + toCRC(t.Monto) + '</td>' +
                            '</tr>';
                    }

                    table +=
                        '</tbody>' +
                        '</table>' +
                        '<div class="text-muted small text-center">Pagina ' + p + ' de ' + totalPages + '</div>' +
                        '</div>';

                    pagesHtml += table;
                }

                var pagerHtml = '<div id="hist-pager" class="d-flex flex-wrap gap-2 mt-3 justify-content-center">';
                for (var b = 1; b <= totalPages; b++) {
                    pagerHtml += '<button type="button" class="btn btn-sm ' + (b === 1 ? 'btn-primary' : 'btn-outline-primary') + ' hist-btn" data-page="' + b + '">' + b + '</button>';
                }
                pagerHtml += '</div>';

                var modalHtml = '<div id="hist-wrap">' + pagesHtml + pagerHtml + '</div>';

                Swal.fire({
                    title: 'Historial de Transacciones',
                    html: modalHtml,
                    width: '700px',
                    didOpen: function () {
                        var pager = document.getElementById('hist-pager');
                        pager.addEventListener('click', function (ev) {
                            var btn = ev.target.closest('.hist-btn');
                            if (!btn) return;

                            var page = parseInt(btn.getAttribute('data-page'), 10);
                            if (isNaN(page)) return;

                            var pages = document.querySelectorAll('.hist-page');
                            for (var i = 0; i < pages.length; i++) {
                                pages[i].style.display = ((i + 1) === page) ? 'block' : 'none';
                            }

                            var buttons = pager.querySelectorAll('.hist-btn');
                            for (var j = 0; j < buttons.length; j++) {
                                buttons[j].className = 'btn btn-sm btn-outline-primary hist-btn';
                            }
                            btn.className = 'btn btn-sm btn-primary hist-btn';
                        });
                    }
                });
            },
            error: function () {
                Swal.fire("Error", "Fallo la solicitud al servidor.", "error");
            }
        });
    }


</script>
