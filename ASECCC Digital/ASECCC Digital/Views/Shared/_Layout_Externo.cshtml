@{
    ViewBag.Title = ViewBag.Title ?? "ASECCC Digital";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - ASECCC Digital</title>
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet" />
    <script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <link rel="shortcut icon"
          href="@Url.Content("~/favicon.ico?v=3")"
          type="image/x-icon" />
    <link rel="icon"
          type="image/png"
          sizes="32x32"
          href="@Url.Content("~/Assets/img/logos/favicon-32x32.png")" />

    <style>
        html,
        body {
            min-height: 100%;
        }

        body {
            margin: 0;
            color: #1f2937;
            background:
                linear-gradient(135deg, rgba(240, 246, 255, 0.96), rgba(223, 238, 250, 0.94)),
                url('@Url.Content("~/Assets/img/wallpaper/background-solid.png")') center/cover no-repeat;
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
        }

        a {
            color: #0563bb;
        }

        a:hover,
        a:focus {
            color: #034f96;
        }

        .external-page {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .external-header {
            position: static;
            top: 0;
            z-index: 1000;
            border-bottom: 1px solid rgba(209, 213, 219, 0.72);
            background: rgba(255, 255, 255, 0.93);
            backdrop-filter: blur(12px);
            box-shadow: 0 10px 26px rgba(15, 23, 42, 0.08);
        }

        .external-nav {
            min-height: 76px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 22px;
            padding: 12px 0;
        }

        .external-brand {
            display: inline-flex;
            align-items: center;
            min-width: 0;
            color: #111827;
            text-decoration: none;
        }

        .external-brand:hover,
        .external-brand:focus {
            color: #111827;
            text-decoration: none;
        }

        .external-brand img {
            width: 58px;
            height: 58px;
            object-fit: contain;
            margin-right: 13px;
        }

        .external-brand-title {
            display: block;
            color: #111827;
            font-size: 1.08rem;
            font-weight: 800;
            line-height: 1.2;
        }

        .external-brand-subtitle {
            display: block;
            margin-top: 2px;
            color: #6b7280;
            font-size: 0.86rem;
            line-height: 1.25;
        }

        .external-contact {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
            justify-content: flex-end;
        }

        .external-contact-item {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 12px;
            border: 1px solid #dbeafe;
            border-radius: 999px;
            color: #1f4f83;
            background: #eff6ff;
            font-size: 0.88rem;
            font-weight: 700;
            white-space: nowrap;
        }

        .external-contact-item i {
            color: #0563bb;
        }

        .external-content {
            flex: 1 0 auto;
            width: 100%;
        }

        .external-content-inner {
            width: 100%;
        }

        .external-footer {
            flex-shrink: 0;
            border-top: 1px solid rgba(209, 213, 219, 0.78);
            background: rgba(255, 255, 255, 0.94);
        }

        .external-footer-main {
            display: grid;
            grid-template-columns: minmax(0, 1fr) auto;
            gap: 20px;
            align-items: center;
            padding: 20px 0;
        }

        .external-footer-copy h4 {
            margin: 0 0 4px;
            color: #111827;
            font-size: 1rem;
            font-weight: 800;
        }

        .external-footer-copy p {
            max-width: 680px;
            margin: 0;
            color: #6b7280;
            font-size: 0.9rem;
            line-height: 1.5;
        }

        .external-footer-meta {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
            justify-content: flex-end;
            color: #4b5563;
            font-size: 0.88rem;
        }

        .external-footer-meta a {
            font-weight: 700;
        }

        .external-credits {
            border-top: 1px solid #eef2f7;
            padding: 11px 0 14px;
            color: #8a94a6;
            font-size: 0.78rem;
            text-align: center;
        }

        @@media (max-width: 767.98px) {
            .external-nav {
                min-height: auto;
                align-items: flex-start;
                flex-direction: column;
            }

            .external-contact {
                justify-content: flex-start;
            }

            .external-contact-item {
                font-size: 0.82rem;
            }

            .external-brand img {
                width: 50px;
                height: 50px;
            }

            .external-brand-title {
                font-size: 1rem;
            }

            .external-brand-subtitle {
                font-size: 0.8rem;
            }

            .external-footer-main {
                grid-template-columns: 1fr;
            }

            .external-footer-meta {
                justify-content: flex-start;
            }
        }
    </style>
</head>
<body>
    <div class="external-page">
        <header class="external-header">
            <div class="container">
                <nav class="external-nav" aria-label="Encabezado externo">
                    <a class="external-brand" href="@Url.Action("Login", "Usuarios")">
                        <img src="@Url.Content("~/Assets/img/logos/ASECCC_LOGO_4.png")" alt="ASECCC" />
                        <span>
                            <span class="external-brand-title">ASECCC </span>
                            <span class="external-brand-subtitle">Asociación Solidarista Empleados Cadena Comercial Cartaginesa</span>
                        </span>
                    </a>

                    <div class="external-contact" aria-label="Contacto">
                        <span class="external-contact-item">
                            <i class="bi bi-telephone"></i>
                            2551-0782 / 2551-1376
                        </span>
                        <a class="external-contact-item" href="mailto:aseccc.cartago2009@gmail.com">
                            <i class="bi bi-envelope"></i>
                            Correo
                        </a>
                    </div>
                </nav>
            </div>
        </header>

        <main class="external-content">
            <div class="external-content-inner">
                @RenderBody()
            </div>
        </main>

        <footer id="footer" class="external-footer">
            <div class="container">
                <div class="external-footer-main">
                    <div class="external-footer-copy">
                        <h4>Sobre ASECCC</h4>
                        <p>En nuestra asociacion solidarista trabajamos para el bienestar de nuestros asociados, promoviendo apoyo, confianza y crecimiento para un futuro mejor.</p>
                    </div>

                    <div class="external-footer-meta">
                        <span><i class="bi bi-shield-check"></i> Portal seguro</span>
                        <a href="mailto:aseccc.cartago2009@gmail.com">aseccc.cartago2009@gmail.com</a>
                    </div>
                </div>

                <div class="external-credits">
                    Diseñado por Prosystec
                </div>
            </div>
        </footer>
    </div>

    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.bundle.min.js"></script>
</body>
</html>
