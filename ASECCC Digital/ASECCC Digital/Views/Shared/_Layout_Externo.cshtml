@{
    ViewBag.Title = "Login";
}


<!DOCTYPE html>
<html lang="es">
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ASECCC Digital</title>
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <link rel="shortcut icon"
          href="@Url.Content("~/favicon.ico?v=3")"
          type="image/x-icon" />

    <!-- favicon PNG 32×32 -->
    <link rel="icon"
          type="image/png"
          sizes="32x32"
          href="@Url.Content("~/assets/img/logos/favicon-32x32.png")" />

    <style>
        body {
            margin: 0;
            padding: 0;
            height: 100vh;
            background-color: rgba(6, 10, 119, 0.8);
            background-size: cover;
            color: darkblue;
        }

        .content {
            padding: 20px;
            background-color: rgba(0, 0, 0, 0.5);
            border-radius: 10px;
            max-width: 100%;
            margin: 0 auto;
            height: 100%;
        }

        .container-fluid {
            max-width: 100%;
            padding: 0;
        }

        footer {
            background-color: #f8f9fa;
        }

        .footer {
            padding-top: 40px;
            padding-bottom: 40px;
        }

            .footer h4 {
                font-size: 18px;
                margin-bottom: 15px;
            }

            .footer .list-unstyled li {
                font-size: 14px;
                margin-bottom: 10px;
            }

            .footer .copyright, .footer .credits {
                font-size: 14px;
                color: #6c757d;
            }

        header {
            background-color: rgba(0, 0, 0, 0.7);
            color: white;
            padding: 20px 0;
        }

            header h2 {
                margin: 0;
                font-size: 25px;
                text-align: center;
            }
    </style>
</head>
<body>

    <header>
        <h2>
            Asociación Solidarista Empleados Cadena Comercial Cartaginesa
        </h2>
    </header>

    <div class="container-fluid">
        <div class="content">
            @RenderBody()
        </div>
    </div>

    <footer id="footer" class="footer position-relative light-background py-4">
        <div class="container">
            <div class="row">


                <!-- Logo Section -->
                <div class="col-md-4 text-center">
                    <a href="#" class="navbar-brand">
                        <img src="~/Assets/img/logos/ASECCC_LOGO_1.png" alt="Logo" class="d-inline-block align-top" height="150">
                    </a>
                </div>

                <!-- About Us Section -->
                <div class="col-md-4 text-center">
                    <h4>Sobre Nosotros</h4>
                    <p class="text-muted">
                        Somos una asociación dedicada a fomentar el ahorro y el bienestar de nuestros afiliados mediante servicios innovadores y apoyo solidario.
                    </p>
                </div>

                <!-- Contact Section -->
                <div class="col-md-4 text-center">
                    <h4>Contacto</h4>
                    <ul class="list-unstyled">
                        <li>
                            <i class="bi bi-phone" aria-hidden="true"></i>
                            <span class="sr-only"></span> 2551-0782 / 2551-1376
                        </li>
                        <li>
                            <i class="bi bi-envelope" aria-hidden="true"></i>
                            <span class="sr-only">  </span>
                            <a href="mailto:aseccc.cartago2009@gmail.com">aseccc.cartago2009@gmail.com</a>
                        </li>
                    </ul>
                </div>


            </div>

            <div class="row">
                <div class="col text-center">

                    <div class="credits">
                        Designed by Grupo 5 Ingenieria en Sistema Universidad Fidelitas
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <!-- Scripts de Bootstrap -->
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
</body>
</html>
