@{
    ViewBag.Title = ViewBag.Title ?? "ASECCC Digital";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewBag.Title - ASECCC Digital</title>

    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet" />

    <script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <link href="@Url.Content("~/Content/Asociados/login.css")" rel="stylesheet" />
    <link href="@Url.Content("~/Content/Shared/layout_externo.css")"rel="stylesheet" />

    <link rel="shortcut icon"
          href="@Url.Content("~/favicon.ico?v=3")"
          type="image/x-icon" />

    <link rel="icon"
          type="image/png"
          sizes="32x32"
          href="@Url.Content("~/Assets/img/logos/favicon-32x32.png")" />
</head>
<body>
    <div class="external-page">
        <!-- HEADER -->
        <header class="external-header">
            <div class="container">
                <nav class="external-nav" aria-label="Encabezado externo">
                    <a class="external-brand"
                       href="@Url.Action("Login", "Usuarios")">

                        <img src="@Url.Content("~/Assets/img/logos/ASECCC_LOGO_4.png")"
                             alt="ASECCC" />
                        <span>
                            <span class="external-brand-title">
                                ASECCC Digital
                            </span>
                            <span class="external-brand-subtitle">
                                Asociación Solidarista Empleados Cadena Comercial Cartaginesa
                            </span>
                        </span>
                    </a>
                </nav>
            </div>
        </header>
        <!-- CONTENIDO PRINCIPAL -->
        <main class="external-content">

            <div class="external-content-inner">
                @RenderBody()
            </div>
        </main>
        <!-- FOOTER -->
        <footer id="footer" class="external-footer">
            <div class="container">
                <div class="external-footer-main">
                    <div class="external-footer-copy">
                        <h4>
                            Sobre ASECCC
                        </h4>
                        <p>
                            En nuestra asociación solidarista trabajamos
                            para el bienestar de nuestros asociados,
                            promoviendo apoyo, confianza y crecimiento
                            para un futuro mejor.
                        </p>
                    </div>
                    <div class="external-footer-meta">
                        <span class="external-contact-item">
                            <i class="bi bi-telephone"></i>
                            2551-0782 / 2551-1376
                        </span>
                        <a class="external-contact-item"
                           href="mailto:aseccc.cartago2009@gmail.com">
                            <i class="bi bi-envelope"></i>
                            aseccc.cartago2009@gmail.com
                        </a>
                    </div>
                </div>
                <div class="external-credits">
                    Copyright © 2026 ASECCC - Derechos Reservados
                </div>
            </div>
        </footer>
    </div>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.bundle.min.js"></script>
</body>

</html>