            </button>
            <div class="collapse navbar-collapse" id="submenu">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <!-- Rutas Menu Asociado-->
                    @if (currentModule == "Asociados")
                    {
                        if (userRole == "Admin")
                        {
                            <li class="nav-item">
                                <a class="nav-link" href="@Url.Action("Registrar", "Asociados")">Registrar Asociado</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="@Url.Action("Actualizar", "Asociados")">Actualizar Asociado</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="@Url.Action("Buscar", "Asociados")">Buscar Asociado</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="@Url.Action("Liquidar", "Asociados")">Liquidar Asociado</a>
                            </li>
                        }
                        else if (userRole == "Asociado")
                        {
                            <li class="nav-item">
                                <a class="nav-link" href="@Url.Action("Asociado", "Asociados")">Asociado</a>
                            </li>
