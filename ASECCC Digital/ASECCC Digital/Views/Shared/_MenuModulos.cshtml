                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="@Url.Action("ConsultaPrestamosAdmin", "Prestamos")">Consulta de Prestamos</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="@Url.Action("RevisionPrestamos", "Prestamos")">Revision de Prestamos</a>
