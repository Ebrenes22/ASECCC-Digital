                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="@Url.Action("ConsultarBenefyServAsociado", "BeneficiosyServicios")">Consulta de Beneficios Activos</a>
                            </li>
                        }
                    }

                    <!-- Rutas Menu Reportes-->
                    <!-- Rutas Menu Notificaciones-->
                    <!-- Rutas Menu Seguridad-->
