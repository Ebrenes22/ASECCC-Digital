@model ASECCC_Digital.ViewModels.SolicitudPrestamoViewModel

<!-- Modal Revisión Préstamo -->
<div class="modal fade" id="solicitudDetallesModal" tabindex="-1" aria-labelledby="solicitudModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="solicitudModalLabel">Detalles de la Solicitud</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <div class="modal-body">
                <form id="formSolicitud">
                    <input type="hidden" id="solicitud-id" />
                    <input type="hidden" id="usuario-id" />

                    <!-- Información Personal -->
                    <h6 class="fw-bold mb-2">Información Personal</h6>
                    <div class="row mb-2">
                        <div class="col-6">
                            <label class="form-label">Nombre Completo</label>
                            <span id="nombreCompleto" class="d-block small"></span>
                        </div>
                        <div class="col-6">
                            <label class="form-label">Estado Civil</label>
                            <span id="estadoCivil" class="d-block small"></span>
                        </div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-6">
                            <label class="form-label">¿Paga Alquiler?</label>
                            <span id="pagaAlquiler" class="d-block small"></span>
                        </div>
                        <div class="col-6">
                            <label class="form-label">Monto Alquiler</label>
                            <span id="montoAlquiler" class="d-block small"></span>
                        </div>
                    </div>

                    <hr />

                    <!-- Información de Deudas -->
                    <h6 class="fw-bold mb-2">Información de Deudas</h6>
                    <div class="row mb-2">
                        <div class="col-6">
                            <label class="form-label">Acreedor</label>
                            <span id="nombreAcreedor" class="d-block small"></span>
                        </div>
                        <div class="col-6">
                            <label class="form-label">Total Crédito</label>
                            <span id="totalCredito" class="d-block small"></span>
                        </div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-6">
                            <label class="form-label">Abono Semanal</label>
                            <span id="abonoSemanal" class="d-block small"></span>
                        </div>
                        <div class="col-6">
                            <label class="form-label">Saldo Crédito</label>
                            <span id="saldoCredito" class="d-block small"></span>
                        </div>
                    </div>

                    <hr />

                    <!-- Información del Fiador -->
                    <h6 class="fw-bold mb-2">Información del Fiador</h6>
                    <div class="row mb-2">
                        <div class="col-6">
                            <label class="form-label">Nombre Deudor</label>
                            <span id="nombreDeudor" class="d-block small"></span>
                        </div>
                        <div class="col-6">
                            <label class="form-label">Total Préstamo</label>
                            <span id="totalPrestamo" class="d-block small"></span>
                        </div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-6">
                            <label class="form-label">Saldo Préstamo</label>
                            <span id="saldoPrestamo" class="d-block small"></span>
                        </div>
                    </div>

                    <hr />

                    <!-- Detalle Préstamo -->
                    <h6 class="fw-bold mb-2">Detalle del Préstamo</h6>
                    <div class="row mb-2">
                        <div class="col-6">
                            <label class="form-label">Tipo de Préstamo</label>
                            <input type="text"
                                   class="form-control form-control-sm bg-light text-muted"
                                   id="tipoPrestamoTexto"
                                   name="tipoPrestamo"
                                   readonly />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Monto Solicitud</label>
                            <input type="text" class="form-control form-control-sm" id="montoSolicitud" />
                        </div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-6">
                            <label class="form-label">Plazo (meses)</label>
                            <input type="text" class="form-control form-control-sm" id="plazoMeses" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Cuota Semanal</label>
                            <input type="text" class="form-control form-control-sm" id="cuotaSemanalSolicitud" />
                        </div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-12">
                            <label class="form-label">Propósito</label>
                            <span id="propositoPrestamo" class="d-block small"></span>
                        </div>
                    </div>

                    <hr />

                    <!-- Estado -->
                    <h6 class="fw-bold mb-2">Estado de la Solicitud</h6>
                    <div class="row">
                        <div class="col-12">
                            <select class="form-select form-select-sm" id="estadoSelect">
                                <option value="pendiente">Pendiente</option>
                                <option value="revision">En Revisión</option>
                                <option value="aprobada">Aprobada</option>
                                <option value="rechazada">Rechazada</option>
                            </select>
                        </div>
                    </div>
                </form>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">
                    Cerrar
                </button>
                <button type="button" class="btn btn-primary btn-sm" id="guardarEstado">
                    Guardar Cambios
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    $('#guardarEstado').on('click', function () {

        var datos = {
            id: $('#solicitud-id').val(),
            tipoPrestamo: $('#tipoPrestamoTexto').val(),
            montoSolicitud: $('#montoSolicitud').val(),
            plazoMeses: $('#plazoMeses').val(),
            cuotaSemanalSolicitud: $('#cuotaSemanalSolicitud').val(),
            estadoSolicitud: $('#estadoSelect').val()
        };


        if (!datos.estadoSolicitud) {
            Swal.fire('Atención', 'Debe seleccionar el estado.', 'warning');
            return;
        }

        $.post('@Url.Action("ActualizarSolicitud", "Prestamos")', datos)
            .done(function (response) {
                if (response.success) {
                    Swal.fire('Éxito', 'Solicitud actualizada correctamente.', 'success')
                        .then(() => window.location.href = '@Url.Action("RevisionPrestamos", "Prestamos")');
                } else {
                    Swal.fire('Error', response.error, 'error');
                }
            })
            .fail(function () {
                Swal.fire('Error', 'Error de comunicación con el servidor.', 'error');
            });
    });

</script>
