<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - ASECCC Digital</title>
    <!-- Bootstrap CSS desde la CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/Content/bootstrap.min.css" />
    <!-- Bootstrap Icons desde la CDN -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.10.5/font/bootstrap-icons.min.css" rel="stylesheet">
    <!-- Otras dependencias CSS -->
    <link href="~/assets/vendor/aos/aos.css" rel="stylesheet">
    <link href="~/assets/vendor/glightbox/css/glightbox.min.css" rel="stylesheet">
    <link href="~/assets/vendor/swiper/swiper-bundle.min.css" rel="stylesheet">
    <!-- CSS principal -->
    <link href="~/assets/css/main.css" rel="stylesheet">

    <script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
    <!--SweetAlert2 -->
    <!-- SweetAlert2 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">
    <!-- SweetAlert2 JS -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/purecounterjs@1.0.3/purecounter_vanilla.js"></script>

    <style>

        html, body {
            height: 100%;
            margin: 0;
            display: flex;
            flex-direction: column;
            overflow-x: hidden;
        }



        .main {
            flex: 1;
        }

        .footer {
            margin-top: auto;
        }


        #modalNotificaciones {
            max-width: 90vw;
            word-wrap: break-word;
        }
    </style>
</head>

@using System.Web.Security;
@{
    var usuario = User.Identity.Name;
    var rol = "";

    if (User.Identity.IsAuthenticated)
    {
        rol = ((FormsIdentity)User.Identity).Ticket.UserData.ToLower();
    }

    var nombreCompleto = Session["usuarioNombre"] as string;
    var primerNombre = !string.IsNullOrEmpty(nombreCompleto)
                       ? nombreCompleto.Split(' ')[0]
                       : "";

}
@{

    var ultimas = HttpContext.Current.Items["UltimasNotificaciones"] as List<ASECCC_Digital.ViewModels.NotificacionResumenViewModel> ?? new List<ASECCC_Digital.ViewModels.NotificacionResumenViewModel>();
    var pendientes = HttpContext.Current.Items["NotificacionesPendientes"] as int? ?? 0;


}

<body class="index-page">
    <!-- Header -->
    <header id="header" class="header d-flex flex-column justify-content-center">
        <i class="header-toggle d-xl-none bi bi-list"></i>
        <nav id="navmenu" class="navmenu">
            <ul>
                @if (rol == "asociado")
                {
                    <li><a href="@Url.Action("Index", "Home")" class="active"><i class="bi bi-house navicon"></i><span>Inicio</span></a></li>
                    <li><a href="@Url.Action("Asociados", "Asociados")"><i class="bi bi-person navicon"></i><span>Asociados</span></a></li>
                    <li><a href="@Url.Action("Prestamo", "Prestamos")"><i class="bi bi-cash"></i><span>Prestamos</span></a></li>
                    <li><a href="@Url.Action("AhorroyAporte", "AhorrosyAportes")"><i class="bi bi-piggy-bank"></i><span>Ahorros y Aportes</span></a></li>
                    <li><a href="@Url.Action("BeneficioyServicio", "BeneficiosyServicios")"><i class="bi bi-person-lines-fill"></i><span>Beneficios y Servicio</span></a></li>
                    <li><a href="@Url.Action("Reporte", "Reportes")"><i class="bi bi-file-earmark-text"></i><span>Reportes</span></a></li>
                    <li><a href="@Url.Action("Notificaciones", "Notificaciones")"><i class="bi bi-envelope navicon"></i><span>Notificaciones</span></a></li>
                    <li><a href="@Url.Action("FAQ", "ContactoySoporte")"><i class="bi-headset navicon"></i><span>Soporte</span></a></li>
                }

                @if (rol == "administrador")
                {
                    <li><a href="@Url.Action("Index", "Home")" class="active"><i class="bi bi-house navicon"></i><span>Inicio</span></a></li>
                    <li><a href="@Url.Action("Asociados", "Asociados")"><i class="bi bi-person navicon"></i><span>Asociados</span></a></li>
                    <li><a href="@Url.Action("Prestamo", "Prestamos")"><i class="bi bi-cash"></i><span>Prestamos</span></a></li>
                    <li><a href="@Url.Action("AhorroyAporte", "AhorrosyAportes")"><i class="bi bi-piggy-bank"></i><span>Ahorros y Aportes</span></a></li>
                    <li><a href="@Url.Action("BeneficioyServicio", "BeneficiosyServicios")"><i class="bi bi-person-lines-fill"></i><span>Beneficios y Servicio</span></a></li>
                    <li><a href="@Url.Action("Reporte", "Reportes")"><i class="bi bi-file-earmark-text"></i><span>Reportes</span></a></li>
                    <li><a href="@Url.Action("Notificaciones", "Notificaciones")"><i class="bi bi-envelope navicon"></i><span>Notificaciones</span></a></li>
                    <li><a href="@Url.Action("SeguridadyPermiso", "SeguridadyPermisos")"><i class="bi bi-lock"></i><span>Seguridad y Permiso</span></a></li>
                }
            </ul>
        </nav>
    </header>

    <nav class="navbar navbar-light bg-light px-5 w-100">
        <div class="d-flex w-100 justify-content-between">
            <!-- Logo alineado a la izquierda -->
            <button onclick="window.location='@Url.Action("Index", "Home")'" class="btn p-0" style="background: none; border: none;">
                <img src="~/Assets/img/logos/ASECCC_LOGO3.1.png" alt="Logo" class="d-inline-block align-top" height="35">
            </button>

            <!-- Elementos relacionados con el usuario (alineados a la derecha) -->
            <div class="d-flex align-items-center">
                <!-- Notificaciones -->
                <div class="notifications position-relative me-3">
                    <a href="@Url.Action("Notificaciones", "Notificaciones")" style="text-decoration: none; color: inherit;">
                        <i class="bi bi-bell fs-5" style="cursor: pointer;"></i>

                        @if (pendientes > 0)
                        {
                            <span class="badge bg-danger position-absolute top-0 start-100 translate-middle" id="badgeNotificaciones">@pendientes</span>
                        }

                        </a>

</div>




                <!-- Nombre del usuario -->
                <div class="user-info me-3">
                    <span>Bienvenido @primerNombre</span>
                </div>

                <!-- Menú del usuario -->
                <div class="dropdown">
                    <a href="#" class="d-flex align-items-center text-decoration-none dropdown-toggle" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-person-circle fs-5"></i>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                        <li><a class="dropdown-item" href="@Url.Action("PerfilAsociado", "Perfil")">Perfil</a></li>
                        <li><a class="dropdown-item" href="@Url.Action("Logout", "Usuarios")">Salir</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </nav>


    <!-- Main Content -->
    <main class="main">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer id="footer" class="footer position-relative light-background py-4">

        <div class="row">
            <div class="col text-center">
                <div class="copyright">
                    <span>© Asociación Solidarista Empleados Cadena Comercial Cartaginesa</span>
                </div>
                <div class="credits">
                    Designed by Grupo 5 Ingenieria en Sistema Universidad Fidelitas
                </div>
            </div>
        </div>

    </footer>

    <!-- Scroll to Top -->
    <a href="#" id="scroll-top" class="scroll-top d-flex align-items-center justify-content-center"><i class="bi bi-arrow-up-short"></i></a>

    <!-- Preloader -->
    <div id="preloader"></div>

    <!-- Vendor JS Files -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/vendor/aos/aos.js"></script>
    <script src="~/assets/vendor/typed.js/typed.umd.js"></script>
    <script src="~/assets/vendor/glightbox/js/glightbox.min.js"></script>
    <script src="~/assets/vendor/swiper/swiper-bundle.min.js"></script>
    <script src="~/assets/js/main.js"></script>

    @section Scripts {
        <script>
            function logout() {
                $.ajax({
                    url: '@Url.Action("Logout", "Usuarios")',
                    type: 'POST',
                    success: function () {
                        window.location.href = '@Url.Action("Login", "Usuarios")';
                    },
                    error: function () {
                        alert('Error al cerrar sesión.');
                    }
                });
            }

                function actualizarBadgeNotificaciones() {
        $.get('@Url.Action("ObtenerNotificacionesNoLeidas", "Notificaciones")', function (data) {
            if (data.length > 0) {
                $('#badgeNotificaciones').text(data.length).show();
            } else {
                $('#badgeNotificaciones').hide();
            }
        });
    }

                $(document).ready(function () {
                    actualizarBadgeNotificaciones(); // primera carga

                    setInterval(function () {
                        actualizarBadgeNotificaciones(); // cada 10 seg
                    }, 10000);
                });
        </script>
    }

    @RenderSection("Scripts", required: false)
</body>
</html>



