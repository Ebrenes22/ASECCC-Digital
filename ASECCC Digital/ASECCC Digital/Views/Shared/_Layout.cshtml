<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - ASECCC Digital</title>
    <!-- Bootstrap CSS desde la CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons desde la CDN -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.10.5/font/bootstrap-icons.min.css" rel="stylesheet">
    <!-- Otras dependencias CSS -->
    <link href="~/assets/vendor/aos/aos.css" rel="stylesheet">
    <link href="~/assets/vendor/glightbox/css/glightbox.min.css" rel="stylesheet">
    <link href="~/assets/vendor/swiper/swiper-bundle.min.css" rel="stylesheet">
    <!-- CSS principal -->
    <link href="~/assets/css/main.css" rel="stylesheet">
    <!--SweetAlert2 -->
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11.5.6/dist/sweetalert2.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.5.6/dist/sweetalert2.min.js"></script>

    <style>
        html, body {
            height: 100%;
            margin: 0;
            display: flex;
            flex-direction: column;
        }

        .main {
            flex: 1;
        }

        .footer {
            margin-top: auto;
        }
    </style>
</head>

<body class="index-page">
    <!-- Header -->
    <header id="header" class="header d-flex flex-column justify-content-center">
        <i class="header-toggle d-xl-none bi bi-list"></i>
        <nav id="navmenu" class="navmenu">
            <ul>
                <li><a href="@Url.Action("Index", "Home")" class="active"><i class="bi bi-house navicon"></i><span>Inicio</span></a></li>
                <li><a href="@Url.Action("Asociados", "Asociados")"><i class="bi bi-person navicon"></i><span>Asociados</span></a></li>
                <li><a href="@Url.Action("Prestamo", "Prestamos")"><i class="bi bi-cash"></i><span>Prestamos</span></a></li>
                <li><a href="@Url.Action("AhorroyAporte", "AhorrosyAportes")"><i class="bi bi-piggy-bank"></i><span>Ahorros y Aportes</span></a></li>
                <li><a href="@Url.Action("BeneficioyServicio", "BeneficiosyServicios")"><i class="bi bi-person-lines-fill"></i><span>Beneficios y Servicio</span></a></li>
                <li><a href="@Url.Action("Reporte", "Reportes")"><i class="bi bi-file-earmark-text"></i><span>Reportes</span></a></li>
                <li><a href="@Url.Action("Notificaciones", "Notificaciones")"><i class="bi bi-envelope navicon"></i><span>Notificaciones</span></a></li>
                @if (Session["UserRole"] != null && Session["UserRole"].ToString() == "Admin")
                {
                    <li><a href="@Url.Action("SeguridadyPermiso", "SeguridadyPermisos")"><i class="bi bi-lock"></i><span>Seguridad y Permiso</span></a></li>
                }
            </ul>
        </nav>
    </header>

    <!-- Barra superior con logo, notificaciones y usuario -->
    <nav class="navbar navbar-light bg-light px-5 w-100">
        <div class="d-flex w-100 justify-content-between">
            <!-- Logo alineado a la izquierda -->

            <button onclick="window.location='@Url.Action("Index", "Home")'" class="btn p-0" style="background: none; border: none;">
                <img src="~/Assets/img/logos/ASECCC_LOGO3.1.png" alt="Logo" class="d-inline-block align-top" height="35">
            </button>


            <!-- Sistema de notificaciones -->
            <div class="notifications position-relative me-3 ms-auto">
                <i class="bi bi-bell fs-5"></i>
                <span class="badge bg-danger position-absolute top-0 start-100 translate-middle">3</span>
            </div>

            <!-- Menú del usuario -->
            <div class="dropdown">
                <a href="#" class="d-flex align-items-center text-decoration-none dropdown-toggle" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="bi bi-person-circle fs-5"></i>
                </a>
                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                    <li><a class="dropdown-item" href="@Url.Action("PerfilAsociado", "Perfil")">Perfil</a></li>
                    <li><a class="dropdown-item" href="@Url.Action("Login", "Usuarios")">Salir</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="main">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer id="footer" class="footer position-relative light-background py-4">
        <div class="container">
            @if (Session["UserRole"] != null && Session["UserRole"].ToString() == "Asociado")
            {

                <section id="info-section" class="py-5">
                    <div class="container">
                        <div class="row">
                            <!-- Misión -->
                            <div class="col-md-6 mb-4">
                                <div class="card shadow">
                                    <div class="card-body">
                                        <h2 class="card-title text-center">Misión</h2>
                                        <p class="card-text">Ofrecer servicios y beneficios innovadores que impulsen el bienestar económico, social y personal de nuestros asociados, fomentando valores de solidaridad, cooperación y responsabilidad compartida para mejorar su calidad de vida y fortalecer la comunidad.</p>
                                    </div>
                                </div>
                            </div>

                            <!-- Visión -->
                            <div class="col-md-6 mb-4">
                                <div class="card shadow">
                                    <div class="card-body">
                                        <h2 class="card-title text-center">Visión</h2>
                                        <p class="card-text">Convertirnos en un pilar fundamental para el progreso económico y social de nuestros asociados, promoviendo la solidaridad y el trabajo conjunto como herramientas para alcanzar el bienestar común y el desarrollo sostenible de nuestras comunidades.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
                <div class="row">
                    <!-- Contact Section -->
                    <div class="col-md-4 text-center">
                        <h4>Contacto</h4>
                        <ul class="list-unstyled">
                            <li>
                                <i class="bi bi-phone" aria-hidden="true"></i>
                                <span class="sr-only"></span> 2551-0782 / 2551-1376
                            </li>
                            <li>
                                <i class="bi bi-envelope" aria-hidden="true"></i>
                                <span class="sr-only">  </span>
                                <a href="mailto:aseccc.cartago2009@gmail.com">aseccc.cartago2009@gmail.com</a>
                            </li>
                        </ul>
                    </div>

                    <!-- Logo Section -->
                    <div class="col-md-4 text-center">
                        <a href="#" class="navbar-brand">
                            <img src="~/Assets/img/logos/ASECCC_LOGO_1.png" alt="Logo" class="d-inline-block align-top" height="150">
                        </a>
                    </div>

                    <!-- About Us Section -->
                    <div class="col-md-4 text-center">
                        <h4>Sobre Nosotros</h4>
                        <p class="text-muted">
                            Somos una asociación dedicada a fomentar el ahorro y el bienestar de nuestros afiliados mediante servicios innovadores y apoyo solidario.
                        </p>
                    </div>
                </div>


            }
            <div class="row">
                <div class="col text-center">
                    <div class="copyright">
                        <span>© Asociación Solidarista Empleados Cadena Comercial Cartaginesa</span>
                    </div>
                    <div class="credits">
                        Designed by Grupo 5 Ingenieria en Sistema Universidad Fidelitas
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <!-- Scroll to Top -->
    <a href="#" id="scroll-top" class="scroll-top d-flex align-items-center justify-content-center"><i class="bi bi-arrow-up-short"></i></a>

    <!-- Preloader -->
    <div id="preloader"></div>

    <!-- Vendor JS Files -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/vendor/aos/aos.js"></script>
    <script src="~/assets/vendor/typed.js/typed.umd.js"></script>
    <script src="~/assets/vendor/glightbox/js/glightbox.min.js"></script>
    <script src="~/assets/vendor/swiper/swiper-bundle.min.js"></script>
    <script src="~/assets/js/main.js"></script>

    @RenderSection("Scripts", required: false)
</body>

</html>
