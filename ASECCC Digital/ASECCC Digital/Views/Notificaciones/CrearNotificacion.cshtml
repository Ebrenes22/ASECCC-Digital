@{
    ViewBag.Title = "Enviar Notificaciones";
    Layout = "~/Views/Shared/_Layout.cshtml";
    @Html.Partial("_MenuModulos");
}

<section class="d-flex justify-content-center align-items-center" style="height: 80vh; padding-top: 60px;">
    <div class="container">
        <h3 class="mb-4 text-center">Crear Notificación</h3>

        <div class="card">
            <div class="card-body">
                <form id="formNotificacion">
                    <div class="row g-3">
                        <div class="col-md-12">
                            <label for="tipoNotificacion" class="form-label">Tipo de Notificación</label>
                            <select class="form-select" id="tipoNotificacion" name="tipoNotificacion">
                                <option value="masiva">Masiva (a todos los asociados)</option>
                                <option value="personalizada">Personalizada (a usuarios específicos)</option>
                            </select>
                        </div>
                        <div class="col-md-12">
                            <label for="destinatarios" class="form-label">Destinatarios</label>
                            <input type="text" class="form-control" id="destinatarios" name="destinatarios" placeholder="Ingrese IDs separados por comas" disabled>
                            <small class="text-muted">Este campo solo se habilitará para notificaciones personalizadas.</small>
                        </div>
                        <div class="col-md-12">
                            <label for="asunto" class="form-label">Asunto</label>
                            <input type="text" class="form-control" id="asunto" name="asunto" required>
                        </div>
                        <div class="col-md-12">
                            <label for="mensaje" class="form-label">Mensaje</label>
                            <textarea class="form-control" id="mensaje" name="mensaje" rows="5" required></textarea>
                        </div>
                    </div>
                    <div class="text-end mt-3">
                        <button type="submit" class="btn btn-primary">Enviar Notificación</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

<script>

    document.getElementById('tipoNotificacion').addEventListener('change', function () {
        const destinatarios = document.getElementById('destinatarios');
        destinatarios.disabled = this.value !== 'personalizada';
    });

    document.getElementById('formNotificacion').addEventListener('submit', function (e) {
        e.preventDefault();

        const tipoNotificacion = document.getElementById('tipoNotificacion').value;
        const destinatarios = document.getElementById('destinatarios').value;
        const asunto = document.getElementById('asunto').value;
        const mensaje = document.getElementById('mensaje').value;

        $.ajax({
            type: 'POST',
            url: '/Notificaciones/Enviar',
            data: {
                tipoNotificacion: tipoNotificacion,
                destinatarios: destinatarios,
                asunto: asunto,
                mensaje: mensaje
            },
            beforeSend: function () {
                Swal.fire({
                    title: 'Enviando...',
                    text: 'Por favor espera',
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });
            },
            success: function (response) {
                Swal.close();

                if (response.success) {
                    Swal.fire({
                        icon: 'success',
                        title: '¡Notificación enviada!',
                        text: response.mensaje,
                        confirmButtonText: 'OK'
                    }).then(() => {
                        document.getElementById('formNotificacion').reset();
                        document.getElementById('destinatarios').disabled = true;
                    });
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: response.mensaje,
                        confirmButtonText: 'Aceptar'
                    });
                }
            },
            error: function () {
                Swal.close(); 
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'Error de comunicación con el servidor.',
                    confirmButtonText: 'Aceptar'
                });
            }
        });
    });

</script>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
