@{
    ViewBag.Title = "Enviar Notificaciones";
    Layout = "~/Views/Shared/_Layout.cshtml";
    @Html.Partial("_MenuModulos");
}

<section class="d-flex justify-content-center align-items-start" style="height: 100vh; padding-top: 50px;">
    <div class="container">
        <h3 class="mb-4 text-center">Notificaciones de Solicitudes de Préstamo</h3>

        <!-- Card para hacer la tabla responsive -->
        <div class="card">
            <div class="card-body">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Hora</th>
                            <th>Solicitante</th>
                            <th>Monto</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>2024-12-05</td>
                            <td>10:00 AM</td>
                            <td>Juan Pérez</td>
                            <td>$5,000</td>
                            <td>Pendiente</td>
                            <td>
                                <button class="btn btn-primary btn-sm" onclick="verDetalles('2024-12-05', '10:00 AM', 'Juan Pérez', '$5,000', 'Pendiente')">Ver Detalles</button>
                                <button class="btn btn-success btn-sm">Marcar como Revisada</button>
                            </td>
                        </tr>
                        <tr>
                            <td>2024-12-04</td>
                            <td>2:45 PM</td>
                            <td>María Gómez</td>
                            <td>$3,000</td>
                            <td>Revisada</td>
                            <td>
                                <button class="btn btn-primary btn-sm" onclick="verDetalles('2024-12-04', '2:45 PM', 'María Gómez', '$3,000', 'Revisada')">Ver Detalles</button>
                                <button class="btn btn-secondary btn-sm" disabled>Revisada</button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

<script>
    function verDetalles(fecha, hora, solicitante, monto, estado) {
        alert(`Detalles de la solicitud:\n\nFecha: ${fecha}\nHora: ${hora}\nSolicitante: ${solicitante}\nMonto: ${monto}\nEstado: ${estado}`);
    }
</script>
