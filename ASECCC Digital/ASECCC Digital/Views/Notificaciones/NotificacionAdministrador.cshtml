@model List<ASECCC_Digital.Database.Notificaciones>

@{
    ViewBag.Title = "Notificaciones para Administradores";
    Layout = "~/Views/Shared/_Layout.cshtml";
    @Html.Partial("_MenuModulos");

}

<div class="container my-4">
    <h2 class="text-center">NOTIFICACIONES</h2>

    <table id="tablaNotificaciones" class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Título</th>
                <th>Mensaje</th>
                <th>Fecha y Hora</th>
                <th>Estado</th>
                <th>Acción</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var notificacion in Model)
            {
                <tr class="@(notificacion.estado == "enviada" ? "fw-bold" : "")" id="fila-@notificacion.notificacionId">
                    <td>@notificacion.titulo</td>
                    <td>@notificacion.contenido</td>
                    <td>@notificacion.fechaEnvio</td>
                    <td>
                        <span class="badge bg-@(notificacion.estado == "leida" ? "success" : "warning")" id="estado-@notificacion.notificacionId">
                            @notificacion.estado
                        </span>
                    </td>
                    <td>
                        <button class="btn btn-primary btn-sm ver-notificacion" data-id="@notificacion.notificacionId">
                            Ver
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Enlace a DataTables.js (CDN) -->
<link rel="stylesheet" href="https://cdn.datatables.net/1.11.5/css/jquery.dataTables.min.css">
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>

<script>
    $(document).ready(function () {

        // Inicializar DataTables con paginación y configuración
        $('#tablaNotificaciones').DataTable({
            "pageLength": 15,  // Muestra 15 notificaciones por página
            "lengthChange": false,  // Oculta la opción de cambiar la cantidad de registros por página
            "order": [[2, "desc"]],  // Ordena por fecha (columna 2) de forma descendente
            "language": {
                "paginate": {
                    "previous": "Anterior",
                    "next": "Siguiente"
                },
                "search": "Buscar:",
                "info": "Mostrando _START_ a _END_ de _TOTAL_Notificaciones",
                "infoEmpty": "No hay notificaciones disponibles",
                "emptyTable": "No hay notificaciones registradas",
                "zeroRecords": "No se encontraron coincidencias"
            }
        });

        // AJAX para marcar como leída una notificación
        $(".ver-notificacion").click(function () {
            var notificacionId = $(this).data("id");

            $.ajax({
                url: '@Url.Action("MarcarComoLeida", "Notificaciones")',
                type: 'POST',
                data: { id: notificacionId },
                success: function (data) {
                    if (data.success) {
                        $("#detalleNotificacion").text(data.contenido);
                        $("#modalNotificacion").modal("show");

                        // Actualiza el estado visualmente en la tabla
                        $("#estado-" + notificacionId).removeClass("bg-warning").addClass("bg-success").text("Leida");
                        $("#fila-" + notificacionId).removeClass("fw-bold");
                    }
                }
            });
        });
    });
</script>

<style>
    #tablaNotificaciones {
        width: 100% !important;
        table-layout: auto;
    }

        #tablaNotificaciones th,
        #tablaNotificaciones td {
            vertical-align: middle;
        }

            /* Título */
            #tablaNotificaciones th:nth-child(1),
            #tablaNotificaciones td:nth-child(1) {
                width: 20%;
            }

            /* Mensaje */
            #tablaNotificaciones th:nth-child(2),
            #tablaNotificaciones td:nth-child(2) {
                width: 40%;
                white-space: normal;
                word-break: break-word;
            }

            /* Fecha */
            #tablaNotificaciones th:nth-child(3),
            #tablaNotificaciones td:nth-child(3) {
                width: 15%;
                text-align: center;
                white-space: nowrap;
            }

            /* Estado */
            #tablaNotificaciones th:nth-child(4),
            #tablaNotificaciones td:nth-child(4) {
                width: 10%;
                text-align: center;
            }

            /* Acción */
            #tablaNotificaciones th:nth-child(5),
            #tablaNotificaciones td:nth-child(5) {
                width: 15%;
                text-align: center;
            }

        #tablaNotificaciones tbody tr:hover {
            background-color: #f8f9fa;
        }

    .badge {
        font-size: 0.85rem;
        padding: 6px 10px;
    }

    .ver-notificacion {
        min-width: 80px;
    }

    .dataTables_wrapper {
        margin-top: 15px;
    }
</style>