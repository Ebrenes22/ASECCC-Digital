            <a class="navbar-brand" href="#">Notificaciones</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#submenuAsociados" aria-controls="submenuAsociados" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="submenuAsociados">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link active" href="@Url.Action("NotificacionUsuario", "Notificaciones")">Notificaciones Usuario</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href=@Url.Action("NotificacionAdministrador", "Notificaciones")>Notificaciones Administrador</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href=@Url.Action("NotificacionAdminGestion", "Notificaciones")>Envio de notificaciones</a>
                    </li>
                   
                </ul>
            </div>

</section>