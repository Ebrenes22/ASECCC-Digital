@{
    ViewBag.Title = "Notificaciones";
    Layout = "~/Views/Shared/_Layout.cshtml";
    @Html.Partial("_MenuModulos")
}

<section class="container mt-4" style="margin-left: 60px;">
    <h3 class="mb-4">Bandeja de Notificaciones</h3>

    <!-- Tabla de notificaciones -->
