@model List<ASECCC_Digital.Database.Notificaciones>
@{
    ViewBag.Title = "Notificaciones";
    Layout = "~/Views/Shared/_Layout.cshtml";
    @Html.Partial("_MenuModulos");
}

<div class="container my-4">
    <h2 class="text-center">Notificaciones</h2>

    <div class="table-responsive">
        <table id="tablaNotificaciones" class="table table-striped table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>Título</th>
                    <th>Mensaje</th>
                    <th>Fecha y Hora</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var notificacion in Model)
                {
                    <tr class="@(notificacion.estado.ToLower() == "enviada" ? "fw-bold" : "")" id="fila-@notificacion.notificacionId">
                        <td>@notificacion.titulo</td>
                        <td>@notificacion.contenido</td>
                        <td class="text-center">
                            @(notificacion.fechaEnvio.HasValue
                                ? notificacion.fechaEnvio.Value.ToString("dd-MM-yyyy HH:mm")
                                : "")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- DataTables CSS y JS (si no se cargan en el Layout, inclúyelos aquí) -->
<link rel="stylesheet" href="https://cdn.datatables.net/1.11.5/css/jquery.dataTables.min.css">
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>

<script>
    $(document).ready(function () {
        $('#tablaNotificaciones').DataTable({
            "pageLength": 15,
            "lengthChange": false,
            "order": [[2, "desc"]],
            "language": {
                "paginate": {
                    "previous": "Anterior",
                    "next": "Siguiente"
                },
                "search": "Buscar:",
                "info": "Mostrando _START_ a _END_ de _TOTAL_ Notificaciones",
                "infoEmpty": "No hay notificaciones disponibles",
                "emptyTable": "No hay notificaciones registradas",
                "zeroRecords": "No se encontraron coincidencias"
            }
        });
    });

    $(".ver-notificacion").click(function () {
        var notificacionId = $(this).data("id");

        $.ajax({
            url: '@Url.Action("MarcarComoLeida", "Notificaciones")',
            type: 'POST',
            data: { id: notificacionId },
            success: function (data) {
                if (data.success) {
                    $("#detalleNotificacion").text(data.contenido);
                    $("#modalNotificacion").modal("show");

                    $("#estado-" + notificacionId).removeClass("bg-warning").addClass("bg-success").text("leida");
                    $("#fila-" + notificacionId).removeClass("fw-bold");
                }
            }
        });
    });
</script>

<style>
    /* Estilos generales para la tabla */
    #tablaNotificaciones th,
    #tablaNotificaciones td {
        text-align: center;
    }

   
    @@media (min-width: 768px) {
        th: nth-child(2), td:nth-child(2)

    {
        width: 300px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    th:nth-child(3), td:nth-child(3) {
        width: 180px;
    }

    }

    @@media (max-width: 767.98px) {
        th, td {
            font-size: 12px;
            padding: 5px;
        }
    }

</style>
