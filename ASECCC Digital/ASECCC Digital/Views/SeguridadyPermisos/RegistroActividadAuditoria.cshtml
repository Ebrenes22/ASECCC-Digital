@{
    ViewBag.Title = "Historial de Inicios de Sesión";
}

<!-- Cargar Estilos de DataTables -->
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css">
<link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.3.6/css/buttons.dataTables.min.css">

<div class="container d-flex flex-column align-items-center mt-4">
    <h2 class="text-center">HISTORIAL DE INICIOS DE SESIÓN</h2>

    <div class="card p-3 shadow-sm w-100" style="max-width: 800px;">
        @using (Html.BeginForm(null, null, FormMethod.Get, new { id = "filtroForm", @class = "row g-2" }))
        {
            <div class="col-12 col-md-5">
                @Html.Label("Fecha Inicio:", new { @class = "form-label fw-bold" })
                @Html.TextBox("fechaInicio", null, new { @class = "form-control", type = "date", id = "fechaInicio" })
            </div>

            <div class="col-12 col-md-5">
                @Html.Label("Fecha Fin:", new { @class = "form-label fw-bold" })
                @Html.TextBox("fechaFin", null, new { @class = "form-control", type = "date", id = "fechaFin" })
            </div>

            <div class="col-12 col-md-2 d-flex align-items-end">
                <button type="button" id="filtrarBtn" class="btn btn-primary w-100">Filtrar</button>
            </div>
        }
    </div>
</div>

<div class="container mt-4">
    <div class="table-responsive">
        <table id="tablaHistorial" class="table table-bordered table-striped display nowrap" style="width:100%">
            <thead class="table-dark">
                <tr>
                    <th>#</th>
                    <th>Usuario</th>
                    <th>Fecha</th>
                </tr>
            </thead>
            <tbody id="historialTableBody">
            </tbody>
        </table>
    </div>
</div>

<!-- Cargar Scripts de jQuery y DataTables -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.3.6/js/dataTables.buttons.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.3.6/js/buttons.html5.min.js"></script>

<script>
    $(document).ready(function () {
    var tabla = $('#tablaHistorial').DataTable({
        "paging": true,
        "searching": true,
        "ordering": true,
        "info": true, // Mostrar "Mostrando X de Y registros"
        "language": {
            "url": "//cdn.datatables.net/plug-ins/1.13.6/i18n/Spanish.json",
            "paginate": {
                "previous": "Anterior",
                "next": "Siguiente"
            },
            "info": "Mostrando _START_ a _END_ de _TOTAL_ registros",
            "search": "Buscar:",
            "lengthMenu": "Mostrar _MENU_ registros por página",
            "zeroRecords": "No se encontraron registros",
            "infoEmpty": "No hay registros disponibles",
            "infoFiltered": "(filtrado de _MAX_ registros en total)"
        },
        "columns": [
            { "data": "auditoriaId" },
            { "data": "Usuario" },
            { "data": "Fecha" }
        ],
        "dom": 'Bfrtip',
        "buttons": [
            { extend: 'excelHtml5', text: 'Exportar a Excel', title: 'Historial de Inicios de Sesión' },
            { extend: 'csvHtml5', text: 'Exportar a CSV', title: 'Historial de Inicios de Sesión' }
        ]
    });

    function cargarHistorial() {
        var fechaInicio = $("#fechaInicio").val();
        var fechaFin = $("#fechaFin").val();

        $.ajax({
            url: '@Url.Action("ObtenerDatosActividadAuditoria", "SeguridadyPermisos")',
            type: 'GET',
            data: { fechaInicio: fechaInicio, fechaFin: fechaFin },
            dataType: 'json',
            beforeSend: function () {
                tabla.clear().draw();
            },
            success: function (response) {
                if (response.registros.length > 0) {
                    tabla.rows.add(response.registros).draw();
                } else {
                    tabla.clear().draw();
                }
            },
            error: function () {
                console.log("Error al obtener los datos.");
            }
        });
    }

    // Cargar datos iniciales
    cargarHistorial();

    $("#filtrarBtn").click(function () {
        cargarHistorial();
    });
});
</script>
