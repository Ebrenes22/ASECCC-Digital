@model ASECCC_Digital.Entities.Usuario

@{
    ViewBag.Title = "Gestión de Roles";
    Layout = "~/Views/Shared/_Layout.cshtml";
    @Html.Partial("_MenuModulos");
}

<!-- Contenedor principal con espaciado -->
<section class="container mt-5">
    <div class="card shadow-lg p-4 mx-auto" style="max-width: 800px;">
        <h1 class="text-center mb-4">GESTIÓN DE ROLES</h1>

        <!-- Formulario de búsqueda -->
        @using (Html.BeginForm("RolesyPermisos", "Seguridad", FormMethod.Post, new { id = "formBuscar", onsubmit = "return false;" }))
        {
            @Html.AntiForgeryToken()

            <div class="row g-3 mb-4">
                <div class="col-12">
                    @Html.LabelFor(model => model.NombreCompleto, "Buscar por Nombre", new { @class = "form-label fw-bold" })
                    @Html.TextBox("buscarNombre", null, new { @class = "form-control", placeholder = "Ingrese el nombre del asociado", required = "required" })
                    <ul class="list-group position-absolute" id="sugerenciasNombres" style="width: 400px; z-index: 1000; display: none;"></ul>
                </div>
                <div class="col-12 d-flex justify-content-center">
                    <button type="button" class="btn btn-primary w-50" onclick="buscarAsociado()">Buscar</button>
                </div>
            </div>
        }

        <!-- Tabla de resultados -->
        <div id="resultadosBusqueda" class="table-responsive" style="display: none;">
            <h5 class="text-center">Resultados de Búsqueda</h5>
            <table class="table table-bordered mt-3">
                <thead class="table-dark">
                    <tr>
                        <th>Identificación</th>
                        <th>Nombre Completo</th>
                        <th>Rol Actual</th>
                        <th>Nuevo Rol</th>
                        <th>Acción</th>
                    </tr>
                </thead>
                <tbody id="tablaResultados">
                    <!-- Aquí se insertarán los resultados dinámicamente -->
                </tbody>
            </table>
        </div>

        <!-- Mensaje si no hay resultados -->
        <div id="sinResultados" class="text-center mt-3" style="display: none;">
            <p class="text-danger fw-bold">No se encontraron asociados con ese nombre.</p>
        </div>
    </div>
</section>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        // Función para buscar el usuario por nombre
        function buscarAsociado() {
            const buscarNombre = document.getElementById('buscarNombre').value.trim();

            if (buscarNombre) {
                fetch('/Asociados/BuscarAsociado', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify({ buscarNombre })
                })
                    .then(response => response.json())
                    .then(data => {
                        console.log("Datos recibidos:", data);

                        if (data.success) {
                            document.getElementById('resultadosBusqueda').style.display = 'block';
                            document.getElementById('sinResultados').style.display = 'none';

                            const tabla = document.getElementById('tablaResultados');
                            tabla.innerHTML = ""; // Limpiar resultados previos

                            const rolCapitalizado = data.rol.charAt(0).toUpperCase() + data.rol.slice(1);

                            const fila = `
                                <tr>
                                    <td>${data.identificacion}</td>
                                    <td>${data.nombre}</td>
                                    <td id="rol_${data.id}">${rolCapitalizado}</td>
                                    <td>
                                        <input type="radio" name="rol_${data.nombre}" value="administrador" ${data.rol === "administrador" ? "checked" : ""}> Administrador
                                        <input type="radio" name="rol_${data.nombre}" value="asociado" ${data.rol === "asociado" ? "checked" : ""}> Asociado
                                    </td>
                                    <td>
                                        <button type="button" class="btn btn-success btn-sm" onclick="cambiarRol('${data.nombre}')">Guardar</button>
                                    </td>
                                </tr>
                            `;

                            tabla.innerHTML += fila;
                        } else {
                            document.getElementById('resultadosBusqueda').style.display = 'none';
                            document.getElementById('sinResultados').style.display = 'block';
                        }
                    })
                    .catch(error => console.error('Error:', error));
            } else {
                Swal.fire({
                    icon: 'warning',
                    title: 'Campo vacío',
                    text: 'Ingrese un nombre para buscar.'
                });
            }
        }

        // Función para cambiar el rol del usuario
        function cambiarRol(nombre) {
            const seleccionado = document.querySelector(`input[name="rol_${nombre}"]:checked`);

            if (!seleccionado) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Seleccione un rol',
                    text: 'Debe seleccionar un rol antes de guardar.'
                });
                return;
            }

            Swal.fire({
                title: "¿Está seguro?",
                text: "¿Desea cambiar el rol de este usuario?",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#d33",
                confirmButtonText: "Sí, cambiar rol",
                cancelButtonText: "Cancelar"
            }).then((result) => {
                if (result.isConfirmed) {
                    fetch('/SeguridadyPermisos/RolesyPermisos', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                        },
                        body: JSON.stringify({ nombre, nuevoRol: seleccionado.value })
                    })
                        .then(response => response.json())
                        .then(data => {
                            if (data.success) {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Rol actualizado',
                                    text: data.message
                                }).then(() => {
                                    document.getElementById(`rol_${data.id}`).innerText = data.nuevoRol;
                                });
                            } else {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Error',
                                    text: data.message
                                });
                            }
                        })
                        .catch(error => console.error('Error:', error));
                }
            });
        }

        // Sugerencias dinámicas
        $(document).ready(function () {
            $("#buscarNombre").on("input", function () {
                const texto = $(this).val().trim();
                if (texto.length >= 2) {
                    $.ajax({
                        url: '/Asociados/BuscarSugerencias',
                        method: 'GET',
                        data: { texto },
                        success: function (data) {
                            let lista = $("#sugerenciasNombres").empty();
                            if (data.length > 0) {
                                data.forEach(nombre => {
                                    lista.append(`<li class="list-group-item list-group-item-action">${nombre}</li>`);
                                });
                                lista.show();
                            } else {
                                lista.hide();
                            }
                        }
                    });
                } else {
                    $("#sugerenciasNombres").hide();
                }
            });

            // Al hacer clic en una sugerencia
            $("#sugerenciasNombres").on("click", "li", function () {
                $("#buscarNombre").val($(this).text());
                $("#sugerenciasNombres").hide();
            });

            // Ocultar lista al hacer clic fuera
            $(document).on("click", function (e) {
                if (!$(e.target).closest("#buscarNombre, #sugerenciasNombres").length) {
                    $("#sugerenciasNombres").hide();
                }
            });
        });
    </script>
}
