@model ASECCC_Digital.Entities.SolicitudesPrestamo

@{
    ViewBag.Title = "SolicitudPrestamo";
    ViewData["Title"] = "Solicitud de Préstamo";
    Layout = "~/Views/Shared/_Layout.cshtml";
    @Html.Partial("_MenuModulos");


}

<div class="container-fluid mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6 col-xl-4">
            <h2 class="text-center mb-4">Formulario de Solicitud de Préstamo</h2>

            @using (Html.BeginForm("SolicitudPrestamo", "Prestamos", FormMethod.Post, new { @class = "form-horizontal", role = "form" }))
            {

                <!-- Sección Datos Personales -->
                <div class="form-section mb-4">
                    <h4>Datos Personales</h4>

                    <!-- Estado Civil -->
                    <div class="form-group mb-3">
                        <label>Estado Civil</label><br>
                        <div class="form-check form-check-inline">
                            @Html.RadioButtonFor(model => model.EstadoCivil, "Soltero", new
                             {
                                 @class = "form-check-input",
                                 id = "estadoSoltero",
                                 required = "required"
                             })
                            <label class="form-check-label" for="estadoSoltero">Soltero</label>
                        </div>
                        <div class="form-check form-check-inline">
                            @Html.RadioButtonFor(model => model.EstadoCivil, "Casado", new
                            {
                                @class = "form-check-input",
                                id = "estadoCasado"
                            })
                            <label class="form-check-label" for="estadoCasado">Casado</label>
                        </div>
                    </div>

                    <!-- Paga alquiler -->
                    <div class="form-group mb-3">
                        <label for="pagaAlquiler">¿Paga Alquiler?</label><br>
                        <div class="form-check form-check-inline">
                            @Html.RadioButtonFor(model => model.PagaAlquiler, "Si", new
                                {

                                   id = "pagaAlquilerSi",
                                   @class = "form-check-input",
                                   onclick = "mostrarCampoAlquiler()"
                                })
                            <label class="form-check-label" for="pagaAlquilerSi">Sí</label>
                        </div>
                        <div class="form-check form-check-inline">
                            @Html.RadioButtonFor(model => model.PagaAlquiler, "No",
                                new
                                     {

                                        @class = "form-check-input",
                                        id = "pagaAlquilerNo",
                                        onclick = "ocultarCampoAlquiler(); ",
                                        @checked = "checked"
                                     })
                            <label class="form-check-label" for="pagaAlquilerNo">No</label>
                        </div>
                    </div>

                    <!-- Monto de alquiler (visible solo si "Sí" se selecciona en el checkbox de "Paga Alquiler") -->
                    <div class="form-group mb-3" id="campoMontoAlquiler" style="display: none;">
                        <label for="montoAlquiler">Monto de Alquiler</label>
                        @Html.TextBoxFor(model => model.MontoAlquiler, new
                   {
                       @id = "montoAlquiler",
                       @class = "form-control",
                       placeholder = "Ingrese el monto de alquiler",
                       oninput = "formatearMonto('montoAlquiler')",
                       step = "0.01",  // Permitir dos decimales
                       max = "99999999.99",  // Límite máximo de 10,2
                       maxlength = "10"  // Limita a 10 caracteres (incluyendo punto y decimales)

                   })
                    </div>

                    <!-- Pregunta si tiene deudas -->
                    <div class="form-group mb-3">
                        <label for="tieneDeudas">¿Tiene deudas?</label><br>
                        <div class="form-check form-check-inline">
                            @Html.RadioButton("tieneDeudas", "Si", new
                                {
                                    @id = "tieneDeudasSi",
                                    @class = "form-check-input",
                                    onclick = "mostrarCamposDeudas()"
                         })
                            <label class="form-check-label" for="tieneDeudasSi">Sí</label>
                        </div>
                        <div class="form-check form-check-inline">
                            @Html.RadioButton("tieneDeudas", "No", new
                                     {
                                    @class = "form-check-input",
                                         id = "tieneDeudasNo",
                                         onclick = "ocultarCamposDeudas()",
                                         @checked = "checked"
                                     })
                            <label class="form-check-label" for="tieneDeudasNo">No</label>
                        </div>
                    </div>

                    <!--Formulario de deudas(visible solo si "Sí" se selecciona en el checkbox de "tieneDeudas") -->
                    <div class="form-group mb-3" id="camposDeudas" style="display: none;">
                        <h5>A la fecha tengo las siguientes deudas</h5>

                        <label for="nombreAcreedor">Nombre del Acreedor</label>
                        @Html.TextBoxFor(model => model.NombreAcreedor, new
                        {
                            @class = "form-control",
                            id = "nombreAcreedor",
                            placeholder = "Ingrese el nombre del acreedor"
                        })

                        <label for="totalCredito">Total del Crédito</label>
                        @Html.TextBoxFor(model => model.TotalCredito, new
                        {
                            @class = "form-control",
                            @id = "totalCredito",
                            placeholder = "Ingrese el total del crédito",
                            type = "number"
                        })

                        <label for="abonoSemanal">Abono Semanal</label>
                        @Html.TextBoxFor(model => model.AbonoSemanal, new
                        {
                            @class = "form-control",
                            id = "abonoSemanal",
                            placeholder = "Ingrese el abono semanal",
                            type = "number"
                        })

                        <label for="saldoCredito">Saldo del Crédito</label>
                        @Html.TextBoxFor(model => model.SaldoCredito, new
                        {
                            @class = "form-control",
                            id = "saldoCredito",
                            placeholder = "Ingrese el saldo del crédito",
                            type = "number"
                        })
                    </div>

                    <!-- Pregunta si es fiador -->
                    <div class="form-group mb-3">
                        <label for="esFiador">¿Es fiador de algún préstamo?</label><br>
                        <div class="form-check form-check-inline">
                            @Html.RadioButton("esFiador", "Si", new
                                     {
                                    @class = "form-check-input",
                                         id = "esFiadorSi",
                                         onclick = "mostrarCamposFiador()"
                                     })
                            <label class="form-check-label" for="esFiadorSi">Sí</label>
                        </div>
                        <div class="form-check form-check-inline">
                            @Html.RadioButton("esFiador", "No", new
                                {
                                    @class = "form-check-input",
                                    @id = "esFiadorNo",
                                    onclick = "ocultarCamposFiador()",
                                    @checked = "checked"
                                })
                            <label class="form-check-label" for="esFiadorNo">No</label>
                        </div>
                    </div>

                    <!--Formulario de fiador(visible solo si "Sí" se selecciona en el checkbox de "esFiador") -->
                    <div class="form-group mb-4" id="camposFiador" style="display: none;">
                        <h5>A la fecha soy fiador de los siguientes préstamos</h5>

                        <label for="nombreDeudor">Nombre del Deudor</label>
                        @Html.TextBoxFor(model => model.NombreDeudor, new
                        {
                       @class = "form-control",
                            placeholder = "Ingrese el nombre del deudor"
                        })

                        <label for="totalPrestamo">Total del Préstamo</label>
                        @Html.TextBoxFor(model => model.TotalPrestamo, new
                        {
                            @class = "form-control",
                            placeholder = "Ingrese el total del préstamo",
                            type = "number"
                        })

                        <label for="saldoPrestamo">Saldo del Préstamo</label>
                        @Html.TextBoxFor(model => model.SaldoPrestamo, new
                        {
                            @class = "form-control",
                            placeholder = "Ingrese el saldo del préstamo",
                            type = "number"
                        })
                    </div>
                </div>

                <!--Sección Detalles Préstamo -->
                <div class="form-section mb-4">
                    <h4>Detalles del Préstamo</h4>

                    <div class="form-group mb-3">
                        <label for="tipoPrestamo">Tipo de Préstamo</label>
                        @Html.DropDownListFor(
                            m => m.TipoPrestamo,
                            new SelectList(
                                new[] { "Personal", "Urgente", "150%" },
                                Model?.TipoPrestamo ?? "Personal"
                            ),
                            "Selecciona el tipo de préstamo",
                            new
                            {
                                @id = "tipoPrestamo",
                                @class = "form-control",
                                required = "required",
                                onchange = "ajustarPlazo()"
                            }
                        )
                    </div>

                    <div class="form-group mb-3">
                        @Html.LabelFor(model => model.MontoSolicitud, "Monto de Solicitud")
                        @Html.TextBoxFor(model => model.MontoSolicitud, new
                        {
                          @id = "montoSolicitud",
                          @class = "form-control",
                          @placeholder = "Ingrese el monto a solicitar",
                          required = "required",
                          oninput = "calcularCuota()",
                          step = "0.01",  // Permitir dos decimales
                          max = "99999999.99",  // Límite máximo de 10,2
                          maxlength = "10"  // Limita a 10 caracteres (incluyendo punto y decimales)
                        })
                    </div>


                    <div class="form-group mb-3">
                        @Html.LabelFor(model => model.PlazoMeses, "Plazo en Meses")
                        @Html.TextBoxFor(model => model.PlazoMeses, new
                        {
                           @id = "plazoMeses",
                           @class = "form-control",
                           @min = "1",
                           @max = "99",  // Establece el valor máximo en 99 para limitar a 2 dígitos
                           @placeholder = "Ingrese el plazo en meses",
                           required = "required",
                           oninput = "calcularCuota()",
                           @maxlength = "2"  // Limita la longitud a 2 caracteres
                        })
                    </div>

                    <div class="form-group mb-3">
                        @Html.LabelFor(model => model.CuotaSemanalSolicitud, "Cuota Semanal Estimada")
                        @Html.TextBoxFor(model => model.CuotaSemanalSolicitud, new
                        {
                          @id = "cuotaSemanal",
                          @class = "form-control",
                          @placeholder = "Cuota estimada",
                          @readonly = "readonly",
                        })
                    </div>

                    <input type="hidden" id="cuotaSemanalHidden" name="CuotaSemanalSolicitud" />

                    <div class="form-group mb-3">
                        @Html.LabelFor(model => model.PropositoPrestamo, "Propósito del Préstamo")
                        @Html.TextAreaFor(model => model.PropositoPrestamo, new
                        {

                           @class = "form-control",
                           @rows = "4",
                           @placeholder = "Escriba el propósito del préstamo",
                           required = "required"
                        })
                    </div>

                </div>

                <!-- Checkbox de aceptación del reglamento -->
                <form id="solicitudForm" novalidate>
                    <div class="form-check mb-4">
                        <input class="form-check-input"
                               type="checkbox"
                               id="aceptoReglamento"
                               name="AceptoReglamento" />
                        <label class="form-check-label" for="aceptoReglamento">
                            Acepto todas las disposiciones del
                            <a href="#" data-toggle="modal" data-target="#reglamentoModal">
                                reglamento de crédito
                            </a>
                            y sus anexos.
                        </label>
                        <div id="mensajeError" class="text-danger mt-2" style="display: none;">
                            Debes aceptar el reglamento para continuar.
                        </div>
                    </div>

                    <!-- Botón de Envío -->
                    <div class="form-group text-center mb-4">
                        <button type="submit" class="btn btn-primary btn-block">Enviar Solicitud</button>
                    </div>
                </form>

            }






        </div>
    </div>
</div>

<!-- Modal para mostrar el reglamento -->
<div class="modal fade" id="reglamentoModal" tabindex="-1" role="dialog" aria-labelledby="reglamentoModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="reglamentoModalLabel">Reglamento de Crédito</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <p>Ofrezco las siguiente garantía (Si es prendaria o hipotecaria):</p>
                <textarea class="form-control" id="garantia" rows="4" placeholder="Describa la garantía ofrecida"></textarea>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>



<script type="text/javascript">
    window.fechaIngresoString = '@(Session["FechaIngreso"] ?? "")';
</script>


    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/Assets/js/prestamos.js"></script>
    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.1/dist/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>

<span id="SuccessMessage" style="display: none;">@TempData["SuccessMessage"]</span>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const successMessage = document.getElementById("SuccessMessage").innerText.trim();

            if (successMessage) {
                Swal.fire({
                    icon: 'success',
                    title: '¡Éxito!',
                    text: successMessage,
                    showConfirmButton: true
                }).then(function() {
    window.location.href = '@Url.Action("ConsultaPrestamoAsociado", "Prestamos")';
});
            }
        });
    </script>
}