@{
        ViewBag.Title = "SolicitudPrestamo";
        Layout = "~/Views/Shared/_Layout.cshtml";
        @Html.Partial("_MenuModulos");
}

<div class="container-fluid mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6 col-xl-4">
            <h2 class="text-center mb-4">Formulario de Solicitud de Préstamo</h2>
            <form asp-action="EnviarSolicitud" method="POST">

                <!-- Sección Datos Personales -->
                <div class="form-section mb-4">
                    <h4>Datos Personales</h4>

                    <!-- Estado Civil -->
                    <div class="form-group mb-3">
                        <label>Estado Civil</label><br>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="EstadoCivil" id="estadoSoltero" value="Soltero" required>
                            <label class="form-check-label" for="estadoSoltero">Soltero</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="EstadoCivil" id="estadoCasado" value="Casado">
                            <label class="form-check-label" for="estadoCasado">Casado</label>
                        </div>
                    </div>

                    <!-- Paga alquiler -->
                    <div class="form-group mb-3">
                        <label for="pagaAlquiler">¿Paga Alquiler?</label><br>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="PagaAlquiler" id="pagaAlquilerSi" value="Si" onclick="mostrarCampoAlquiler()">
                            <label class="form-check-label" for="pagaAlquilerSi">Sí</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="PagaAlquiler" id="pagaAlquilerNo" value="No" onclick="ocultarCampoAlquiler()" checked>
                            <label class="form-check-label" for="pagaAlquilerNo">No</label>
                        </div>
                    </div>

                    <!-- Monto de alquiler (visible solo si "Sí" se selecciona en el checkbox de "Paga Alquiler") -->
                    <div class="form-group mb-3" id="campoMontoAlquiler" style="display: none;">
                        <label for="montoAlquiler">Monto de Alquiler</label>
                        <input type="number" class="form-control" id="montoAlquiler" name="MontoAlquiler" placeholder="Ingrese el monto de alquiler">
                    </div>

                    <!-- A la fecha tengo las siguientes deudas -->
                    <div class="form-group mb-3">
                        <h5>A la fecha tengo las siguientes deudas</h5>

                        <label for="nombreAcreedor">Nombre del Acreedor</label>
                        <input type="text" class="form-control" id="nombreAcreedor" name="NombreAcreedor" placeholder="Ingrese el nombre del acreedor">

                        <label for="totalCredito">Total del Crédito</label>
                        <input type="number" class="form-control" id="totalCredito" name="TotalCredito" placeholder="Ingrese el total del crédito">

                        <label for="abonoSemanal">Abono Semanal</label>
                        <input type="number" class="form-control" id="abonoSemanal" name="AbonoSemanal" placeholder="Ingrese el abono semanal">

                        <label for="saldoCredito">Saldo del Crédito</label>
                        <input type="number" class="form-control" id="saldoCredito" name="SaldoCredito" placeholder="Ingrese el saldo del crédito">
                    </div>

                    <!-- A la fecha soy fiador de los siguientes préstamos -->
                    <div class="form-group mb-4">
                        <h5>A la fecha soy fiador de los siguientes préstamos</h5>

                        <label for="nombreDeudor">Nombre del Deudor</label>
                        <input type="text" class="form-control" id="nombreDeudor" name="NombreDeudor" placeholder="Ingrese el nombre del deudor">

                        <label for="totalPrestamo">Total del Préstamo</label>
                        <input type="number" class="form-control" id="totalPrestamo" name="TotalPrestamo" placeholder="Ingrese el total del préstamo">

                        <label for="saldoPrestamo">Saldo del Préstamo</label>
                        <input type="number" class="form-control" id="saldoPrestamo" name="SaldoPrestamo" placeholder="Ingrese el saldo del préstamo">
                    </div>
                </div>

                <!-- Sección Detalles Préstamo -->
                <div class="form-section mb-4">
                    <h4>Detalles del Préstamo</h4>

                    <!-- Tipo de préstamo -->
                    <div class="form-group mb-3">
                        <label for="tipoPrestamo">Tipo de Préstamo</label>
                        <select class="form-control" id="tipoPrestamo" name="TipoPrestamo" required>
                            <option value="Personal">Personal</option>
                            <option value="Urgente">Urgente</option>
                            <option value="150%">150%</option>
                        </select>
                    </div>

                    <!-- Monto de solicitud -->
                    <div class="form-group mb-3">
                        <label for="montoSolicitud">Monto de Solicitud</label>
                        <input type="number" class="form-control" id="montoSolicitud" name="MontoSolicitud" placeholder="Ingrese el monto solicitado" required oninput="calcularCuota()">
                    </div>

                    <!-- Plazo en meses -->
                    <div class="form-group mb-3">
                        <label for="plazoMeses">Plazo en Meses</label>
                        <input type="number" class="form-control" id="plazoMeses" name="PlazoMeses" min="1" placeholder="Ingrese el plazo en meses" required oninput="calcularCuota()">
                    </div>

                    <!-- Propósito del préstamo -->
                    <div class="form-group mb-3">
                        <label for="propositoPrestamo">Propósito del Préstamo</label>
                        <textarea class="form-control" id="propositoPrestamo" name="PropositoPrestamo" rows="4" placeholder="Escriba el propósito del préstamo" required></textarea>
                    </div>

                    <!-- Cuota mensual estimada -->
                    <div class="form-group mb-3">
                        <label for="cuota">Cuota Mensual Estimada</label>
                        <input type="text" class="form-control" id="cuota" name="Cuota" placeholder="Cuota estimada" readonly>
                    </div>
                </div>

                <!-- Checkbox de aceptación del reglamento -->
                <div class="form-check mb-4">
                    <input class="form-check-input" type="checkbox" id="aceptoReglamento" name="AceptoReglamento" required>
                    <label class="form-check-label" for="aceptoReglamento">
                        Acepto todas las disposiciones del <a href="#" data-toggle="modal" data-target="#reglamentoModal">reglamento de crédito</a> y sus anexos.
                    </label>
                </div>

                <!-- Botón de Envío -->
                <div class="form-group text-center mb-4">
                    <button type="submit" class="btn btn-primary btn-block">Enviar Solicitud</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal para mostrar el reglamento -->
<div class="modal fade" id="reglamentoModal" tabindex="-1" role="dialog" aria-labelledby="reglamentoModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="reglamentoModalLabel">Reglamento de Crédito</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <p>Ofrezco las siguiente garantía (Si es prendaria o hipotecaria):</p>
                <textarea class="form-control" id="garantia" rows="4" placeholder="Describa la garantía ofrecida"></textarea>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<!-- Script para calcular la cuota -->
<script>
    function calcularCuota() {
        var monto = parseFloat(document.getElementById("montoSolicitud").value);
        var plazo = parseFloat(document.getElementById("plazoMeses").value);

        if (!isNaN(monto) && !isNaN(plazo) && plazo > 0) {
            var cuota = (monto / (plazo * 4)) + (monto * 0.12); // Ajuste según tu fórmula de cálculo
            document.getElementById("cuota").value = cuota.toFixed(2);
        } else {
            document.getElementById("cuota").value = '';
        }
    }

    function mostrarCampoAlquiler() {
        document.getElementById("campoMontoAlquiler").style.display = 'block';
    }

    function ocultarCampoAlquiler() {
        document.getElementById("campoMontoAlquiler").style.display = 'none';
    }
</script>

<!-- jQuery, Popper.js, y Bootstrap JS -->
<script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.1/dist/umd/popper.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
