@model ASECCC_Digital.Entities.SolicitudesPrestamo
@{
    ViewBag.Title = "SolicitudPrestamo";
    ViewData["Title"] = "Solicitud de Préstamo";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@Html.Partial("_MenuModulos")
<div class="container-fluid mt-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-8 col-xl-6">
            <h2 class="text-center mb-4">FORMULARIO DE SOLICITUD DE PRESTAMO</h2>
            @using (Html.BeginForm("SolicitudPrestamo", "Prestamos", FormMethod.Post, new { @class = "form-horizontal", role = "form", novalidate = "novalidate" }))
            {
                @Html.AntiForgeryToken()
                <!-- Sección Datos Personales -->
                <div class="form-section mb-4">
                    <h4>Datos Personales</h4>
                    <!-- Estado Civil -->
                    <div class="form-group mb-3">
                        <label>Estado Civil</label><br>
                        <div class="form-check form-check-inline">
                            @Html.RadioButtonFor(model => model.EstadoCivil, "Soltero", new
                            {
                                @class = "form-check-input",
                                id = "estadoSoltero",
                                required = "required"
                            })
                            <label class="form-check-label" for="estadoSoltero">Soltero</label>
                        </div>
                        <div class="form-check form-check-inline">
                            @Html.RadioButtonFor(model => model.EstadoCivil, "Casado", new
                            {
                                @class = "form-check-input",
                                id = "estadoCasado"
                            })
                            <label class="form-check-label" for="estadoCasado">Casado</label>
                        </div>
                    </div>
                    <!-- Paga alquiler -->
                    <div class="form-group mb-3">
                        <label for="pagaAlquiler">¿Paga Alquiler?</label><br>
                        <div class="form-check form-check-inline">
                            @Html.RadioButtonFor(model => model.PagaAlquiler, "Si", new
                            {
                                id = "pagaAlquilerSi",
                                @class = "form-check-input",
                                onclick = "mostrarCampoAlquiler()"
                            })
                            <label class="form-check-label" for="pagaAlquilerSi">Sí</label>
                        </div>
                        <div class="form-check form-check-inline">
                            @Html.RadioButtonFor(model => model.PagaAlquiler, "No", new
                            {
                                @class = "form-check-input",
                                id = "pagaAlquilerNo",
                                onclick = "ocultarCampoAlquiler()",
                                @checked = "checked"
                            })
                            <label class="form-check-label" for="pagaAlquilerNo">No</label>
                        </div>
                    </div>
                    <!-- Monto de alquiler (visible solo si "Sí" se selecciona) -->
                    <div class="form-group mb-3" id="campoMontoAlquiler" style="display: none;">
                        <label for="montoAlquiler">Monto de Alquiler</label>
                        @Html.TextBoxFor(model => model.MontoAlquiler, new
                        {
                            @id = "montoAlquiler",
                            @class = "form-control",
                            placeholder = "Ingrese el monto de alquiler",
                            oninput = "formatearMonto('montoAlquiler')",
                            step = "0.01",
                            max = "99999999.99",
                            maxlength = "10"
                        })
                    </div>
                    <!-- Pregunta si tiene deudas -->
                    <div class="form-group mb-3">
                        <label for="tieneDeudas">¿Tiene deudas?</label><br>
                        <div class="form-check form-check-inline">
                            @Html.RadioButton("tieneDeudas", "Si", new
                            {
                                @id = "tieneDeudasSi",
                                @class = "form-check-input",
                                onclick = "mostrarCamposDeudas()"
                            })
                            <label class="form-check-label" for="tieneDeudasSi">Sí</label>
                        </div>
                        <div class="form-check form-check-inline">
                            @Html.RadioButton("tieneDeudas", "No", new
                            {
                                @class = "form-check-input",
                                id = "tieneDeudasNo",
                                onclick = "ocultarCamposDeudas()",
                                @checked = "checked"
                            })
                            <label class="form-check-label" for="tieneDeudasNo">No</label>
                        </div>
                    </div>
                    <!-- Formulario de deudas (visible solo si "Sí" se selecciona) -->
                    <div class="form-group mb-3" id="camposDeudas" style="display: none;">
                        <h5>A la fecha tengo las siguientes deudas</h5>
                        <label for="nombreAcreedor">Nombre del Acreedor</label>
                        @Html.TextBoxFor(model => model.NombreAcreedor, new
                        {
                            @class = "form-control",
                            id = "nombreAcreedor",
                            placeholder = "Ingrese el nombre del acreedor"
                        })
                        <label for="totalCredito">Total del Crédito</label>
                        @Html.TextBoxFor(model => model.TotalCredito, new
                        {
                            @class = "form-control",
                            @id = "totalCredito",
                            placeholder = "Ingrese el total del crédito",
                            type = "number"
                        })
                        <label for="abonoSemanal">Abono Semanal</label>
                        @Html.TextBoxFor(model => model.AbonoSemanal, new
                        {
                            @class = "form-control",
                            id = "abonoSemanal",
                            placeholder = "Ingrese el abono semanal",
                            type = "number"
                        })
                        <label for="saldoCredito">Saldo del Crédito</label>
                        @Html.TextBoxFor(model => model.SaldoCredito, new
                        {
                            @class = "form-control",
                            id = "saldoCredito",
                            placeholder = "Ingrese el saldo del crédito",
                            type = "number"
                        })
                    </div>
                    <!-- Pregunta si es fiador -->
                    <div class="form-group mb-3">
                        <label for="esFiador">¿Es fiador de algún préstamo?</label><br>
                        <div class="form-check form-check-inline">
                            @Html.RadioButton("esFiador", "Si", new
                            {
                                @class = "form-check-input",
                                id = "esFiadorSi",
                                onclick = "mostrarCamposFiador()"
                            })
                            <label class="form-check-label" for="esFiadorSi">Sí</label>
                        </div>
                        <div class="form-check form-check-inline">
                            @Html.RadioButton("esFiador", "No", new
                            {
                                @class = "form-check-input",
                                @id = "esFiadorNo",
                                onclick = "ocultarCamposFiador()",
                                @checked = "checked"
                            })
                            <label class="form-check-label" for="esFiadorNo">No</label>
                        </div>
                    </div>
                    <!-- Formulario de fiador (visible solo si "Sí" se selecciona) -->
                    <div class="form-group mb-4" id="camposFiador" style="display: none;">
                        <h5>A la fecha soy fiador de los siguientes préstamos</h5>
                        <label for="nombreDeudor">Nombre del Deudor</label>
                        @Html.TextBoxFor(model => model.NombreDeudor, new
                        {
                            @class = "form-control",
                            placeholder = "Ingrese el nombre del deudor"
                        })
                        <label for="totalPrestamo">Total del Préstamo</label>
                        @Html.TextBoxFor(model => model.TotalPrestamo, new
                        {
                            @class = "form-control",
                            placeholder = "Ingrese el total del préstamo",
                            type = "number"
                        })
                        <label for="saldoPrestamo">Saldo del Préstamo</label>
                        @Html.TextBoxFor(model => model.SaldoPrestamo, new
                        {
                            @class = "form-control",
                            placeholder = "Ingrese el saldo del préstamo",
                            type = "number"
                        })
                    </div>
                </div>
                <!-- Sección Detalles Préstamo -->
                <div class="form-section mb-4">
                    <h4>Detalles del Préstamo</h4>
                    <div class="form-group mb-3">
                        <label for="tipoPrestamo">Tipo de Préstamo</label>
                        @Html.DropDownListFor(
                            m => m.TipoPrestamo,
                            new SelectList(new[] { "Personal", "Urgente", "150%" }, Model?.TipoPrestamo ?? "Personal"),
                            "Selecciona el tipo de préstamo",
                            new
                                 {
                                @id = "tipoPrestamo",
                                @class = "form-control",
                                required = "required",
                                onchange = "ajustarPlazo()"
                            }
                        )
                    </div>
                    <div class="form-group mb-3">
                        @Html.LabelFor(model => model.MontoSolicitud, "Monto de Solicitud")
                        @Html.TextBoxFor(model => model.MontoSolicitud, new
                   {
                       @id = "montoSolicitud",
                       @class = "form-control",
                       placeholder = "Ingrese el monto a solicitar",
                       type = "number", 
                       required = "required",
                       step = "0.01",
                       max = "99999999.99",
                       maxlength = "10"
                   })
                    </div>
                    <div class="form-group mb-3">
                        @Html.LabelFor(model => model.PlazoMeses, "Plazo en Meses")
                        @Html.TextBoxFor(model => model.PlazoMeses, new
                   {
                       @id = "plazoMeses",
                       @class = "form-control",
                       type = "number", 
                       min = "1",
                       max = "99",
                       placeholder = "Ingrese el plazo en meses",
                       required = "required",
                       maxlength = "2"
                   })
                    </div>
                    <div class="form-group mb-3">
                        @Html.LabelFor(model => model.CuotaSemanalSolicitud, "Cuota Semanal Estimada")
                        @Html.TextBoxFor(model => model.CuotaSemanalSolicitud, new
                        {
                            @id = "cuotaSemanal",
                            @class = "form-control",
                            placeholder = "Cuota estimada",
                            @readonly = "readonly"
                        })
                    </div>
                    <div class="form-group mb-3">
                        @Html.LabelFor(model => model.PropositoPrestamo, "Propósito del Préstamo")
                        @Html.TextAreaFor(model => model.PropositoPrestamo, new
                        {
                            @class = "form-control",
                            rows = "4",
                            placeholder = "Escriba el propósito del préstamo",
                            required = "required"
                        })
                    </div>
                </div>
                <!-- Checkbox de aceptación del reglamento -->
                <div class="form-check mb-4">
                    <input class="form-check-input" type="checkbox" id="aceptoReglamento" name="AceptoReglamento" required />
                    <label class="form-check-label" for="aceptoReglamento">
                        Acepto todas las disposiciones del
                        <a href="#" data-bs-toggle="modal" data-bs-target="#reglamentoModal">reglamento de crédito</a> y sus anexos.
                    </label>
                    <div id="mensajeError" class="text-danger mt-2" style="display: none;">
                        Debes aceptar el reglamento para continuar.
                    </div>
                </div>
                <!-- Modal del reglamento -->
                <div class="modal fade" id="reglamentoModal" tabindex="-1" aria-labelledby="reglamentoModalLabel" aria-hidden="true">
                    <div class="modal-dialog modal-lg modal-dialog-scrollable">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="reglamentoModalLabel">Reglamento de Crédito</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                            </div>
                            <div class="modal-body">
                                <h6><strong>ARTÍCULO 9.</strong></h6>
                                <p>Independientemente de los plazos, importes, garantías y fines, todos los préstamos se formalizarán mediante un pagaré u otro documento que constituya título ejecutivo a favor de la Asociación. El valor de los timbres y del cheque a emitir, serán rebajados del préstamo. Se deberá presentar la cédula de identidad para verificación de datos y se otorgarán a plazos no mayores de 60 meses y por sumas que no excedan la siguiente escala:</p>
                                <ul>
                                    <li>a) Para vivienda hasta 60 meses, ocho veces lo ahorrado.</li>
                                    <li>b) Para educación y capacitación hasta 48 meses, siete veces lo ahorrado.</li>
                                    <li>c) Para otros fines hasta 36 meses, seis veces lo ahorrado.</li>
                                </ul>
                                <h6><strong>ARTÍCULO 10.</strong></h6>
                                <p>Los préstamos solicitados para los fines mencionados en los incisos a), b), c), d), e), f) y del Artículo 3, sólo podrán otorgarse con garantía hipotecaria en primer grado, excepto que su importe sea menor que el ahorro libre del solicitante, o cuando su fin sea la adquisición de una bicicleta como medio de transporte personal. Estos préstamos se regirán además por las siguientes normas:</p>
                                <!-- Aquí podrías continuar con las normas si están disponibles -->
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Botón de Envío -->
                <div class="form-group text-center mb-4">
                    <button type="submit" class="btn btn-primary btn-block">Enviar Solicitud</button>
                </div>
            }
        </div>
    </div>
</div>
<!-- Modal para mostrar el reglamento -->
<div class="modal fade" id="reglamentoModal" tabindex="-1" role="dialog" aria-labelledby="reglamentoModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="reglamentoModalLabel">Reglamento de Crédito</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <p>Ofrezco la siguiente garantía (Si es prendaria o hipotecaria):</p>
                <textarea class="form-control" id="garantia" rows="4" placeholder="Describa la garantía ofrecida"></textarea>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="~/Assets/js/solicitudPrestamo.js"></script>
<script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.1/dist/umd/popper.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
<span id="SuccessMessage" style="display: none;">@TempData["SuccessMessage"]</span>
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const successMessage = document.getElementById("SuccessMessage").innerText.trim();
            if (successMessage) {
                Swal.fire({
                    icon: 'success',
                    title: '¡Éxito!',
                    text: successMessage,
                    showConfirmButton: true
                }).then(function() {
    window.location.href = '@Url.Action("ConsultaPrestamoAsociado", "Prestamos")';
});
            }
        });
        document.addEventListener("DOMContentLoaded", function () {
            const montoInput = document.getElementById("montoSolicitud");
            const plazoInput = document.getElementById("plazoMeses");
            const cuotaSemanalInput = document.getElementById("cuotaSemanal");
            const form = document.querySelector("form");
            const checkboxReglamento = document.getElementById("aceptoReglamento");
            const mensajeError = document.getElementById("mensajeError");

            // Ocultar el mensaje de error si el checkbox cambia a marcado
            checkboxReglamento.addEventListener("change", function () {
                if (this.checked) {
                    mensajeError.style.display = "none";
                }
            });

            function calcularCuotaSemanal() {
                const monto = parseFloat(montoInput.value) || 0;
                const plazo = parseInt(plazoInput.value) || 0;
                if (monto > 0 && plazo > 0) {
                    const interes = monto * 0.12;
                    const montoTotal = monto + interes;
                    const semanas = plazo * 4.34;
                    const cuotaValor = (montoTotal / semanas).toFixed(2);
                    cuotaSemanalInput.value = cuotaValor;
                } else {
                    cuotaSemanalInput.value = "";
                }
            }
            montoInput.addEventListener("input", calcularCuotaSemanal);
            plazoInput.addEventListener("input", calcularCuotaSemanal);

            form.addEventListener("submit", function (event) {
                // Validar que el checkbox esté marcado
                if (!checkboxReglamento.checked) {
                    event.preventDefault(); // Prevenir el envío del formulario
                    mensajeError.style.display = "block"; // Mostrar mensaje de error
                    checkboxReglamento.focus(); // Enfocar el checkbox
                    return false;
                } else {
                    mensajeError.style.display = "none"; // Ocultar mensaje de error si estaba visible
                }

                calcularCuotaSemanal();
                // Removemos el readonly para asegurar que el valor se envíe
                cuotaSemanalInput.removeAttribute("readonly");
            });
        });
    </script>
}