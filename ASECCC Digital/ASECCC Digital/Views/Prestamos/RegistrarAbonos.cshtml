@model ASECCC_Digital.ViewModels.PrestamoUsuarioTransaccionesViewModel

@{
    ViewBag.Title = "Registrar Abonos";
    Layout = "~/Views/Shared/_Layout.cshtml";
    @Html.Partial("_MenuModulos");
}

<div class="container my-5">
    <h1 class="text-center mb-4">Registro de Abonos a Préstamos</h1>

    <!-- Formulario de búsqueda de asociado -->
    <form method="GET" action="@Url.Action("RegistrarAbonos", "Prestamos")">
        <div class="mb-3">
            <label for="buscarAsociado" class="form-label">Buscar Asociado:</label>
            <input type="text" id="buscarAsociado" name="NombreCompleto" class="form-control" placeholder="Ingrese el nombre del asociado" list="listaAsociados" autocomplete="off" required
                   oninput="this.value = this.value.replace(/[^a-zA-ZáéíóúÁÉÍÓÚñÑ ]/g, '')">
            <datalist id="listaAsociados">
                <!-- Opciones dinámicas de la base de datos -->
            </datalist>
        </div>
        <button type="submit" class="btn btn-primary mt-2">Buscar</button>
    </form>

    <!-- Mostrar sugerencias si no hay coincidencias exactas -->
    @if (TempData["Sugerencias"] != null)
    {
        <div class="alert alert-warning mt-2">
            <strong>¿Quiso decir?</strong>
            <ul>
                @foreach (var nombre in (List<string>)TempData["Sugerencias"])
                {
                    <li>
                        <a href="@Url.Action("RegistrarAbonos", "Prestamos", new { NombreCompleto = nombre })">@nombre</a>
                    </li>
                }
            </ul>
        </div>
    }

    <!-- Mostrar mensaje si no hay préstamos -->
    <div class="mt-4">
        @if (!string.IsNullOrEmpty(Model.NombreCompleto))
        {
            <h4>Préstamos Activos de <strong>@Model.NombreCompleto</strong></h4>
        }

        <table class="table table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>Tipo Prestamo</th>
                    <th>Fecha Inicio</th>
                    <th>Saldo Inicial</th>
                    <th>Saldo Actual</th>
                    <th>Cuota</th>
                    <th>Acción</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var prestamo in Model.ListaPrestamos)
                {
                    <tr>
                        <td>@prestamo.TipoPrestamo</td>
                        <td>@prestamo.FechaSolicitud.ToString("yyyy-MM-dd")</td>
                        <td>₡@(prestamo.MontoAprobado.GetValueOrDefault().ToString("N2"))</td>
                        <td>₡@(prestamo.SaldoPendiente.GetValueOrDefault().ToString("N2"))</td>
                        <td>₡@(prestamo.CuotaSemanal.GetValueOrDefault().ToString("N2"))</td>

                        <td>
                            <button type="button" class="btn btn-primary" onclick="abrirModal(@prestamo.PrestamoId, @prestamo.SaldoPendiente)">Abonar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal para ingresar el monto a abonar -->
<div class="modal fade" id="modalAbono" tabindex="-1" aria-labelledby="modalAbonoLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalAbonoLabel">Registrar Abono</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="formAbonoModal" method="post" action="@Url.Action("RegistrarAbonos", "Prestamos")">
                    <input type="hidden" id="prestamoId" name="PrestamoId">

                    <div class="mb-3">
                        <label for="saldoActual" class="form-label">Saldo Actual</label>
                        <input type="text" id="saldoActual" class="form-control" readonly>
                    </div>
                    <div class="mb-3">
                        <label for="montoAbono" class="form-label">Monto a Abonar</label>
                        <input type="number" name="MontoAbonado" id="montoAbono" class="form-control" placeholder="Digite el monto" min="0" step="1000" required>
                    </div>
                    <button type="submit" class="btn btn-success">Registrar</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- JavaScript -->
<script>
    function abrirModal(prestamoId, saldoActual) {
        document.getElementById("prestamoId").value = prestamoId;
        document.getElementById("saldoActual").value = saldoActual;
        new bootstrap.Modal(document.getElementById('modalAbono')).show();
    }

    // Sugerencias de búsqueda en vivo
    document.getElementById("buscarAsociado").addEventListener("keyup", function () {
        let term = this.value;

        if (term.length < 2) {
            return; // No buscar si hay menos de 2 caracteres
        }

        fetch('@Url.Action("BuscarAsociados", "Prestamos")?term=' + encodeURIComponent(term))
            .then(response => response.json())
            .then(data => {
                let lista = document.getElementById("listaAsociados");
                lista.innerHTML = ""; // Limpiar opciones previas

                data.forEach(nombre => {
                    let option = document.createElement("option");
                    option.value = nombre;
                    lista.appendChild(option);
                });
            })
            .catch(error => console.error("Error en la búsqueda:", error));
    });
</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

@if (TempData["Mensaje"] != null)
{
    <script>
        Swal.fire({
            icon: 'success',
            title: 'Éxito',
            text: '@TempData["Mensaje"]'
        });
    </script>
}

@if (TempData["MensajeError"] != null)
{
    <script>
        Swal.fire({
            icon: 'error',
            title: 'Error',
            text: '@TempData["MensajeError"]'
        });
    </script>
}

<script>
    function formatearColones(valor) {
        return new Intl.NumberFormat('es-CR', {
            style: 'currency',
            currency: 'CRC',
            minimumFractionDigits: 2
        }).format(valor);
    }

    function actualizarSaldoActual(saldo) {
        let saldoFormateado = formatearColones(saldo);
        document.getElementById("saldoActual").value = saldoFormateado;
    }

</script>

