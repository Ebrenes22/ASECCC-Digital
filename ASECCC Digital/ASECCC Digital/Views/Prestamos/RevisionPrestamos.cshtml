@{
    ViewBag.Title = "RevisionPrestamos";
    Layout = "~/Views/Shared/_Layout.cshtml";
    @Html.Partial("_MenuModulos");
    @Html.Partial("_SolicitudDetalles");
}

<div class="container my-4">
    <h2 class="text-center mb-4">Solicitudes de Préstamos</h2>
    <div class="row">
        <!-- Columna: Pendiente -->
        <div class="col-md-3" id="pendiente-column">
            <h5 class="text-center text-primary">Pendiente</h5>
            <div class="bg-light p-3 rounded shadow-sm" style="min-height: 300px;" id="pendiente">
                @foreach (var solicitud in Model.Solicitudes.Pendientes)
                {
                    <div class="card mb-3 border-primary solicitud-card"
                         data-id="@solicitud.SolicitudPrestamoId"
                         data-usuario="@solicitud.UsuarioId"
                         data-monto="@solicitud.MontoSolicitud"
                         data-estado="Pendiente"
                         data-nombreacreedor="@solicitud.NombreAcreedor"
                         data-totalcredito="@solicitud.TotalCredito"
                         data-abonosemanal="@solicitud.AbonoSemanal"
                         data-saldocredito="@solicitud.SaldoCredito"
                         data-nombredeudor="@solicitud.NombreDeudor"
                         data-totalprestamo="@solicitud.TotalPrestamo"
                         data-saldoprestamo="@solicitud.SaldoPrestamo"
                         data-tipoprestamo="@solicitud.TipoPrestamo"
                         data-plazomeses="@solicitud.PlazoMeses"
                         data-cuotasemanal="@solicitud.CuotaSemanalSolicitud"
                         data-propositoprestamo="@solicitud.PropositoPrestamo"
                         data-bs-toggle="modal" data-bs-target="#solicitudDetallesModal">
                        <div class="card-body">
                            <h6 class="card-title">Solicitud #@solicitud.SolicitudPrestamoId</h6>
                            <p class="card-text">
                                <strong>Usuario ID:</strong> @solicitud.UsuarioId <br>
                                <strong>Monto:</strong> @solicitud.MontoSolicitud
                            </p>
                        </div>
                    </div>

                }
            </div>
        </div>

        <!-- Columna: En Revisión -->
        <div class="col-md-3" id="revision-column">
            <h5 class="text-center text-warning">En Revisión</h5>
            <div class="bg-light p-3 rounded shadow-sm" style="min-height: 300px;" id="revision">
                @foreach (var solicitud in Model.Solicitudes.EnRevision)
                {
                    <div class="card mb-3 border-primary solicitud-card"
                         data-id="@solicitud.SolicitudPrestamoId"
                         data-usuario="@solicitud.UsuarioId"
                         data-monto="@solicitud.MontoSolicitud"
                         data-estado="Pendiente"
                         data-nombreacreedor="@solicitud.NombreAcreedor"
                         data-totalcredito="@solicitud.TotalCredito"
                         data-abonosemanal="@solicitud.AbonoSemanal"
                         data-saldocredito="@solicitud.SaldoCredito"
                         data-nombredeudor="@solicitud.NombreDeudor"
                         data-totalprestamo="@solicitud.TotalPrestamo"
                         data-saldoprestamo="@solicitud.SaldoPrestamo"
                         data-tipoprestamo="@solicitud.TipoPrestamo"
                         data-plazomeses="@solicitud.PlazoMeses"
                         data-cuotasemanal="@solicitud.CuotaSemanalSolicitud"
                         data-propositoprestamo="@solicitud.PropositoPrestamo"
                         data-bs-toggle="modal" data-bs-target="#solicitudDetallesModal">
                        <div class="card-body">
                            <h6 class="card-title">Solicitud #@solicitud.SolicitudPrestamoId</h6>
                            <p class="card-text">
                                <strong>Usuario ID:</strong> @solicitud.UsuarioId <br>
                                <strong>Monto:</strong> @solicitud.MontoSolicitud
                            </p>
                        </div>
                    </div>

                }
            </div>
        </div>

        <!-- Columna: Aprobado -->
        <div class="col-md-3" id="aprobado-column">
            <h5 class="text-center text-success">Aprobado</h5>
            <div class="bg-light p-3 rounded shadow-sm" style="min-height: 300px;" id="aprobado">
                @foreach (var solicitud in Model.Solicitudes.Aprobadas)
                {
                    <div class="card mb-3 border-primary solicitud-card"
                         data-id="@solicitud.SolicitudPrestamoId"
                         data-usuario="@solicitud.UsuarioId"
                         data-monto="@solicitud.MontoSolicitud"
                         data-estado="Pendiente"
                         data-nombreacreedor="@solicitud.NombreAcreedor"
                         data-totalcredito="@solicitud.TotalCredito"
                         data-abonosemanal="@solicitud.AbonoSemanal"
                         data-saldocredito="@solicitud.SaldoCredito"
                         data-nombredeudor="@solicitud.NombreDeudor"
                         data-totalprestamo="@solicitud.TotalPrestamo"
                         data-saldoprestamo="@solicitud.SaldoPrestamo"
                         data-tipoprestamo="@solicitud.TipoPrestamo"
                         data-plazomeses="@solicitud.PlazoMeses"
                         data-cuotasemanal="@solicitud.CuotaSemanalSolicitud"
                         data-propositoprestamo="@solicitud.PropositoPrestamo"
                         data-bs-toggle="modal" data-bs-target="#solicitudDetallesModal">
                        <div class="card-body">
                            <h6 class="card-title">Solicitud #@solicitud.SolicitudPrestamoId</h6>
                            <p class="card-text">
                                <strong>Usuario ID:</strong> @solicitud.UsuarioId <br>
                                <strong>Monto:</strong> @solicitud.MontoSolicitud
                            </p>
                        </div>
                    </div>

                }
            </div>
        </div>

        <!-- Columna: Rechazado -->
        <div class="col-md-3" id="rechazado-column">
            <h5 class="text-center text-danger">Rechazado</h5>
            <div class="bg-light p-3 rounded shadow-sm" style="min-height: 300px;" id="rechazado">
                @foreach (var solicitud in Model.Solicitudes.Rechazadas)
                {
                    <div class="card mb-3 border-primary solicitud-card"
                         data-id="@solicitud.SolicitudPrestamoId"
                         data-usuario="@solicitud.UsuarioId"
                         data-monto="@solicitud.MontoSolicitud"
                         data-estado="Pendiente"
                         data-nombreacreedor="@solicitud.NombreAcreedor"
                         data-totalcredito="@solicitud.TotalCredito"
                         data-abonosemanal="@solicitud.AbonoSemanal"
                         data-saldocredito="@solicitud.SaldoCredito"
                         data-nombredeudor="@solicitud.NombreDeudor"
                         data-totalprestamo="@solicitud.TotalPrestamo"
                         data-saldoprestamo="@solicitud.SaldoPrestamo"
                         data-tipoprestamo="@solicitud.TipoPrestamo"
                         data-plazomeses="@solicitud.PlazoMeses"
                         data-cuotasemanal="@solicitud.CuotaSemanalSolicitud"
                         data-propositoprestamo="@solicitud.PropositoPrestamo"
                         data-fecha="@solicitud.FechaSolicitud"
                         data-bs-toggle="modal" data-bs-target="#solicitudDetallesModal">
                        <div class="card-body">
                            <h6 class="card-title">Solicitud #@solicitud.SolicitudPrestamoId</h6>
                            <p class="card-text">
                                <strong>Usuario ID:</strong> @solicitud.UsuarioId <br>
                                <strong>Monto:</strong> @solicitud.MontoSolicitud
                                <strong>Fecha:</strong> @solicitud.FechaSolicitud
                            </p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>


<!-- Vincular el JS de Bootstrap y jQuery -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>

<!-- Script para manejar el modal y mover las tarjetas -->
<script>

    $(document).ready(function () {
        $('.solicitud-card').click(function () {
            var tarjeta = $(this);

            // Obtener los datos de la tarjeta
            var usuarioId = tarjeta.data('usuario');
            var estadoCivil = tarjeta.data('estadoCivil') || 'No disponible';
            var pagaAlquiler = tarjeta.data('pagaAlquiler') || 'No especificado';
            var montoAlquiler = tarjeta.data('montoAlquiler') || 'N/A';
            var nombreAcreedor = tarjeta.data('nombreacreedor') || 'N/A';
            var totalCredito = tarjeta.data('totalcredito') || 'N/A';
            var abonoSemanal = tarjeta.data('abonosemanal') || 'N/A';
            var saldoCredito = tarjeta.data('saldocredito') || 'N/A';
            var nombreDeudor = tarjeta.data('nombredeudor') || 'N/A';
            var totalPrestamo = tarjeta.data('totalprestamo') || 'N/A';
            var saldoPrestamo = tarjeta.data('saldoprestamo') || 'N/A';
            var tipoPrestamo = tarjeta.data('tipoprestamo') || 'No especificado';
            var plazoMeses = tarjeta.data('plazomeses') || 'N/A';
            var cuotaSemanal = tarjeta.data('cuotasemanal') || 'N/A';
            var propositoPrestamo = tarjeta.data('propositoprestamo') || 'Sin especificar';
            var estadoSolicitud = tarjeta.data('estado') || 'Pendiente';
            var montoSolicitud = tarjeta.data('montoSolicitud') || 'N/A';

            // Llenar el modal con los datos
            $('#usuarioId').text(usuarioId);
            $('#estadoCivil').text(estadoCivil);
            $('#pagaAlquiler').text(pagaAlquiler);
            $('#montoAlquiler').text(montoAlquiler);
            $('#nombreAcreedor').text(nombreAcreedor);
            $('#totalCredito').text(totalCredito);
            $('#abonoSemanal').text(abonoSemanal);
            $('#saldoCredito').text(saldoCredito);
            $('#nombreDeudor').text(nombreDeudor);
            $('#totalPrestamo').text(totalPrestamo);
            $('#saldoPrestamo').text(saldoPrestamo);
            $('#tipoPrestamo').text(tipoPrestamo);
            $('#plazoMeses').val(plazoMeses);
            $('#cuotaSemanalSolicitud').val(cuotaSemanal);
            $('#propositoPrestamo').text(propositoPrestamo);
            $('#estado').val(estadoSolicitud);
            $('#montoSolicitud').val(montoSolicitud); // Mostrar el monto de la solicitud

            // Mostrar el modal
            $('#solicitudDetallesModal').modal('show');
        });
    });


    // Guardar el nuevo estado y mover la tarjeta
    $('#guardarEstado').click(function () {
        var nuevoEstado = $('#estado').val();  // Obtener el nuevo estado del campo
        var columnaDestino;

        // Determinar la columna destino según el estado
        switch (nuevoEstado) {
            case 'Pendiente':
                columnaDestino = '#pendiente';
                break;
            case 'En Revisión':
                columnaDestino = '#revision';
                break;
            case 'Aprobado':
                columnaDestino = '#aprobado';
                break;
            case 'Rechazado':
                columnaDestino = '#rechazado';
                break;
        }

        // Mover la tarjeta a la columna correspondiente
        $(columnaDestino).append(tarjeta);  // Mover la tarjeta

        // También actualizar el estado en el atributo data-estado de la tarjeta
        tarjeta.data('estado', nuevoEstado);

        // Cerrar el modal
        $('#solicitudDetallesModal').modal('hide');
    });
</script>

<style>
    .card {
        cursor: pointer;
        transition: transform 0.2s ease-in-out;
    }

        .card:hover {
            transform: scale(1.05);
        }
</style>
