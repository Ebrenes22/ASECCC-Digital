
@model ASECCC_Digital.Entities.SolicitudPrestamoViewModel

@{
    ViewBag.Title = "RevisionPrestamos";
    Layout = "~/Views/Shared/_Layout.cshtml";
    @Html.Partial("_MenuModulos");
    @Html.Partial("_SolicitudDetalles")


}


<div class="container my-4">
    <h2 class="text-center mb-4">Solicitudes de Préstamos</h2>
    <div class="row">
        <!-- Columna: Pendiente -->
        <div class="col-md-3" id="pendiente-column">
            <h5 class="text-center text-primary">Pendiente</h5>
            <div class="bg-light p-3 rounded shadow-sm" style="min-height: 300px;" id="pendiente">
                @foreach (var solicitud in Model.Pendientes)
                {
                    <div class="card mb-3 border-primary solicitud-card" data-id="@solicitud.SolicitudPrestamoId" data-usuario="@solicitud.UsuarioId" data-monto="@solicitud.MontoSolicitud" data-estado="Pendiente" data-bs-toggle="modal" data-bs-target="#solicitudModal">
                        <div class="card-body">
                            <h6 class="card-title">Solicitud #@solicitud.SolicitudPrestamoId</h6>
                            <p class="card-text">
                                <strong>Usuario ID:</strong> @solicitud.UsuarioId <br>
                                <strong>Monto:</strong> @solicitud.MontoSolicitud
                            </p>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Columna: En Revisión -->
        <div class="col-md-3" id="revision-column">
            <h5 class="text-center text-warning">En Revisión</h5>
            <div class="bg-light p-3 rounded shadow-sm" style="min-height: 300px;" id="revision">
                @foreach (var solicitud in Model.EnRevision)
                {
                    <div class="card mb-3 border-warning solicitud-card" data-id="@solicitud.SolicitudPrestamoId" data-usuario="@solicitud.UsuarioId" data-monto="@solicitud.MontoSolicitud" data-estado="En Revisión" data-bs-toggle="modal" data-bs-target="#solicitudModal">
                        <div class="card-body">
                            <h6 class="card-title">Solicitud #@solicitud.SolicitudPrestamoId</h6>
                            <p class="card-text">
                                <strong>Usuario ID:</strong> @solicitud.UsuarioId <br>
                                <strong>Monto:</strong> @solicitud.MontoSolicitud
                            </p>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Columna: Aprobado -->
        <div class="col-md-3" id="aprobado-column">
            <h5 class="text-center text-success">Aprobado</h5>
            <div class="bg-light p-3 rounded shadow-sm" style="min-height: 300px;" id="aprobado">
                @foreach (var solicitud in Model.Aprobadas)
                {
                    <div class="card mb-3 border-success solicitud-card" data-id="@solicitud.SolicitudPrestamoId" data-usuario="@solicitud.UsuarioId" data-monto="@solicitud.MontoSolicitud" data-estado="Aprobado" data-bs-toggle="modal" data-bs-target="#solicitudModal">
                        <div class="card-body">
                            <h6 class="card-title">Solicitud #@solicitud.SolicitudPrestamoId</h6>
                            <p class="card-text">
                                <strong>Usuario ID:</strong> @solicitud.UsuarioId <br>
                                <strong>Monto:</strong> @solicitud.MontoSolicitud
                            </p>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Columna: Rechazado -->
        <div class="col-md-3" id="rechazado-column">
            <h5 class="text-center text-danger">Rechazado</h5>
            <div class="bg-light p-3 rounded shadow-sm" style="min-height: 300px;" id="rechazado">
                @foreach (var solicitud in Model.Rechazadas)
                {
                    <div class="card mb-3 border-danger solicitud-card" data-id="@solicitud.SolicitudPrestamoId" data-usuario="@solicitud.UsuarioId" data-monto="@solicitud.MontoSolicitud" data-estado="Rechazado" data-bs-toggle="modal" data-bs-target="#solicitudModal">
                        <div class="card-body">
                            <h6 class="card-title">Solicitud #@solicitud.SolicitudPrestamoId</h6>
                            <p class="card-text">
                                <strong>Usuario ID:</strong> @solicitud.UsuarioId <br>
                                <strong>Monto:</strong> @solicitud.MontoSolicitud
                            </p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Modal: Solicitud Detalles -->
<div class="modal fade" id="solicitudModal" tabindex="-1" aria-labelledby="solicitudModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="solicitudModalLabel">Detalles de la Solicitud</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p><strong>ID de Solicitud:</strong> <span id="solicitud-id"></span></p>
                <p><strong>Usuario ID:</strong> <span id="usuario-id"></span></p>
                <p><strong>Monto:</strong> <span id="monto-solicitud"></span></p>
                <!-- Aquí puedes agregar más campos para mostrar detalles adicionales -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>


<!-- Vincular el JS de Bootstrap y jQuery -->
<script src="~/Assets/js/revisionPrestamos.js"></script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>


<!-- Script para manejar el modal y mover las tarjetas -->
<script>
    var tarjeta; // Variable para almacenar la tarjeta seleccionada

    // Mostrar datos en el modal al hacer clic en la tarjeta
    $('.solicitud-card').click(function () {
        tarjeta = $(this); // Guardar la tarjeta clickeada
        var id = tarjeta.data('id');
        var usuario = tarjeta.data('usuario');
        var monto = tarjeta.data('monto');
        var estado = tarjeta.data('estado');

        // Rellenar los campos del modal con los datos de la tarjeta
        $('#usuario').val(usuario);
        $('#monto').val(monto);
        $('#estado').val(estado);

        // Abrir el modal
        $('#solicitudModal').modal('show');
    });

    // Guardar el nuevo estado y mover la tarjeta
    $('#guardarEstado').click(function () {
        var nuevoEstado = $('#estado').val();
        var columnaDestino;

        // Determinar la columna a la que mover la tarjeta
        switch (nuevoEstado) {
            case 'Pendiente':
                columnaDestino = '#pendiente';
                break;
            case 'En Revisión':
                columnaDestino = '#revision';
                break;
            case 'Aprobado':
                columnaDestino = '#aprobado';
                break;
            case 'Rechazado':
                columnaDestino = '#rechazado';
                break;
        }

        // Mover la tarjeta a la nueva columna
        $(columnaDestino).append(tarjeta);

        // Cerrar el modal
        $('#solicitudModal').modal('hide');
    });
</script>

<style>
    .card {
        cursor: pointer;
        transition: transform 0.2s ease-in-out;
    }

        .card:hover {
            transform: scale(1.05);
        }
</style>