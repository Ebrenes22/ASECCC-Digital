@{
    ViewBag.Title = "ConsultaPrestamoAsociado";
    Layout = "~/Views/Shared/_Layout.cshtml";
    @Html.Partial("_MenuModulos");
}

<div class="container my-5">
    <h1 class="text-center mb-4">Consulta de Prestamos</h1>

    <!-- Filtros de búsqueda -->
    <div class="row mb-4">
        <div class="col-12 mb-3">
            <label for="tipoPrestamo" class="form-label">Tipo de Prestamo</label>
            <select id="tipoPrestamo" class="form-select">
                <option value="">Seleccione un tipo de prestamo</option>
                <option value="Personal">Personal</option>
                <option value="Urgente">Urgente</option>
                <option value="150%">150%</option>
            </select>
        </div>
        <div class="col-12 mb-3">
            <label for="estadoPrestamo" class="form-label">Estado del Prestamo</label>
            <select id="estadoPrestamo" class="form-select">
                <option value="">Seleccione el estado</option>
                <option value="activo">Activo</option>
                <option value="cancelado">Cancelado</option>
            </select>
        </div>
        <div class="col-12 d-flex justify-content-center">
            <button class="btn btn-primary w-100" onclick="consultarPrestamos()">
                <i class="bi bi-search"></i> Consultar
            </button>
        </div>
    </div>

    <!-- Resultados en forma de cards -->
    <div class="row" id="contenedorPrestamos"></div>
</div>

<script>
    function consultarPrestamos() {
        fetch('@Url.Action("ObtenerPrestamosAsociado", "Prestamos")')
            .then(response => response.json())
            .then(data => {
                console.log("Préstamos obtenidos:", data);

                const tipoPrestamo = document.getElementById('tipoPrestamo').value;
                const estadoPrestamo = document.getElementById('estadoPrestamo').value;

                const prestamosFiltrados = data.filter(prestamo => {
                    const tipoCoincide = tipoPrestamo ? prestamo.TipoPrestamo.toLowerCase() === tipoPrestamo.toLowerCase() : true;
                    const estadoCoincide = estadoPrestamo ? prestamo.EstadoPrestamo.toLowerCase() === estadoPrestamo.toLowerCase() : true;
                    return tipoCoincide && estadoCoincide;
                });

                renderizarPrestamos(prestamosFiltrados);
            })
            .catch(error => console.error('Error al obtener préstamos:', error));
    }

    function renderizarPrestamos(prestamos) {
        const contenedor = document.getElementById('contenedorPrestamos');
        contenedor.innerHTML = '';

        if (prestamos.length === 0) {
            contenedor.innerHTML = '<p class="text-center">No se encontraron préstamos.</p>';
            return;
        }

        prestamos.forEach(prestamo => {
            const card = document.createElement('div');
            card.className = 'col-md-6 col-lg-4 mb-4';
            card.innerHTML = `
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">${prestamo.TipoPrestamo || "Desconocido"}</h5>
                        <p class="card-text">
                            <strong>Fecha de Solicitud:</strong> ${prestamo.FechaSolicitud || "No disponible"}<br>
                            <strong>Monto Aprobado:</strong> ${formatearMonto(prestamo.MontoAprobado)}<br>
                            <strong>Plazo:</strong> ${prestamo.Plazo || "No especificado"}<br>
                            <strong>Cuota Semanal:</strong> ${formatearMonto(prestamo.CuotaSemanal)}<br>
                            <strong>Saldo Pendiente:</strong> ${formatearMonto(prestamo.SaldoPendiente)}<br>
                            <strong>Estado:</strong> ${prestamo.EstadoPrestamo || "No especificado"}
                        </p>
                    </div>
                </div>
            `;
            contenedor.appendChild(card);
        });
    }

    function formatearMonto(monto) {
        return monto ? monto.toLocaleString('es-CR', { style: 'currency', currency: 'CRC' }) : '₡0.00';
    }
</script>
