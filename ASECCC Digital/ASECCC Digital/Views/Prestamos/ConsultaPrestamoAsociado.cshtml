@{
    ViewBag.Title = "ConsultaPrestamoAsociado";
    Layout = "~/Views/Shared/_Layout.cshtml";
    @Html.Partial("_MenuModulos");
}

<div class="container my-5">
    <h1 class="text-center mb-4">CONSULTA DE PRESTAMOS</h1>

    <!-- Filtros de busqueda -->
    <div class="row mb-4 p-3 border rounded bg-light">
        <div class="col-12 mb-3">
            <label for="tipoPrestamo" class="form-label">Tipo de Prestamo</label>
            <select id="tipoPrestamo" class="form-select">
                <option value="">Seleccione un tipo de prestamo</option>
                <option value="Personal">Personal</option>
                <option value="Urgente">Urgente</option>
                <option value="150%">150%</option>
            </select>
        </div>
        <div class="col-12 mb-3">
            <label for="estadoPrestamo" class="form-label">Estado del Prestamo</label>
            <select id="estadoPrestamo" class="form-select">
                <option value="">Seleccione el estado</option>
                <option value="activo">Activo</option>
                <option value="cancelado">Cancelado</option>
            </select>
        </div>
        <div class="col-12 d-flex justify-content-center">
            <button class="btn btn-primary w-100" onclick="consultarPrestamos()">
                <i class="bi bi-search"></i> Consultar
            </button>
        </div>
    </div>

    <!-- Spinner de carga -->
    <div id="spinner" class="text-center d-none">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
        <p class="mt-2">Buscando prestamos...</p>
    </div>

    <!-- Mensajes -->
    <div id="mensajesContainer"></div>

    <!-- Resultados -->
    <div class="row" id="contenedorPrestamos"></div>
</div>

<!-- Modal Historial de Pagos -->
<div class="modal fade" id="modalHistorialPagos" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Historial de Pagos</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Monto Abonado</th>
                        </tr>
                    </thead>
                    <tbody id="historialPagos">
                        <tr><td colspan="2" class="text-center">Cargando...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
    function consultarPrestamos() {
        const tipoPrestamo = document.getElementById('tipoPrestamo').value;
        const estadoPrestamo = document.getElementById('estadoPrestamo').value;

        mostrarSpinner(true);
        limpiarMensajes();

        if (tipoPrestamo && !['Personal', 'Urgente', '150%'].includes(tipoPrestamo)) {
            mostrarMensaje("Tipo de prestamo no valido", "danger");
            mostrarSpinner(false);
            return;
        }

        if (estadoPrestamo && !['activo', 'cancelado'].includes(estadoPrestamo)) {
            mostrarMensaje("Estado de prestamo no valido", "danger");
            mostrarSpinner(false);
            return;
        }

        fetch('@Url.Action("ObtenerPrestamosAsociado", "Prestamos")', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
            },
            body: JSON.stringify({ tipoPrestamo, estadoPrestamo })
        })
        .then(r => r.ok ? r.json() : Promise.reject(`Error del servidor: ${r.status}`))
        .then(data => {
            if (!Array.isArray(data)) throw new Error("Formato de datos invalido.");
            data.length ? renderizarPrestamos(data) : mostrarMensaje("No se encontraron prestamos.", "info");
        })
        .catch(err => {
            console.error(err);
            mostrarMensaje(`Ocurrio un error: ${err}`, "danger");
        })
        .finally(() => mostrarSpinner(false));
    }

    function mostrarSpinner(mostrar) {
        document.getElementById('spinner').classList.toggle('d-none', !mostrar);
    }

    function mostrarMensaje(mensaje, tipo) {
        const alertClass = {
            danger: 'alert-danger',
            info: 'alert-info',
            success: 'alert-success',
            warning: 'alert-warning'
        }[tipo] || 'alert-warning';

        document.getElementById('mensajesContainer').innerHTML = `
            <div class="alert ${alertClass} alert-dismissible fade show" role="alert">
                ${mensaje}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        `;
    }

    function limpiarMensajes() {
        document.getElementById('mensajesContainer').innerHTML = '';
    }

    function renderizarPrestamos(prestamos) {
        const contenedor = document.getElementById('contenedorPrestamos');
        contenedor.innerHTML = prestamos.map(prestamo => {
            // Capitalizar la primera letra del tipo de préstamo
            const tipoPrestamoCapitalizado = capitalizeFirstLetter(prestamo.TipoPrestamo || "Desconocido");

            return `
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-body">
                            <h5 class="card-title">${tipoPrestamoCapitalizado}</h5>
                            <p class="card-text">
                                <strong>Fecha de Solicitud:</strong> ${prestamo.FechaSolicitud || "N/D"}<br>
                                <strong>Monto Aprobado:</strong> ${formatearMonto(prestamo.MontoAprobado)}<br>
                                <strong>Plazo:</strong> ${prestamo.Plazo || "N/D"}<br>
                                <strong>Cuota Semanal:</strong> ${formatearMonto(prestamo.CuotaSemanal)}<br>
                                <strong>Saldo Pendiente:</strong> ${formatearMonto(prestamo.SaldoPendiente)}<br>
                                <strong>Estado:</strong> ${prestamo.EstadoPrestamo || "N/D"}
                            </p>
                            <button class="btn btn-sm btn-outline-primary" onclick="verHistorialPagos(${prestamo.prestamoId})">
                                <i class="bi bi-clock-history"></i> Ver Historial de Pagos
                            </button>
                        </div>
                    </div>
                </div>
            `;
        }).join('');
    }

    // Función para capitalizar la primera letra de una cadena
    function capitalizeFirstLetter(text) {
        if (!text) return text; // Si el texto es nulo o vacío, devolverlo como está
        return text.charAt(0).toUpperCase() + text.slice(1);
    }


    function formatearMonto(monto) {
        const num = parseFloat(monto);
        return isNaN(num) ? '₡0.00' : num.toLocaleString('es-CR', {
            style: 'currency',
            currency: 'CRC',
            minimumFractionDigits: 2
        });
    }

    function verHistorialPagos(prestamoId) {
        const url = '@Url.Action("ObtenerHistorialTransacciones", "Prestamos")?prestamoId=' + encodeURIComponent(prestamoId);

        fetch(url)
            .then(r => r.ok ? r.json() : Promise.reject(`Error del servidor: ${r.status}`))
            .then(data => {
                const tbody = document.getElementById('historialPagos');
                tbody.innerHTML = '';

                if (data.success && Array.isArray(data.transacciones) && data.transacciones.length) {
                    tbody.innerHTML = data.transacciones.map(t => `
                        <tr>
                            <td>${t.fechaPago || "Fecha invalida"}</td>
                            <td>${formatearMonto(t.montoAbonado)}</td>
                        </tr>
                    `).join('');
                } else {
                    tbody.innerHTML = `<tr><td colspan="2" class="text-center">${data.message || "No se encontraron pagos."}</td></tr>`;
                }

                new bootstrap.Modal(document.getElementById('modalHistorialPagos')).show();
            })
            .catch(err => {
                console.error(err);
                document.getElementById('historialPagos').innerHTML = `
                    <tr><td colspan="2" class="text-center text-danger">Error al cargar el historial de pagos.</td></tr>
                `;
                new bootstrap.Modal(document.getElementById('modalHistorialPagos')).show();
            });
    }
</script>