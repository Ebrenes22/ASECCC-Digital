@{
        ViewBag.Title = "ConsultaPrestamosAsociado";
        Layout = "~/Views/Shared/_Layout.cshtml";
        @Html.Partial("_MenuModulos");
}

<div class="container my-5">
    <h1 class="text-center mb-4">Consulta de Préstamos</h1>

    <!-- Filtros de búsqueda -->
    <div class="row mb-4">
        <!-- Filtro tipo de préstamo -->
        <div class="col-12 mb-3">
            <label for="tipoPrestamo" class="form-label">Tipo de Préstamo</label>
            <select id="tipoPrestamo" class="form-select">
                <option value="">Seleccione un tipo de préstamo</option>
                <option value="Personal">Personal</option>
                <option value="Urgente">Urgente</option>
                <option value="150%">150%</option>
            </select>
        </div>
        <!-- Filtro estado del préstamo -->
        <div class="col-12 mb-3">
            <label for="estadoPrestamo" class="form-label">Estado del Préstamo</label>
            <select id="estadoPrestamo" class="form-select">
                <option value="">Seleccione el estado</option>
                <option value="Activo">Activo</option>
                <option value="Cancelado">Cancelado</option>
            </select>
        </div>
        <!-- Botón de consulta -->
        <div class="col-12 d-flex justify-content-center">
            <button class="btn btn-primary w-100" onclick="consultarPrestamos()">
                <i class="bi bi-search"></i> Consultar
            </button>
        </div>
    </div>

    <!-- Resultados en forma de cards -->
    <div class="row" id="contenedorPrestamos">
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
    // Datos de ejemplo para los préstamos
    const prestamos = [
        { id: 1, tipo: 'Personal', monto: 50000, fechaSolicitud: '2024-10-01', estado: 'Activo', saldo: 20000, cuotaSemanal: 1000, plazo: '12 meses' },
        { id: 2, tipo: 'Urgente', monto: 200000, fechaSolicitud: '2023-05-15', estado: 'Cancelado', saldo: 50000, cuotaSemanal: 4000, plazo: '24 meses' },
        { id: 3, tipo: '150%', monto: 15000, fechaSolicitud: '2024-11-10', estado: 'Activo', saldo: 8000, cuotaSemanal: 500, plazo: '6 meses' },
        { id: 4, tipo: 'Personal', monto: 250000, fechaSolicitud: '2022-02-20', estado: 'Cancelado', saldo: 150000, cuotaSemanal: 6000, plazo: '36 meses' }
    ];

    // Función para consultar los préstamos con filtros
    function consultarPrestamos() {
        const tipoPrestamo = document.getElementById('tipoPrestamo').value;
        const estadoPrestamo = document.getElementById('estadoPrestamo').value;

        // Filtrar los préstamos según los filtros
        const prestamosFiltrados = prestamos.filter(prestamo => {
            const tipoCoincide = tipoPrestamo ? prestamo.tipo === tipoPrestamo : true;
            const estadoCoincide = estadoPrestamo ? prestamo.estado === estadoPrestamo : true;
            return tipoCoincide && estadoCoincide;
        });

        // Limpiar contenedor
        const contenedorPrestamos = document.getElementById('contenedorPrestamos');
        contenedorPrestamos.innerHTML = '';

        // Crear cards para cada préstamo
        prestamosFiltrados.forEach(prestamo => {
            const card = document.createElement('div');
            card.className = 'col-md-6 col-lg-4 mb-4';
            card.innerHTML = `
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">${prestamo.tipo}</h5>
                        <p class="card-text">
                            <strong>Fecha de Solicitud:</strong> ${prestamo.fechaSolicitud}<br>
                            <strong>Monto Solicitado:</strong> ${formatearMonto(prestamo.monto)}<br>
                            <strong>Plazo:</strong> ${prestamo.plazo}<br>
                            <strong>Cuota Semanal:</strong> ${formatearMonto(prestamo.cuotaSemanal)}<br>
                            <strong>Saldo:</strong> ${formatearMonto(prestamo.saldo)}<br>
                            <strong>Estado:</strong> ${prestamo.estado}
                        </p>
                        <button class="btn btn-info w-100" data-bs-toggle="modal" data-bs-target="#modalHistorialPagos" onclick="cargarHistorialPagos(${prestamo.id})">Ver Historial</button>
                    </div>
                </div>
            `;
            contenedorPrestamos.appendChild(card);
        });
    }

    // Función para formatear los montos
    function formatearMonto(monto) {
        return monto.toLocaleString('es-CR', { style: 'currency', currency: 'CRC' });
    }

    // Función para mostrar historial de pagos
    function cargarHistorialPagos(id) {
        const historial = obtenerHistorialPagos(id); // Simula obtener datos dinámicos
        const lista = document.getElementById('listaHistorialPagos');
        lista.innerHTML = '';

        if (historial && historial.length > 0) {
            historial.forEach(pago => {
                const item = document.createElement('li');
                item.className = 'list-group-item';
                item.textContent = `Fecha: ${pago.fecha}, Monto: ${formatearMonto(pago.monto)}`;
                lista.appendChild(item);
            });
        } else {
            lista.innerHTML = '<li class="list-group-item">No se encontraron pagos.</li>';
        }
    }

    function obtenerHistorialPagos(id) {
        // Datos simulados para el historial de pagos
        const datos = {
            1: [
                { fecha: '2024-01-01', monto: 10000 },
                { fecha: '2024-02-01', monto: 15000 }
            ],
            2: [
                { fecha: '2024-03-01', monto: 20000 }
            ]
        };
        return datos[id] || [];
    }
</script>

<!-- Modal para Historial de Pagos -->
<div class="modal fade" id="modalHistorialPagos" tabindex="-1" aria-labelledby="modalHistorialPagosLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalHistorialPagosLabel">Historial de Pagos</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <!-- Aquí se cargará el historial -->
                <ul id="listaHistorialPagos" class="list-group">
                    <li class="list-group-item">Cargando historial...</li>
                </ul>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>
