
@{
    ViewBag.Title = "Prestamos";
    Layout = "~/Views/Shared/_Layout.cshtml";
    @Html.Partial("_MenuModulos");
}

<body class="container my-5 d-flex justify-content-center align-items-center" style="height: 100vh;">
    <!-- Contenedor para las tarjetas -->
    <div class="row justify-content-center">
        <div class="col-sm-12 col-md-6 col-lg-4 mb-2">
            <div class="card" style="text-align: center;">
                <div class="card-body p-1">
                    <strong>Gestión de Prestamos:</strong>  El módulo de gestión de préstamos permite el manejo de solicitudes de préstamos pendientes de los asociados para evaluar cada solicitud, dar seguimiento a las solicitudes de préstamo en proceso de los asociados para asegurar que la revisión y la aprobación sean ágiles. A su vez, permite el registro de una nueva solicitud por medio de un formulario para garantizar que la información esté organizada.
                </div>
            </div>
        </div>
    </div>
</body>

