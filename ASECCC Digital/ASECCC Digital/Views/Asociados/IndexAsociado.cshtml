                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href=@Url.Action("LiquidarAsociado", "Asociados")>Dar de Baja Asociado</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href=@Url.Action("BuscarAsociado", "Asociados")>>Buscar Asociado</a>
                    </li>
                </ul>
            </div>

</section>

