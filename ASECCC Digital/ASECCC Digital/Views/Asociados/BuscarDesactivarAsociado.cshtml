@model ASECCC_Digital.Entities.Usuario

@{
    ViewBag.Title = "Buscar y Desactivar Asociado";
    Layout = "~/Views/Shared/_Layout.cshtml";
    @Html.Partial("_MenuModulos");
}

<section class="container mt-5">
    <div class="card shadow-lg p-4 mx-auto" style="max-width: 800px;">
        <h1 class="text-center mb-4">DESACTIVAR ASOCIADO</h1>

        <!-- Formulario de búsqueda -->
        @using (Html.BeginForm("BuscarAsociado", "Asociados", FormMethod.Post, new { @class = "form-horizontal", role = "form", id = "formBuscar", onsubmit = "return false;" }))
        {
            @Html.AntiForgeryToken()

            <div class="row g-3 mb-4">
                <div class="col-12 position-relative">
                    @Html.LabelFor(model => model.NombreCompleto, "Buscar por Nombre", new { @class = "form-label fw-bold" })
                    @Html.TextBox("buscarNombre", null, new { @class = "form-control", placeholder = "Ingrese el nombre del asociado", autocomplete = "off", required = "required" })
                    <ul class="list-group position-absolute w-100" id="sugerenciasNombres" style="z-index: 1000; display: none;"></ul>
                </div>
                <div class="col-12 d-flex justify-content-center">
                    <button type="button" class="btn btn-primary w-50" onclick="buscarAsociado()">Buscar</button>
                </div>
            </div>
        }

        <!-- Tabla de resultados -->
        <div id="resultadosBusqueda" class="table-responsive" style="display: none;">
            <h5 class="text-center">Resultados de Búsqueda</h5>
            <table class="table table-bordered mt-3">
                <thead class="table-dark">
                    <tr>
                        <th>Nombre Completo</th>
                        <th>Identificación</th>
                        <th>Correo Electrónico</th>
                        <th>Teléfono</th>
                        <th>Estado</th>
                        <th>Acción</th>
                    </tr>
                </thead>
                <tbody id="tablaResultados">
                    <!-- Resultados dinámicos -->
                </tbody>
            </table>
        </div>

        <!-- Mensaje sin resultados -->
        <div id="sinResultados" class="text-center mt-3" style="display: none;">
            <p class="text-danger fw-bold">No se encontraron asociados que coincidan con los criterios de búsqueda.</p>
        </div>
    </div>
</section>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        function buscarAsociado() {
            const buscarNombre = document.getElementById('buscarNombre').value.trim();

            if (buscarNombre) {
                fetch('/Asociados/BuscarAsociado', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ buscarNombre })
                })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            document.getElementById('resultadosBusqueda').style.display = 'block';
                            document.getElementById('sinResultados').style.display = 'none';

                            const tabla = document.getElementById('tablaResultados');

                            
                            const estadoCapitalizado = data.estado.trim().charAt(0).toUpperCase() + data.estado.trim().slice(1);

                            // Determinar si el usuario está inactivo
                            const esInactivo = data.estado.toLowerCase() === "inactivo";

                            // Crear el botón con condiciones
                            const boton = esInactivo
                                ? `<button type="button" class="btn btn-secondary btn-sm" disabled>Inactivo</button>`
                                : `<button type="button" class="btn btn-danger btn-sm" onclick="desactivarAsociado(${data.id}, '${data.estado}')">Desactivar</button>`;

                            const fila = `
                                <tr>
                                    <td>${data.nombre}</td>
                                    <td>${data.identificacion}</td>
                                    <td>${data.correo}</td>
                                    <td>${data.telefono}</td>
                                    <td>${estadoCapitalizado}</td>
                                    <td>${boton}</td>
                                </tr>`;

                            tabla.innerHTML = fila;

                        } else {
                            document.getElementById('resultadosBusqueda').style.display = 'none';
                            document.getElementById('sinResultados').style.display = 'block';
                        }
                    })
                    .catch(error => console.error('Error:', error));
            } else {
                alert('Por favor, ingrese un nombre para buscar.');
            }
        }

        function desactivarAsociado(usuarioId) {
            if (!usuarioId || usuarioId <= 0) {
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'ID de usuario inválido.'
                });
                return;
            }

            Swal.fire({
                title: "¿Estás segura?",
                text: "Esta acción desactivará al asociado.",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#d33",
                cancelButtonColor: "#3085d6",
                confirmButtonText: "Sí, desactivar",
                cancelButtonText: "Cancelar"
            }).then((result) => {
                if (result.isConfirmed) {
                    fetch('/Asociados/BuscarDesactivarAsociado', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ usuarioId })
                    })
                        .then(response => response.json())
                        .then(data => {
                            if (data.success) {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Asociado Desactivado',
                                    text: 'El asociado ha sido desactivado correctamente.',
                                    confirmButtonColor: '#3085d6'
                                }).then(() => buscarAsociado());
                            } else {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Error',
                                    text: data.message
                                });
                            }
                        })
                        .catch(error => {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: 'Ocurrió un problema al desactivar el usuario.'
                            });
                            console.error('Error en desactivarAsociado:', error);
                        });
                }
            });
        }

        // Sugerencias dinámicas
        $(document).ready(function () {
            $("#buscarNombre").on("input", function () {
                const texto = $(this).val().trim();
                if (texto.length >= 2) {
                    $.ajax({
                        url: '/Asociados/BuscarSugerencias',
                        method: 'GET',
                        data: { texto },
                        success: function (data) {
                            let lista = $("#sugerenciasNombres").empty();
                            if (data.length > 0) {
                                data.forEach(nombre => {
                                    lista.append(`<li class="list-group-item list-group-item-action">${nombre}</li>`);
                                });
                                lista.show();
                            } else {
                                lista.hide();
                            }
                        }
                    });
                } else {
                    $("#sugerenciasNombres").hide();
                }
            });

            // Al hacer clic en una sugerencia
            $("#sugerenciasNombres").on("click", "li", function () {
                $("#buscarNombre").val($(this).text());
                $("#sugerenciasNombres").hide();
            });

            // Ocultar lista al hacer clic fuera
            $(document).on("click", function (e) {
                if (!$(e.target).closest("#buscarNombre, #sugerenciasNombres").length) {
                    $("#sugerenciasNombres").hide();
                }
            });
        });
    </script>
}
