@model ASECCC_Digital.Entities.Usuario

@{
    ViewBag.Title = "Buscar y Desactivar Asociado";
    Layout = "~/Views/Shared/_Layout.cshtml";
    @Html.Partial("_MenuModulos");
}

<h1 class="text-center mb-4">Buscar y Desactivar Asociado</h1>
<section class="container mt-4 d-flex justify-content-center align-items-start" style="padding-top: 20px;">
    <div class="w-100" style="max-width: 800px;">

        <!-- Formulario de búsqueda -->
        @using (Html.BeginForm("BuscarAsociado", "Asociados", FormMethod.Post, new { @class = "form-horizontal", role = "form", id = "formBuscar", onsubmit = "return false;" }))
        {
            @Html.AntiForgeryToken()

            <div class="row g-3 mb-4">
                <div class="col-md-8">
                    @Html.LabelFor(model => model.NombreCompleto, "Buscar por Nombre", new { @class = "form-label" })
                    @Html.TextBox("buscarNombre", null, new { @class = "form-control", placeholder = "Ingrese el nombre del asociado", required = "required" })
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <button type="button" class="btn btn-primary w-100" onclick="buscarAsociado()">Buscar</button>
                </div>
            </div>
        }

        <!-- Tabla de resultados -->
        <div id="resultadosBusqueda" style="display: none;">
            <h5>Resultados de Búsqueda</h5>
            <table class="table table-striped mt-3">
                <thead>
                    <tr>
                        <th>Nombre Completo</th>
                        <th>Identificación</th>
                        <th>Correo Electrónico</th>
                        <th>Teléfono</th>
                        <th>Acción</th>
                    </tr>
                </thead>
                <tbody id="tablaResultados">
                    <!-- Resultados dinámicos aquí -->
                </tbody>
            </table>
        </div>

        <!-- Mensaje sin resultados -->
        <div id="sinResultados" style="display: none;">
            <p class="text-danger">No se encontraron asociados que coincidan con los criterios de búsqueda.</p>
        </div>

    </div>
</section>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        // Función para buscar un asociado por nombre o identificación
        function buscarAsociado() {
            const buscarNombre = document.getElementById('buscarNombre').value.trim();

            if (buscarNombre) {
                fetch('/Asociados/BuscarAsociado', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify({ buscarNombre })
                })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            document.getElementById('resultadosBusqueda').style.display = 'block';
                            document.getElementById('sinResultados').style.display = 'none';

                            const tabla = document.getElementById('tablaResultados');
                            tabla.innerHTML = ""; // Limpiar resultados previos

                            const fila = `
                        <tr>
                            <td>${data.nombre}</td>
                            <td>${data.identificacion}</td>
                            <td>${data.correo}</td>
                            <td>${data.telefono}</td>
                            <td>
                                <button type="button" class="btn btn-danger btn-sm" onclick="desactivarAsociado(${data.id})">Desactivar</button>
                            </td>
                        </tr>
                    `;
                            tabla.innerHTML += fila;
                        } else {
                            document.getElementById('resultadosBusqueda').style.display = 'none';
                            document.getElementById('sinResultados').style.display = 'block';
                        }
                    })
                    .catch(error => console.error('Error:', error));
            } else {
                alert('Por favor, ingrese un nombre para buscar.');
            }
        }


        function desactivarAsociado(usuarioId) {
            console.log("Intentando desactivar usuario con ID:", usuarioId); // Depuración en consola

            if (!usuarioId || usuarioId <= 0) {
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'ID de usuario inválido.'
                });
                return;
            }

            
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            Swal.fire({
                title: "¿Estás segura?",
                text: "Esta acción desactivará al asociado.",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#d33",
                cancelButtonColor: "#3085d6",
                confirmButtonText: "Sí, desactivar",
                cancelButtonText: "Cancelar"
            }).then((result) => {
                if (result.isConfirmed) {
                    fetch('/Asociados/BuscarDesactivarAsociado', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-CSRF-Token': token 
                        },
                        body: JSON.stringify({ usuarioId })
                    })
                        .then(response => response.json())
                        .then(data => {
                            console.log("Respuesta recibida:", data); // Depuración en consola

                            if (data.success) {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Asociado Desactivado',
                                    text: 'El asociado ha sido desactivado correctamente.',
                                    confirmButtonColor: '#3085d6',
                                    confirmButtonText: 'OK'
                                }).then(() => {
                                    buscarAsociado(); // Refrescar la búsqueda
                                });
                            } else {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Error',
                                    text: data.message
                                });
                            }
                        })
                        .catch(error => {
                            console.error('Error en desactivarAsociado:', error);
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: 'Ocurrió un problema al desactivar el usuario.'
                            });
                        });
                }
            });
        }



    </script>
}