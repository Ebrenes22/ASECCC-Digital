
@{
    ViewBag.Title = "Actualizar";
    Layout = "~/Views/Shared/_Layout.cshtml";
    @Html.Partial("_MenuModulos");
}


<h2>Actualizar</h2>

<section class="container mt-4" style="margin-left: 60px;">
    <h3 class="mb-4">Editar Asociado</h3>

    <!-- Sección para buscar por nombre -->
    <form>
        <div class="row g-3 mb-4">
            <div class="col-md-8">
                <label for="buscarNombre" class="form-label">Buscar por Nombre</label>
                <input type="text" class="form-control" id="buscarNombre" placeholder="Ingrese el nombre del asociado" required>
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <button type="button" class="btn btn-primary w-100" onclick="mostrarFormulario()">Buscar</button>
            </div>
        </div>
    </form>

    <!-- Formulario editable (simulado con datos) -->
    <form id="formEditar" style="display: none;">
        <div class="row g-3">
            <div class="col-md-6">
                <label for="nombre" class="form-label">Nombre Completo</label>
                <input type="text" class="form-control" id="nombre" value="Juan Pérez">
            </div>
            <div class="col-md-6">
                <label for="identificacion" class="form-label">Número de Identificación</label>
                <input type="text" class="form-control" id="identificacion" value="123456789">
            </div>
            <div class="col-md-6">
                <label for="fechaNacimiento" class="form-label">Fecha de Nacimiento</label>
                <input type="date" class="form-control" id="fechaNacimiento" value="1990-01-01">
            </div>
            <div class="col-md-6">
                <label for="correo" class="form-label">Correo Electrónico</label>
                <input type="email" class="form-control" id="correo" value="juan.perez@example.com">
            </div>
            <div class="col-md-6">
                <label for="telefono" class="form-label">Teléfono de Contacto</label>
                <input type="tel" class="form-control" id="telefono" value="+123456789">
            </div>
            <div class="col-md-6">
                <label for="direccion" class="form-label">Dirección Completa</label>
                <input type="text" class="form-control" id="direccion" value="123 Calle Principal, Ciudad">
            </div>
            <div class="col-md-6">
                <label for="tipo" class="form-label">Tipo de Asociado</label>
                <select class="form-select" id="tipo">
                    <option value="activo" selected>Activo</option>
                    <option value="inactivo">Inactivo</option>
                </select>
            </div>
            <div class="col-md-6">
                <label for="estado" class="form-label">Estado de la Afiliación</label>
                <select class="form-select" id="estado">
                    <option value="vigente" selected>Vigente</option>
                    <option value="suspendido">Suspendido</option>
                </select>
            </div>
        </div>
        <div class="text-end mt-3">
            <button type="submit" class="btn btn-success">Guardar Cambios</button>
        </div>
    </form>
</section>

<script>
    // Función para simular búsqueda y mostrar formulario
    function mostrarFormulario() {
        const buscarNombre = document.getElementById('buscarNombre').value;

        if (buscarNombre.trim() !== "") {
            // Simula mostrar el formulario con datos cargados
            document.getElementById('formEditar').style.display = 'block';
        } else {
            alert('Por favor, ingrese un nombre para buscar.');
        }
    }
</script>
