@model ASECCC_Digital.Entities.Usuario

@{
    ViewBag.Title = "ActualizarAsociado";
    Layout = "~/Views/Shared/_Layout.cshtml";
    @Html.Partial("_MenuModulos");
}

<h1 class="text-center mb-4">Editar Asociado</h1>
<section class="container mt-4 d-flex justify-content-center align-items-start" style="padding-top: 20px;">
    <div class="w-100" style="max-width: 800px;">

        <!-- Sección para buscar por nombre -->
        @using (Html.BeginForm("BuscarAsociado", "Asociados", FormMethod.Get, new { @class = "form-horizontal", role = "form", id = "formBuscar" }))
        {
            @Html.AntiForgeryToken()

            <div class="row g-3 mb-4">
                <div class="col-md-8">
                    <label for="buscarNombre" class="form-label">Buscar por Nombre</label>
                    @Html.TextBox("buscarNombre", null, new { @class = "form-control", placeholder = "Ingrese el nombre del asociado", required = "required" })
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">Buscar</button>
                </div>
            </div>
        }

        <!-- Formulario editable (inicialmente oculto) -->
        @using (Html.BeginForm("ActualizarAsociado", "Asociados", FormMethod.Post, new { @class = "form-horizontal", role = "form", id = "formEditar", style = "display: none;" }))
        {
            @Html.AntiForgeryToken()

            <div class="row g-3">
                <div class="col-md-6">
                    <label for="nombre" class="form-label">Nombre Completo</label>
                    @Html.TextBoxFor(m => m.NombreCompleto, new { @class = "form-control", @readonly = "readonly" })
                    @Html.ValidationMessageFor(m => m.NombreCompleto, "", new { @class = "text-danger" })
                </div>
                <div class="col-md-6">
                    <label for="identificacion" class="form-label">Número de Identificación</label>
                    @Html.TextBoxFor(m => m.Identificacion, new { @class = "form-control", @readonly = "readonly" })
                    @Html.ValidationMessageFor(m => m.Identificacion, "", new { @class = "text-danger" })
                </div>
                <div class="col-md-6">
                    <label for="fechaNacimiento" class="form-label">Fecha de Nacimiento</label>
                    @Html.TextBoxFor(m => m.FechaNacimiento, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date", @readonly = "readonly" })
                    @Html.ValidationMessageFor(m => m.FechaNacimiento, "", new { @class = "text-danger" })
                </div>
                <div class="col-md-6">
                    <label for="correo" class="form-label">Correo Electrónico</label>
                    @Html.TextBoxFor(m => m.CorreoElectronico, new { @class = "form-control", type = "email" })
                    @Html.ValidationMessageFor(m => m.CorreoElectronico, "", new { @class = "text-danger" })
                </div>
                <div class="col-md-6">
                    <label for="telefono" class="form-label">Teléfono de Contacto</label>
                    @Html.TextBoxFor(m => m.Telefono, new { @class = "form-control", type = "tel" })
                    @Html.ValidationMessageFor(m => m.Telefono, "", new { @class = "text-danger" })
                </div>
                <div class="col-md-6">
                    <label for="direccion" class="form-label">Dirección Completa</label>
                    @Html.TextBoxFor(m => m.Direccion, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Direccion, "", new { @class = "text-danger" })
                </div>
                <div class="col-md-6">
                    <label for="tipo" class="form-label">Tipo de Asociado</label>
                    @Html.DropDownListFor(m => m.TipoIdentificacion, new List<SelectListItem>
                    {
                        new SelectListItem { Text = "Activo", Value = "activo" },
                        new SelectListItem { Text = "Inactivo", Value = "inactivo" }
                    }, new { @class = "form-select" })
                    @Html.ValidationMessageFor(m => m.TipoIdentificacion, "", new { @class = "text-danger" })
                </div>
                <div class="col-md-6">
                    <label for="estado" class="form-label">Estado de la Afiliación</label>
                    @Html.DropDownListFor(m => m.EstadoAfiliacion, new List<SelectListItem>
                    {
                        new SelectListItem { Text = "Vigente", Value = "vigente" },
                        new SelectListItem { Text = "Suspendido", Value = "suspendido" }
                    }, new { @class = "form-select" })
                    @Html.ValidationMessageFor(m => m.EstadoAfiliacion, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="text-end mt-3">
                <button type="submit" class="btn btn-success">Guardar Cambios</button>
            </div>
        }
    </div>
</section>

@section Scripts {
    <script>
        // Mostrar el formulario de edición si hay datos en el modelo
        @if (Model != null && !string.IsNullOrEmpty(Model.NombreCompleto))
        {
            <text>
            document.getElementById('formEditar').style.display = 'block';
            </text>
        }

        // Función para simular búsqueda y mostrar formulario
        function mostrarFormulario() {
            const buscarNombre = document.getElementById('buscarNombre').value;

            if (buscarNombre.trim() !== "") {
                // Simula mostrar el formulario con datos cargados
                document.getElementById('formEditar').style.display = 'block';
            } else {
                alert('Por favor, ingrese un nombre para buscar.');
            }
        }
    </script>
}