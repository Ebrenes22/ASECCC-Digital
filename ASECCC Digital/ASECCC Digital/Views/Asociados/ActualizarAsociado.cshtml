@model ASECCC_Digital.Entities.Usuario

@{
    ViewBag.Title = "ActualizarAsociado";
    Layout = "~/Views/Shared/_Layout.cshtml";
    @Html.Partial("_MenuModulos");
}

<section class="container mt-5">
    <div class="card shadow-lg p-4 mx-auto" style="max-width: 800px;">
        <h1 class="text-center mb-4">EDITAR ASOCIADO</h1>

        <!-- Formulario de búsqueda -->
        <form id="formBuscar">
            <div class="row g-3 mb-4">
                <div class="col-12 position-relative">
                    @Html.LabelFor(model => model.NombreCompleto, "Buscar por Nombre", new { @class = "form-label fw-bold" })
                    @Html.TextBox("buscarNombre", null, new { @class = "form-control", placeholder = "Ingrese el nombre del asociado", autocomplete = "off", required = "required" })
                    <ul class="list-group position-absolute w-100" id="sugerenciasNombres" style="z-index: 1000; display: none;"></ul>
                </div>
                <div class="col-12 d-flex justify-content-center">
                    <button type="button" class="btn btn-primary w-50" onclick="buscarAsociado()">Buscar</button>
                </div>
            </div>
        </form>

        <!-- Formulario editable (inicialmente oculto) -->
        @using (Html.BeginForm("ActualizarAsociado", "Asociados", FormMethod.Post, new { @class = "form-horizontal needs-validation", role = "form", id = "formEditar", style = "display: none;" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.UsuarioId, new { id = "usuarioId" })

    <div class="row g-3">
        <div class="col-md-6 col-sm-12">
            <label for="nombreCompleto" class="form-label fw-bold">Nombre Completo</label>
            @Html.TextBoxFor(m => m.NombreCompleto, new { @class = "form-control", id = "nombreCompleto" })
            @Html.ValidationMessageFor(m => m.NombreCompleto, "", new { @class = "text-danger" })
        </div>
        <div class="col-md-6 col-sm-12">
            <label for="identificacion" class="form-label fw-bold">Número de Identificación</label>
            @Html.TextBoxFor(m => m.Identificacion, new { @class = "form-control", @readonly = "readonly", id = "identificacion" })
            @Html.ValidationMessageFor(m => m.Identificacion, "", new { @class = "text-danger" })
        </div>
        <div class="col-md-6 col-sm-12">
            <label for="fechaNacimiento" class="form-label fw-bold">Fecha de Nacimiento</label>
            @Html.TextBoxFor(m => m.FechaNacimiento, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date", id = "fechaNacimiento" })
            @Html.ValidationMessageFor(m => m.FechaNacimiento, "", new { @class = "text-danger" })
        </div>
        <div class="col-md-6 col-sm-12">
            <label for="correoElectronico" class="form-label fw-bold">Correo Electrónico</label>
            @Html.TextBoxFor(m => m.CorreoElectronico, new { @class = "form-control", type = "email", id = "correoElectronico" })
            @Html.ValidationMessageFor(m => m.CorreoElectronico, "", new { @class = "text-danger" })
        </div>
        <div class="col-md-6 col-sm-12">
            <label for="telefono" class="form-label fw-bold">Teléfono</label>
            @Html.TextBoxFor(m => m.Telefono, new { @class = "form-control", type = "tel", id = "telefono", maxlength = "8", pattern = "[0-9]{8}" })
            @Html.ValidationMessageFor(m => m.Telefono, "", new { @class = "text-danger" })
        </div>
        <div class="col-md-6 col-sm-12">
            <label for="direccion" class="form-label fw-bold">Dirección</label>
            @Html.TextBoxFor(m => m.Direccion, new { @class = "form-control", id = "direccion" })
            @Html.ValidationMessageFor(m => m.Direccion, "", new { @class = "text-danger" })
        </div>
    </div>

            <!-- Botón de Guardar -->
            <div class="d-flex justify-content-center mt-3">
                <button type="submit" class="btn btn-success w-50">Guardar Cambios</button>
            </div>
        }
    </div>
</section>


@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>

    $(document).ready(function () {
        var mensaje = '@TempData["Mensaje"]';
        var mensajeTipo = '@TempData["MensajeTipo"]';

        // Si hay un mensaje de éxito o error
        if (mensaje) {
            Swal.fire({
                icon: mensajeTipo === 'success' ? 'success' : 'error',
                title: mensajeTipo === 'success' ? '¡Éxito!' : 'Error',
                text: mensaje,
                confirmButtonColor: mensajeTipo === 'success' ? '#28a745' : '#dc3545'
            });
        }

        // Si hay errores de validación
        var errores = @Html.Raw(Json.Encode(TempData["Errores"]));
        if (errores && errores.length > 0) {
            Swal.fire({
                icon: 'error',
                title: 'Errores de validación',
                html: '<ul style="text-align: left;">' + errores.map(e => `<li>${e}</li>`).join('') + '</ul>',
                confirmButtonColor: '#dc3545'
            });
        }
    });
    </script>
    <script>
        $(document).ready(function () {
            var $telefono = $('#telefono');
            var $tipoIdentificacion = $('#tipoIdentificacion');
            var $identificacion = $('#identificacion');
            // Función para formatear el número de identificación mientras se escribe
            $identificacion.on('input', function () {
                var tipo = $tipoIdentificacion.val();
                // Eliminar cualquier caracter que no sea dígito
                var value = $identificacion.val().replace(/[^0-9]/g, '');

                if (tipo === "Nacional") {
                    // Limitar a 9 dígitos (1 dígito + 4 + 4) y formatear: 1-2345-6789
                    if (value.length > 9) {
                        value = value.slice(0, 9);
                    }
                    value = value.replace(/^(\d{1})(\d{4})(\d+)/, '$1-$2-$3');
                } else if (tipo === "DIMEX") {
                    // Limitar a 12 dígitos (sin formateo)
                    if (value.length > 12) {
                        value = value.slice(0, 12);
                    }
                }
                $identificacion.val(value);
            });
            // Validación en tiempo real: solo permitir números y máximo 8 caracteres
            $telefono.on('input', function () {
                var value = $telefono.val().replace(/\D/g, ''); // Eliminar cualquier carácter que no sea número
                if (value.length > 8) {
                    value = value.substring(0, 8); // Limitar a 8 caracteres
                }
                $telefono.val(value);
            });

            // Validación antes de enviar el formulario
            $('#formEditar').on('submit', function (event) {
                var telefonoVal = $telefono.val().trim();

                if (telefonoVal.length !== 8) {
                    $telefono.addClass('is-invalid');
                    alert('El teléfono debe contener exactamente 8 dígitos numéricos.');
                    event.preventDefault(); // Detiene el envío del formulario
                    return;
                } else {
                    $telefono.removeClass('is-invalid');
                }
            });
        });

        // Función para buscar un asociado por nombre
        function buscarAsociado() {
            const buscarNombre = document.getElementById('buscarNombre').value.trim();

            if (buscarNombre) {
                fetch('/Asociados/BuscarAsociado', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ buscarNombre })
                })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            document.getElementById('formEditar').style.display = 'block';
                            document.getElementById('usuarioId').value = data.id;
                            document.getElementById('nombreCompleto').value = data.nombre;
                            document.getElementById('identificacion').value = data.identificacion;
                            document.getElementById('fechaNacimiento').value = data.fechaNacimiento;
                            document.getElementById('correoElectronico').value = data.correo;
                            document.getElementById('telefono').value = data.telefono;
                            document.getElementById('direccion').value = data.direccion;
                        } else {
                            alert(data.message);
                        }
                    })
                    .catch(error => console.error('Error:', error));
            } else {
                alert('Por favor, ingrese un nombre para buscar.');
            }
        }

        // Sugerencias dinámicas
        $(document).ready(function () {
            $("#buscarNombre").on("input", function () {
                const texto = $(this).val().trim();
                if (texto.length >= 2) {
                    $.ajax({
                        url: '/Asociados/BuscarSugerencias',
                        method: 'GET',
                        data: { texto },
                        success: function (data) {
                            let lista = $("#sugerenciasNombres").empty();
                            if (data.length > 0) {
                                data.forEach(nombre => {
                                    lista.append(`<li class="list-group-item list-group-item-action">${nombre}</li>`);
                                });
                                lista.show();
                            } else {
                                lista.hide();
                            }
                        }
                    });
                } else {
                    $("#sugerenciasNombres").hide();
                }
            });

            // Al hacer clic en una sugerencia
            $("#sugerenciasNombres").on("click", "li", function () {
                $("#buscarNombre").val($(this).text());
                $("#sugerenciasNombres").hide();
            });

            // Ocultar lista al hacer clic fuera
            $(document).on("click", function (e) {
                if (!$(e.target).closest("#buscarNombre, #sugerenciasNombres").length) {
                    $("#sugerenciasNombres").hide();
                }
            });
        });
    </script>
}
