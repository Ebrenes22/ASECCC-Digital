@{
    ViewBag.Title = "Buscar";
    Layout = "~/Views/Shared/_FormLayout.cshtml";
}

<section class="container mt-4" style="margin-left: 60px;">
    <h3 class="mb-4">Buscar Asociado</h3>

    <!-- Campo de búsqueda -->
    <form>
        <div class="row g-3 mb-4">
            <div class="col-md-8">
                <label for="buscarNombre" class="form-label">Buscar por Nombre</label>
                <input type="text" class="form-control" id="buscarNombre" placeholder="Ingrese el nombre del asociado" required>
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <button type="button" class="btn btn-primary w-100" disabled>Buscar</button>
            </div>
        </div>
    </form>

    <!-- Tabla de resultados (estática) -->
    <h5 class="mt-4">Resultados</h5>
    <table class="table table-striped mt-3">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Identificación</th>
                <th>Correo</th>
                <th>Teléfono</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            <!-- Resultados simulados -->
