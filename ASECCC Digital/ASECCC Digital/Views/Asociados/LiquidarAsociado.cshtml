@model ASECCC_Digital.Entities.Usuario

@{
    ViewBag.Title = "Liquidar Asociado";
    Layout = "~/Views/Shared/_Layout.cshtml";
    @Html.Partial("_MenuModulos");
}

<section class="container mt-3">
    <h1 class="text-center mb-4">LIQUIDAR ASOCIADO</h1>

    <!-- Formulario de búsqueda -->
    @using (Html.BeginForm("BuscarAsociado", "Asociados", FormMethod.Post, new { @class = "form-horizontal", role = "form", id = "formBuscar", onsubmit = "return false;" }))
    {
        @Html.AntiForgeryToken()
        <div class="row g-3 mb-4 align-items-center justify-content-center">
            <div class="col-auto">
                @Html.LabelFor(model => model.NombreCompleto, "", new { @class = "form-label fw-bold" })
            </div>
            <div class="col-auto">
                @Html.TextBox("buscarNombre", null, new
                {
                    @class = "form-control",
                    placeholder = "Ingrese el nombre del asociado",
                    autocomplete = "off",
                    required = "required",
                    style = "width: 400px;"
                })
                <ul class="list-group position-absolute" id="sugerenciasNombres" style="width: 400px; z-index: 1000; display: none;"></ul>
            </div>
            <div class="col-auto">
                <button type="button" class="btn btn-primary" onclick="buscarAsociado()">Buscar</button>
            </div>
        </div>
    }


    <div class="d-flex justify-content-between align-items-center mb-2">
        <div>
            <label for="tipoCuentaFiltro" class="form-label fw-bold me-2">Filtrar por Tipo de Cuenta:</label>
            <select id="tipoCuentaFiltro" class="form-select d-inline-block" style="width: auto;">
                <option value="todas">Todas</option>
                <option value="Ahorro">Ahorros</option>
                <option value="Aporte">Aportes</option>
                <option value="Préstamo">Préstamos</option>
            </select>
        </div>
        <button type="button" class="btn btn-danger" id="btnLiquidarSeleccionados" style="display: none;" onclick="liquidarSeleccionados()">
            Liquidar Seleccionados
        </button>
    </div>

    <!-- Tabla de cuentas -->
    <div id="contenedorCuentas" style="display: none;">
        <div class="table-responsive">
            <table id="tablaCuentas" class="table table-bordered">
                <thead class="table-dark">
                    <tr>
                        <th><input type="checkbox" id="selectAll"></th>
                        <th>Tipo</th>
                        <th>Descripción</th>
                        <th>Saldo</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</section>

@section Scripts {
    <script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        let usuarioId = null;
        let tablaCuentas = null;

        function buscarAsociado() {
            const buscarNombre = $('#buscarNombre').val().trim();
            if (!buscarNombre) return;

            fetch('/Asociados/BuscarCuentasAsociado', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ buscarNombre })
            })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        usuarioId = data.usuarioId;
                        $('#contenedorCuentas, #btnLiquidarSeleccionados').show();
                        actualizarTabla(data.cuentas);
                    } else {
                        Swal.fire({ icon: 'error', title: 'No encontrado', text: data.message });
                    }
                })
                .catch(err => console.error('Error:', err));
        }

        function actualizarTabla(datos) {
            // Destruir instancia previa si existía
            if (tablaCuentas) {
                tablaCuentas.clear().destroy();
            }

            // Inicializar DataTable sin el input de búsqueda global
            tablaCuentas = $('#tablaCuentas').DataTable({
                dom: 't<"bottom"i>',   // solo tabla + info en el bottom
                paging: false,
                searching: true,       // habilitado para poder usar column().search()
                ordering: true,
                info: true,
                language: {
                    url: "//cdn.datatables.net/plug-ins/1.13.6/i18n/Spanish.json",
                    paginate: { previous: "Anterior", next: "Siguiente" },
                    info: "Mostrando _START_ a _END_ de _TOTAL_ registros",
                    zeroRecords: "No se encontraron registros",
                    infoEmpty: "No hay registros disponibles",
                    infoFiltered: "(filtrado de _MAX_ registros en total)"
                },
                columns: [
                    {
                        data: null,
                        orderable: false,
                        render: (data, type, row) =>
                            `<input type="checkbox" class="cuentaCheckbox" data-id="${row.id}" data-tipo="${row.tipo}">`
                    },
                    { data: "tipo", title: "Tipo" },
                    { data: "descripcion", title: "Descripción" },
                    { data: "saldo", title: "Saldo" }
                ],
                destroy: true
            });

            // Volcar los datos
            datos.forEach(item => tablaCuentas.row.add(item));
            tablaCuentas.draw();
        }

        function liquidarSeleccionados() {
            const seleccionados = [];
            $('.cuentaCheckbox:checked').each(function () {
                seleccionados.push({
                    cuentaId: $(this).data('id'),
                    tipo: $(this).data('tipo')
                });
            });

            if (!seleccionados.length) {
                return Swal.fire({
                    icon: 'warning',
                    title: 'Atención',
                    text: 'Seleccione al menos una cuenta para liquidar.'
                });
            }

            Swal.fire({
                title: "¿Está seguro?",
                text: "Se liquidarán las cuentas seleccionadas.",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#d33",
                cancelButtonColor: "#3085d6",
                confirmButtonText: "Sí, liquidar",
                cancelButtonText: "Cancelar"
            }).then(result => {
                if (result.isConfirmed) {
                    fetch('/Asociados/LiquidarCuentas', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ cuentas: seleccionados })
                    })
                        .then(res => res.json())
                        .then(data => {
                            if (data.success) {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Cuentas Liquidadas',
                                    text: 'Las cuentas seleccionadas han sido liquidadas correctamente.'
                                }).then(() => buscarAsociado());
                            } else {
                                Swal.fire({ icon: 'error', title: 'Error', text: data.message });
                            }
                        })
                        .catch(err => console.error('Error:', err));
                }
            });
        }

        $(function () {
            // Filtrar por tipo de cuenta usando column().search()
            $('#tipoCuentaFiltro').on('change', function () {
                const val = $(this).val();
                tablaCuentas
                    .column(1)
                    .search(val === 'todas' ? '' : '^' + val + '$', true, false)
                    .draw();
            });

            // Seleccionar/Deseleccionar todas
            $('#selectAll').on('change', function () {
                $('.cuentaCheckbox').prop('checked', this.checked);
            });

            // Sugerencias dinámicas al escribir nombre
            $('#buscarNombre').on('input', function () {
                const txt = $(this).val().trim();
                if (txt.length < 2) return $('#sugerenciasNombres').hide();

                $.get('/Asociados/BuscarSugerencias', { texto: txt }, function (data) {
                    const ul = $('#sugerenciasNombres').empty();
                    if (data.length) {
                        data.forEach(n => ul.append(`<li class="list-group-item">${n}</li>`));
                        ul.show();
                    } else {
                        ul.hide();
                    }
                });
            });

            // Seleccionar sugerencia
            $('#sugerenciasNombres').on('click', 'li', function () {
                $('#buscarNombre').val($(this).text());
                $('#sugerenciasNombres').hide();
            });

            // Ocultar sugerencias al hacer clic fuera
            $(document).on('click', function (e) {
                if (!$(e.target).closest('#buscarNombre, #sugerenciasNombres').length) {
                    $('#sugerenciasNombres').hide();
                }
            });
        });
    </script>
}
