@model ASECCC_Digital.Entities.Usuario

@{
    ViewBag.Title = "Liquidar Asociado";
    Layout = "~/Views/Shared/_Layout.cshtml";
    @Html.Partial("_MenuModulos");
}

<section class="container mt-3">
    <h1 class="text-center mb-4">Liquidar Asociado</h1>

    <!-- Formulario de búsqueda -->
    @using (Html.BeginForm("BuscarAsociado", "Asociados", FormMethod.Post, new { @class = "form-horizontal", role = "form", id = "formBuscar", onsubmit = "return false;" }))
    {
        @Html.AntiForgeryToken()
        <div class="row g-3 mb-4 align-items-center justify-content-center">
            <div class="col-auto">
                @Html.LabelFor(model => model.NombreCompleto, "", new { @class = "form-label fw-bold" })
            </div>
            <div class="col-auto">
                @Html.TextBox("buscarNombre", null, new
                {
                    @class = "form-control",
                    placeholder = "Ingrese el nombre del asociado",
                    required = "required",
                    style = "width: 400px;"
                })
            </div>
            <div class="col-auto">
                <button type="button" class="btn btn-primary" onclick="buscarAsociado()">Buscar</button>
            </div>
        </div>
    }


    <div class="d-flex justify-content-between align-items-center mb-2">
        <div>
            <label for="tipoCuentaFiltro" class="form-label fw-bold me-2">Filtrar por Tipo de Cuenta:</label>
            <select id="tipoCuentaFiltro" class="form-select d-inline-block" style="width: auto;">
                <option value="todas">Todas</option>
                <option value="Ahorro">Ahorros</option>
                <option value="Aporte">Aportes</option>
                <option value="Préstamo">Préstamos</option>
            </select>
        </div>
        <button type="button" class="btn btn-danger" id="btnLiquidarSeleccionados" style="display: none;" onclick="liquidarSeleccionados()">
            Liquidar Seleccionados
        </button>
    </div>

    <!-- Tabla de cuentas -->
    <div id="contenedorCuentas" style="display: none;">
        <div class="table-responsive">
            <table id="tablaCuentas" class="table table-bordered">
                <thead class="table-dark">
                    <tr>
                        <th><input type="checkbox" id="selectAll"></th>
                        <th>Tipo</th>
                        <th>Descripción</th>
                        <th>Saldo</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</section>

@section Scripts {
    <script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        let usuarioId = null;

        function buscarAsociado() {
            const buscarNombre = document.getElementById('buscarNombre').value.trim();

            if (buscarNombre) {
                fetch('/Asociados/BuscarCuentasAsociado', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ buscarNombre })
                })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            usuarioId = data.usuarioId;
                            document.getElementById('contenedorCuentas').style.display = 'block';
                            document.getElementById('btnLiquidarSeleccionados').style.display = 'block';
                            actualizarTabla(data.cuentas);
                        } else {
                            Swal.fire({ icon: 'error', title: 'No encontrado', text: data.message });
                        }
                    })
                    .catch(error => console.error('Error:', error));
            }
        }

        function actualizarTabla(datos) {
            let tabla = $("#tablaCuentas").DataTable();
            tabla.clear();

            datos.forEach(item => {
                tabla.row.add([
                    `<input type="checkbox" class="cuentaCheckbox" data-id="${item.id}" data-tipo="${item.tipo}">`,
                    item.tipo,
                    item.descripcion,
                    item.saldo
                ]).draw();
            });
        }

        function liquidarSeleccionados() {
            let seleccionados = [];
            $(".cuentaCheckbox:checked").each(function () {
                seleccionados.push({ cuentaId: $(this).data("id"), tipo: $(this).data("tipo") });
            });

            if (seleccionados.length === 0) {
                Swal.fire({ icon: 'warning', title: 'Atención', text: 'Debe seleccionar al menos una cuenta para liquidar.' });
                return;
            }

            Swal.fire({
                title: "¿Está segura?",
                text: "Se liquidarán las cuentas seleccionadas.",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#d33",
                cancelButtonColor: "#3085d6",
                confirmButtonText: "Sí, liquidar",
                cancelButtonText: "Cancelar"
            }).then((result) => {
                if (result.isConfirmed) {
                    fetch('/Asociados/LiquidarCuentas', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ cuentas: seleccionados })
                    })
                        .then(response => response.json())
                        .then(data => {
                            if (data.success) {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Cuentas Liquidadas',
                                    text: 'Las cuentas seleccionadas han sido liquidadas correctamente.'
                                }).then(() => buscarAsociado());
                            } else {
                                Swal.fire({ icon: 'error', title: 'Error', text: data.message });
                            }
                        })
                        .catch(error => console.error('Error:', error));
                }
            });
        }

        $(document).ready(function () {
            let tabla = $("#tablaCuentas").DataTable({

                dom: 't<"bottom"p>',
                language: {
                    url: "//cdn.datatables.net/plug-ins/1.11.5/i18n/es-ES.json"
                },
                searching: true,
                lengthChange: false,
                pageLength: 10 
            });

            // Filtrar por tipo de cuenta
            $("#tipoCuentaFiltro").on("change", function () {
                let tipo = $(this).val();
                tabla.columns(1).search(tipo === "todas" ? "" : tipo).draw();
            });

            // Seleccionar/Deseleccionar todas las cuentas
            $("#selectAll").on("change", function () {
                $(".cuentaCheckbox").prop("checked", this.checked);
            });
        });
    </script>
}
