﻿@model ASECCC_Digital.ViewModels.BeneficioServicioViewModel

@{
    ViewBag.Title = "Gestión de Beneficios y Servicios";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1 class="text-center">Beneficios y Servicios Disponibles</h1>

<div class="container">
    <div class="row">
        @foreach (var item in Model.BeneficioServicios)
        {
            <div class="col-md-4">
                <div class="card mb-4">
                    <div class="card-header">
                        @item.Nombre
                    </div>
                    <div class="card-footer text-end">
                        <button class="btn btn-info btn-sm"
                                data-bs-toggle="modal"
                                data-bs-target="#modalVerMas"
                                data-id="@item.BeneficioId"
                                data-nombre="@item.Nombre"
                                data-descripcion="@item.Descripcion"
                                data-requisitos="@item.Requisitos"
                                data-categoria="@item.Categoria">
                            Ver Más
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<div class="modal fade" id="modalVerMas" tabindex="-1" aria-labelledby="modalVerMasLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalVerMasLabel">Más Información</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p><strong>Nombre:</strong> <span id="verMasNombre"></span></p>
                <p><strong>Descripción:</strong> <span id="verMasDescripcion"></span></p>
                <p><strong>Requisitos:</strong> <span id="verMasRequisitos"></span></p>
                <p><strong>Categoría:</strong> <span id="verMasCategoria"></span></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var modalVerMas = document.getElementById('modalVerMas');
        modalVerMas.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget; // Botón que disparó el modal
            var nombre = button.getAttribute('data-nombre');
            var descripcion = button.getAttribute('data-descripcion');
            var requisitos = button.getAttribute('data-requisitos');
            var categoria = button.getAttribute('data-categoria');
            var estado = button.getAttribute('data-estado');

            modalVerMas.querySelector('#verMasNombre').innerText = nombre;
            modalVerMas.querySelector('#verMasDescripcion').innerText = descripcion;
            modalVerMas.querySelector('#verMasRequisitos').innerText = requisitos;
            modalVerMas.querySelector('#verMasCategoria').innerText = categoria;
            modalVerMas.querySelector('#verMasEstado').innerText = estado;
        });
    </script>
}