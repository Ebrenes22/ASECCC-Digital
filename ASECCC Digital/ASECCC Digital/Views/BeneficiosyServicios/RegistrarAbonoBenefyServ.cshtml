@model ASECCC_Digital.ViewModels.BeneficioServicioViewModel

@{
    ViewBag.Title = "Registrar Abono a Beneficio y Servicio";
    Layout = "~/Views/Shared/_Layout.cshtml";
    @Html.Partial("_MenuModulos");
}

<div class="container my-4">
    <h1 class="text-center">REGISTRAR ABONO A BENEFICIO Y SERVICIO</h1>

    <!-- Dropdown -->
    <div class="row mb-3">
        <div class="col-12 col-md-6 offset-md-3">
            <select id="searchAssociated" class="form-control">
                <option value="">Seleccione un asociado</option>
                @foreach (var usuario in Model.Usuarios)
                {
                    <option value="@usuario.UsuarioId">@usuario.NombreCompleto</option>
                }
            </select>
        </div>
    </div>

    <!-- Título dinámico -->
    <div class="row mb-2">
        <div class="col-12 text-center">
            <h4 id="selectedUserTitle"
                class="fw-bold  border-bottom pb-2"
                style="display:none;"></h4>
        </div>
    </div>

    <!-- Tabla cuentas -->
    <div class="table-responsive mb-4">
        <table id="accountsTable" class="table table-bordered">
            <thead>
                <tr>
                    <th>Cuenta ID</th>
                    <th>Beneficio</th>
                    <th>Monto Total</th>
                    <th>Monto Pendiente</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

<!-- Modal Registrar Abono -->
<div class="modal fade" id="modalRegistrarAbono" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            @using (Html.BeginForm("RegistrarAbono", "BeneficiosyServicios", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <div class="modal-header">
                    <h5 class="modal-title">Registrar Abono</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <input type="hidden"
                           id="ModalCuentaId"
                           name="CuentaBeneficiosServiciosId" />

                    <div class="mb-3">
                        <label class="form-label">Monto Abonado</label>
                        <input type="number"
                               step="0.01"
                               min="0.01"
                               name="Monto"
                               class="form-control"
                               required />
                        @Html.ValidationMessage("Monto", "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancelar
                    </button>
                    <button type="submit"
                            class="btn btn-success">
                        Registrar Abono
                    </button>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal Historial -->
<div class="modal fade" id="modalHistorial" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Historial de Pagos</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="table-responsive">
                    <table id="historialTable" class="table table-striped">
                        <thead>
                            <tr>
                                <th>Monto Abonado</th>
                                <th>Fecha</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cerrar
                </button>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet"
      href="https://cdn.datatables.net/1.13.4/css/jquery.dataTables.min.css" />
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>

@if (TempData["SuccessMessage"] != null)
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            Swal.fire({
                icon: 'success',
                title: '¡Éxito!',
                text: '@TempData["SuccessMessage"]',
                confirmButtonText: 'Aceptar'
            });
        });
    </script>
}

@section Scripts {
    <script>
$(document).ready(function () {

    function parseNetDate(input) {
        if (!input) return null;
        var m = /Date\((\d+)\)/.exec(input);
        if (m) return new Date(parseInt(m[1], 10));
        var d = new Date(input);
        return isNaN(d) ? null : d;
    }

    var accountsTable = $('#accountsTable').DataTable({

        pageLength: 10,
        lengthChange: false,
        columnDefs: [
            {
                targets: 0,      // Primera columna (Cuenta ID)
                visible: false,  // La oculta
                searchable: false
            }
        ]
    });

    $('#searchAssociated').on('change', function () {

        var usuarioId = $(this).val();
        var nombreUsuario = $("#searchAssociated option:selected").text();

        if (usuarioId === "") {
            accountsTable.clear().draw();
            $("#selectedUserTitle").hide().text("");
            return;
        }

        $("#selectedUserTitle")
            .text("Abono a : " + nombreUsuario)
            .show();

        $.get('@Url.Action("ConsultarCuentasPorUsuario", "BeneficiosyServicios")',
            { usuarioId: usuarioId },
            function (response) {

                if (response.success) {

                    accountsTable.clear();

                    $.each(response.cuentas, function (i, cuenta) {

                        accountsTable.row.add([
                            cuenta.CuentaBeneficiosServiciosId,
                            cuenta.BeneficioServicio.Nombre,
                            new Intl.NumberFormat("es-CR",
                                { style: "currency", currency: "CRC" })
                                .format(cuenta.MontoTotal),
                            new Intl.NumberFormat("es-CR",
                                { style: "currency", currency: "CRC" })
                                .format(cuenta.MontoPendiente),
                            '<button type="button" class="btn btn-info btn-sm select-account" data-id="' +
                            cuenta.CuentaBeneficiosServiciosId +
                            '">Realizar Abono</button> ' +
                            '<button type="button" class="btn btn-secondary btn-sm view-history" data-id="' +
                            cuenta.CuentaBeneficiosServiciosId +
                            '">Historial</button>'
                        ]).draw();

                    });
                }
            });
    });

    $(document).on('click', '.select-account', function () {
        var cuentaId = $(this).data('id');
        $('#ModalCuentaId').val(cuentaId);
        $('#modalRegistrarAbono').modal('show');
    });

    $(document).on('click', '.view-history', function () {

        var cuentaId = $(this).data('id');

        $.get('@Url.Action("HistorialPagos", "BeneficiosyServicios")',
            { cuentaId: cuentaId },
            function (data) {

                if (data.success) {

                    var tbody = $('#historialTable tbody');
                    tbody.empty();

                    $.each(data.registros, function (i, pago) {

                        var d = parseNetDate(pago.FechaTransaccion);
                        var fechaStr = d ?
                            d.toLocaleDateString("es-CR") : "";

                        tbody.append(
                            '<tr>' +
                            '<td>' +
                            new Intl.NumberFormat("es-CR",
                                { style: "currency", currency: "CRC" })
                                .format(pago.Monto) +
                            '</td>' +
                            '<td>' + fechaStr + '</td>' +
                            '</tr>'
                        );
                    });

                    $('#modalHistorial').modal('show');
                }
            });
    });

});
    </script>
}