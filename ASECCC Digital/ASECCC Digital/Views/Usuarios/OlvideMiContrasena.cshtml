
@{
    ViewBag.Title = "Recuperar Contraseña";
    Layout = "~/Views/Shared/_Layout_Externo.cshtml";
}
    ViewBag.Title = "Recuperar Contraseña";


<h2>Recuperar Contraseña</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<form action="@Url.Action("OlvideMiContrasena", "Usuarios")" method="post">
    <div>
        <label>Correo Electrónico</label>
        <input type="email" name="email" required class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary mt-2">Enviar Instrucciones</button>
</form>


