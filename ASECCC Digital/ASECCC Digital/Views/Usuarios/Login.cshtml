@model ASECCC_Digital.Entities.Usuario
@{
    ViewBag.Title = "Login";
    Layout = "~/Views/Shared/_Layout_Externo.cshtml";
}
<div class="login-container d-flex justify-content-center align-items-center">
    <div class="card p-4" style="max-width: 400px; width: 100%; box-shadow: 0 4px 8px rgba(0,0,0,0.1);">
        <h2 class="text-center mb-4">Iniciar Sesión</h2>
        @using (Html.BeginForm("Login", "Usuarios", FormMethod.Post, new { id = "loginForm", @class = "needs-validation", novalidate = "novalidate" }))
        {
            @Html.AntiForgeryToken()

            <div class="mb-3">
                @Html.Label("Tipo de Identificación", null, new { @class = "form-label" })
                @Html.DropDownList("TipoIdentificacion", new SelectList(new[] {
                    new { Value = "Cedula", Text = "Cédula Nacional" },
                    new { Value = "DIMEX", Text = "Identificación DIMEX" }
                }, "Value", "Text"), new { @class = "form-control", required = "required", id = "tipoIdentificacion" })
                <div class="invalid-feedback">
                    Por favor seleccione un tipo de identificación.
                </div>
            </div>
            <div class="mb-3">
                @Html.Label("Usuario", null, new { @class = "form-label" })
                @Html.TextBox("identificacion", null, new { @class = "form-control", placeholder = "Ingrese su número de identificación", required = "required", maxlength = "12", id = "identificacion" })
                <div class="invalid-feedback" id="identificacionError">
                    Por favor ingrese un número de identificación válido.
                </div>
            </div>
            <div class="mb-3">
                @Html.Label("Contraseña", null, new { @class = "form-label" })
                <div class="input-group">
                    @Html.Password("contrasena", null, new { @class = "form-control", required = "required", id = "contrasena" })
                    <button type="button" class="btn btn-outline-secondary" id="togglePassword">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
                <div class="invalid-feedback">
                    Por favor ingrese su contraseña.
                </div>
            </div>
            <div class="d-flex justify-content-center mb-3">
                <button type="submit" class="btn btn-primary text-center">
                    Iniciar Sesión
                </button>
            </div>
            <div class="text-center">
                <a href="#" class="text-primary" data-bs-toggle="modal" data-bs-target="#forgotPasswordModal">
                    ¿Olvidó su contraseña?
                </a>
            </div>
        }
    </div>
</div>


<!-- Forgot Password Modal -->
<div class="modal fade" id="forgotPasswordModal" tabindex="-1" aria-labelledby="forgotPasswordModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="forgotPasswordModalLabel">Restablecer Contraseña</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                @using (Html.BeginForm("ResetPassword", "Account", FormMethod.Post, new { id = "forgotPasswordForm" }))
                {
                    <div class="mb-3">
                        @Html.Label("Tipo de Identificación", null, new { @class = "form-label" })
                        @Html.DropDownList("ResetTipoIdentificacion", new SelectList(new[] {
                            new { Value = "", Text = "Seleccione tipo de identificación" },
                            new { Value = "cedula", Text = "Cédula Nacional" },
                            new { Value = "dimex", Text = "Identificación DIMEX" }
                        }, "Value", "Text"), new { @class = "form-select", required = "required" })
                    </div>
                    <div class="mb-3">
                        @Html.Label("Número de Identificación", "resetCedula", new { @class = "form-label" })
                        @Html.TextBox("ResetCedula", null, new { @class = "form-control", placeholder = "Ingrese su número de identificación", required = "required", maxlength = "12" })
                        <div class="invalid-feedback">
                            Por favor ingrese un número de identificación válido.
                        </div>
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="sendResetEmailBtn">Enviar Correo de Restablecimiento</button>
            </div>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    // Mostrar alerta si hay un error de login
    $(document).ready(function () {
        var loginError = '@TempData["LoginError"]';
        if (loginError) {
            Swal.fire({
                icon: 'error',
                title: 'Inicio de sesión incorrecto',
                text: loginError,
                confirmButtonColor: '#d33',
                confirmButtonText: 'Aceptar'
            });
        }
    });
</script>

<script>
    $(document).ready(function () {
        const identificacionInput = $('#identificacion');
        const tipoIdentificacionSelect = $('#tipoIdentificacion');
        const identificacionError = $('#identificacionError');

        // Función para validar el formato de la cédula o DIMEX
        function validarIdentificacion(value, tipo) {
            if (tipo === "Cedula") {
                // Validar cédula nacional (9 dígitos)
                return /^\d{1}-\d{4}-\d{4}$/.test(value);
            } else if (tipo === "DIMEX") {
                // Validar DIMEX (12 dígitos)
                return /^\d{12}$/.test(value);
            }
            return false;
        }

        // Formatear y validar el número de identificación
        identificacionInput.on('input', function () {
            const tipo = tipoIdentificacionSelect.val();
            let value = identificacionInput.val().replace(/[^0-9]/g, ''); // Solo números

            if (tipo === "Cedula") {
                // Formato de cédula: 0-0000-0000
                if (value.length > 9) value = value.slice(0, 9); // Limitar a 9 dígitos
                value = value.replace(/^(\d{1})(\d{4})(\d+)/, '$1-$2-$3');
            } else if (tipo === "DIMEX") {
                // Formato de DIMEX: 000000000000
                if (value.length > 12) value = value.slice(0, 12); // Limitar a 12 dígitos
            }

            identificacionInput.val(value); // Actualizar el valor del campo
        });

        // Validación del formulario
        $('#loginForm').on('submit', function (event) {
            const form = this;
            const tipo = tipoIdentificacionSelect.val();
            const identificacion = identificacionInput.val();

            // Validar el formato de la identificación
            if (!validarIdentificacion(identificacion, tipo)) {
                identificacionInput.addClass('is-invalid');
                identificacionError.text('Por favor ingrese un número de identificación válido.');
                event.preventDefault();
                event.stopPropagation();
            } else {
                identificacionInput.removeClass('is-invalid');
            }

            // Validación general del formulario
            if (!form.checkValidity()) {
                event.preventDefault();
                event.stopPropagation();
            }

            form.classList.add('was-validated');
        });

        // Toggle de visibilidad de contraseña
        $('#togglePassword').on('click', function () {
            const passwordField = $('#contrasena');
            const icon = $(this).find('i');

            if (passwordField.attr('type') === 'password') {
                passwordField.attr('type', 'text');
                icon.removeClass('bi-eye').addClass('bi-eye-slash');
            } else {
                passwordField.attr('type', 'password');
                icon.removeClass('bi-eye-slash').addClass('bi-eye');
            }
        });
    });

    // Toggle de visibilidad de contraseña (misma función que en el código original)
    document.getElementById('togglePassword').addEventListener('click', function (e) {
        const passwordField = document.getElementById('password');
        const icon = this.querySelector('i');

        if (passwordField.type === 'password') {
            passwordField.type = 'text';
            icon.classList.remove('bi-eye');
            icon.classList.add('bi-eye-slash');
        } else {
            passwordField.type = 'password';
            icon.classList.remove('bi-eye-slash');
            icon.classList.add('bi-eye');
        }
    });
</script>

<!-- Modal de éxito -->
<div class="modal fade" id="successModal" tabindex="-1" aria-labelledby="successModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="successModalLabel">Restablecimiento de Contraseña</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p id="successModalMessage"></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Aceptar</button>
            </div>
        </div>
    </div>
</div>