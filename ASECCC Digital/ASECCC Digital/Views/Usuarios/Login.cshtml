@model ASECCC_Digital.Entities.Usuario
@{
    ViewBag.Title = "Login";
    Layout = "~/Views/Shared/_Layout_Externo.cshtml";
}
<style>
    .login-shell {
        min-height: calc(100vh - 252px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 38px 16px 44px;
        color: #1f2937;
    }

    .login-panel {
        width: min(1040px, 100%);
        display: grid;
        grid-template-columns: minmax(0, 0.95fr) minmax(360px, 0.75fr);
        overflow: hidden;
        border: 1px solid rgba(255, 255, 255, 0.42);
        border-radius: 8px;
        background: rgba(255, 255, 255, 0.96);
        box-shadow: 0 24px 60px rgba(3, 12, 46, 0.28);
    }

    .login-brand {
        position: relative;
        min-height: 560px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 42px;
        background:
            linear-gradient(rgba(3, 24, 64, 0.45), rgba(2, 74, 124, 0.35)),
            url('@Url.Content("~/Assets/img/wallpaper/background-solid.png")') center/cover no-repeat;
        color: #fff;
    }

    .login-brand-logo {
        width: 112px;
        height: auto;
        padding: 10px;
        border-radius: 8px;
        background: rgba(255, 255, 255, 0.92);
    }

    .login-brand-copy {
        max-width: 520px;
    }

    .login-brand-copy h1 {
        margin: 0 0 14px;
        color: #fff;
        font-size: 2.35rem;
        font-weight: 700;
        line-height: 1.08;
    }

    .login-brand-copy p {
        margin: 0;
        color: rgba(255, 255, 255, 0.88);
        font-size: 1rem;
        line-height: 1.65;
    }

    .login-brand-meta {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 28px;
    }

    .login-brand-meta span {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 12px;
        border: 1px solid rgba(255, 255, 255, 0.22);
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.12);
        color: rgba(255, 255, 255, 0.9);
        font-size: 0.88rem;
    }

    .login-form-section {
        display: flex;
        align-items: center;
        padding: 44px;
        background: #ffffff;
    }

    .login-form-wrap {
        width: 100%;
        max-width: 390px;
        margin: 0 auto;
    }

    .login-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 14px;
        color: #0563bb;
        font-size: 0.9rem;
        font-weight: 700;
    }

    .login-form-wrap h2 {
        margin: 0 0 8px;
        color: #111827;
        font-size: 1.75rem;
        font-weight: 700;
    }

    .login-subtitle {
        margin-bottom: 28px;
        color: #6b7280;
        font-size: 0.96rem;
    }

    .login-field {
        margin-bottom: 18px;
    }

    .login-field label {
        margin-bottom: 7px;
        color: #374151;
        font-size: 0.92rem;
        font-weight: 700;
    }

    .login-field .form-control {
        max-width: none;
        height: 46px;
        border-color: #d1d5db;
        border-radius: 8px;
        color: #111827;
        box-shadow: none;
    }

    .login-field .form-control:focus {
        border-color: #0563bb;
        box-shadow: 0 0 0 0.2rem rgba(5, 99, 187, 0.14);
    }

    .login-password-group .form-control {
        border-right: 0;
        border-radius: 8px 0 0 8px;
    }

    .login-password-toggle {
        width: 48px;
        border-color: #d1d5db;
        border-radius: 0 8px 8px 0;
        color: #4b5563;
        background: #f9fafb;
    }

    .login-actions {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        margin: 8px 0 24px;
    }

    .login-forgot-link {
        border: 0;
        padding: 0;
        color: #0563bb;
        background: transparent;
        font-size: 0.92rem;
        font-weight: 700;
    }

    .login-forgot-link:hover,
    .login-forgot-link:focus {
        color: #034b8f;
        text-decoration: underline;
    }

    .login-submit {
        width: 100%;
        min-height: 48px;
        border: 0;
        border-radius: 8px;
        background: #0563bb;
        font-weight: 700;
        box-shadow: 0 12px 24px rgba(5, 99, 187, 0.24);
    }

    .login-submit:hover,
    .login-submit:focus {
        background: #034f96;
    }

    .login-modal .modal-content {
        border: 0;
        border-radius: 8px;
        box-shadow: 0 24px 54px rgba(17, 24, 39, 0.22);
    }

    .login-modal .modal-header,
    .login-modal .modal-footer {
        border-color: #eef2f7;
    }

    .login-modal .form-control,
    .login-modal .form-select,
    .login-modal select {
        max-width: none;
        height: 44px;
        border-radius: 8px;
    }

    @@media (max-width: 991.98px) {
        .login-shell {
            min-height: auto;
            padding: 24px 12px;
        }

        .login-panel {
            grid-template-columns: 1fr;
        }

        .login-brand {
            min-height: 260px;
            padding: 28px;
        }

        .login-brand-copy h1 {
            font-size: 1.8rem;
        }

        .login-form-section {
            padding: 32px 24px;
        }
    }

    @@media (max-width: 575.98px) {
        .login-brand {
            min-height: 230px;
            padding: 22px;
        }

        .login-brand-logo {
            width: 88px;
        }

        .login-brand-copy h1 {
            font-size: 1.45rem;
        }

        .login-brand-copy p,
        .login-brand-meta {
            display: none;
        }

        .login-form-section {
            padding: 28px 18px;
        }

        .login-form-wrap h2 {
            font-size: 1.45rem;
        }

        .login-actions {
            justify-content: center;
        }
    }
</style>

<main class="login-shell">
    <section class="login-panel" aria-label="Inicio de sesion ASECCC Digital">
        <div class="login-brand">
            <img src="@Url.Content("~/Assets/img/logos/ASECCC_LOGO_1.png")" alt="ASECCC" class="login-brand-logo" />

            <div class="login-brand-copy">
                <h1>ASECCC Digital</h1>
                <p>Acceda de forma segura a sus servicios de ahorro, aportes, prestamos, beneficios y notificaciones.</p>
                <div class="login-brand-meta" aria-label="Servicios disponibles">
                    <span><i class="bi bi-shield-check"></i> Acceso seguro</span>
                    <span><i class="bi bi-bank"></i> Servicios asociados</span>
                </div>
            </div>
        </div>

        <div class="login-form-section">
            <div class="login-form-wrap">
                <div class="login-eyebrow">
                    <i class="bi bi-person-circle"></i>
                    Portal de asociados
                </div>
                <h2>Iniciar sesion</h2>
                <p class="login-subtitle">Ingrese sus credenciales para continuar.</p>

                @using (Html.BeginForm("Login", "Usuarios", FormMethod.Post, new { id = "loginForm", @class = "needs-validation", novalidate = "novalidate" }))
                {
                    @Html.AntiForgeryToken()

                    <div class="login-field">
                        @Html.Label("TipoIdentificacion", "Tipo de identificacion", new { @class = "form-label" })
                        @Html.DropDownList("TipoIdentificacion", new SelectList(new[] {
                            new { Value = "Cedula", Text = "Cedula Nacional" },
                            new { Value = "DIMEX", Text = "Identificacion DIMEX" }
                        }, "Value", "Text"), new { @class = "form-control", required = "required", id = "tipoIdentificacion" })
                        <div class="invalid-feedback">
                            Seleccione un tipo de identificacion.
                        </div>
                    </div>

                    <div class="login-field">
                        @Html.Label("identificacion", "Numero de identificacion", new { @class = "form-label" })
                        @Html.TextBox("identificacion", null, new { @class = "form-control", placeholder = "0-0000-0000", required = "required", maxlength = "12", id = "identificacion", autocomplete = "username" })
                        <div class="invalid-feedback" id="identificacionError">
                            Ingrese un número de identificacion válido.
                        </div>
                    </div>

                    <div class="login-field">
                        <label for="contrasena" class="form-label">Contrase&ntilde;a</label>
                        <div class="input-group login-password-group">
                            @Html.Password("contrasena", null, new { @class = "form-control", required = "required", id = "contrasena", autocomplete = "current-password", placeholder = "Ingrese su contraseña" })
                            <div class="input-group-append">
                                <button type="button" class="btn login-password-toggle" id="togglePassword" aria-label="Mostrar contraseña" title="Mostrar contraseña">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                            <div class="invalid-feedback">
                                Ingrese su contraseña.
                            </div>
                        </div>
                    </div>

                    <div class="login-actions">
                        <button type="button" class="login-forgot-link" data-toggle="modal" data-target="#forgotPasswordModal">
                            ¿Olvido su contraseña?
                        </button>
                    </div>

                    <button type="submit" class="btn btn-primary login-submit">
                        Iniciar sesion
                    </button>
                }
            </div>
        </div>
    </section>
</main>

<div class="modal fade login-modal" id="forgotPasswordModal" tabindex="-1" role="dialog" aria-labelledby="forgotPasswordModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="forgotPasswordModalLabel">Restablecer contraseña</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="forgotPasswordForm" class="needs-validation" novalidate>
                    <div class="form-group">
                        <label for="ResetTipoIdentificacion">Tipo de identificación</label>
                        <select id="ResetTipoIdentificacion" class="form-control" required>
                            <option value="Nacional">Cédula Nacional</option>
                            <option value="Dimex">Identificación DIMEX</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="ResetCedula">Número de identificación</label>
                        <input type="text" id="ResetCedula" class="form-control" placeholder="0-0000-0000" required maxlength="12" autocomplete="username">
                        <div class="invalid-feedback">
                            Ingrese un número de identificación válido.
                        </div>
                    </div>
                </form>
                <div id="resetPasswordMessage" class="mt-3"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="sendResetEmailBtn">Enviar instrucciones</button>
            </div>
        </div>
    </div>
</div>

<script>
    $(function () {
        const loginError = '@System.Web.HttpUtility.JavaScriptStringEncode(Convert.ToString(TempData["LoginError"]))';

        if (loginError) {
            Swal.fire({
                icon: 'error',
                title: 'Inicio de sesión incorrecto',
                text: loginError,
                confirmButtonColor: '#d33',
                confirmButtonText: 'Aceptar'
            });
        }

        const $identificacion = $('#identificacion');
        const $tipoIdentificacion = $('#tipoIdentificacion');
        const $identificacionError = $('#identificacionError');
        const $resetIdentificacion = $('#ResetCedula');
        const $resetTipoIdentificacion = $('#ResetTipoIdentificacion');

        function limpiarNumeros(value) {
            return String(value || '').replace(/[^0-9]/g, '');
        }

        function formatearIdentificacion(value, tipo) {
            let limpio = limpiarNumeros(value);

            if (tipo === 'Cedula' || tipo === 'Nacional') {
                limpio = limpio.slice(0, 9);
                return limpio.replace(/^(\d{1})(\d{4})(\d+)/, '$1-$2-$3');
            }

            return limpio.slice(0, 12);
        }

        function validarIdentificacion(value, tipo) {
            if (tipo === 'Cedula' || tipo === 'Nacional') {
                return /^\d{1}-\d{4}-\d{4}$/.test(value);
            }

            if (tipo === 'DIMEX' || tipo === 'Dimex') {
                return /^\d{12}$/.test(value);
            }

            return false;
        }

        function actualizarPlaceholder($input, tipo) {
            $input.attr('placeholder', (tipo === 'DIMEX' || tipo === 'Dimex') ? '000000000000' : '0-0000-0000');
        }

        $identificacion.on('input', function () {
            $identificacion.val(formatearIdentificacion($identificacion.val(), $tipoIdentificacion.val()));
        });

        $tipoIdentificacion.on('change', function () {
            $identificacion.val('');
            actualizarPlaceholder($identificacion, $tipoIdentificacion.val());
        });

        $('#loginForm').on('submit', function (event) {
            const tipo = $tipoIdentificacion.val();
            const identificacion = $identificacion.val();

            if (!validarIdentificacion(identificacion, tipo)) {
                $identificacion.addClass('is-invalid');
                $identificacionError.text('Ingrese un número de identificación válido.');
                event.preventDefault();
                event.stopPropagation();
            } else {
                $identificacion.removeClass('is-invalid');
            }

            if (!this.checkValidity()) {
                event.preventDefault();
                event.stopPropagation();
            }

            this.classList.add('was-validated');
        });

        $('#togglePassword').on('click', function () {
            const $password = $('#contrasena');
            const $icon = $(this).find('i');
            const showing = $password.attr('type') === 'text';

            $password.attr('type', showing ? 'password' : 'text');
            $icon.toggleClass('bi-eye', showing);
            $icon.toggleClass('bi-eye-slash', !showing);
            $(this)
                .attr('aria-label', showing ? 'Mostrar contraseña' : 'Ocultar contraseña')
                .attr('title', showing ? 'Mostrar contraseña' : 'Ocultar contraseña');
        });

        $resetIdentificacion.on('input', function () {
            $resetIdentificacion.val(formatearIdentificacion($resetIdentificacion.val(), $resetTipoIdentificacion.val()));
        });

        $resetTipoIdentificacion.on('change', function () {
            $resetIdentificacion.val('');
            actualizarPlaceholder($resetIdentificacion, $resetTipoIdentificacion.val());
        });

        $('#sendResetEmailBtn').on('click', function () {
            const tipoIdentificacion = $resetTipoIdentificacion.val();
            const cedula = $resetIdentificacion.val();

            if (!validarIdentificacion(cedula, tipoIdentificacion)) {
                $resetIdentificacion.addClass('is-invalid');
                Swal.fire({
                    icon: 'warning',
                    title: 'Identificación inválida',
                    text: 'Revise el formato del número de identificación.',
                    confirmButtonColor: '#d33',
                    confirmButtonText: 'Aceptar'
                });
                return;
            }

            $resetIdentificacion.removeClass('is-invalid');

            $.ajax({
                url: '@Url.Action("ResetPassword", "Usuarios")',
                type: 'POST',
                data: {
                    ResetTipoIdentificacion: tipoIdentificacion,
                    ResetCedula: cedula
                },
                success: function (response) {
                    if (response.success) {
                        $('#forgotPasswordModal').modal('hide');
                        Swal.fire({
                            icon: 'success',
                            title: 'Correo enviado',
                            text: 'Se ha enviado un correo con las instrucciones para restablecer su contraseña.',
                            confirmButtonColor: '#0563bb',
                            confirmButtonText: 'Aceptar'
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: response.message,
                            confirmButtonColor: '#d33',
                            confirmButtonText: 'Aceptar'
                        });
                    }
                },
                error: function () {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error de conexión',
                        text: 'Hubo un problema al procesar su solicitud. Intente nuevamente.',
                        confirmButtonColor: '#d33',
                        confirmButtonText: 'Aceptar'
                    });
                }
            });
        });
    });
</script>
