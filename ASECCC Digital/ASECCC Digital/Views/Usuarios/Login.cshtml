@model ASECCC_Digital.Entities.Usuario
@{
    ViewBag.Title = "Login";
    Layout = "~/Views/Shared/_Layout_Externo.cshtml";
}
<main class="login-shell">
    <section class="login-panel" aria-label="Inicio de sesion ASECCC Digital">
        <div class="login-brand">
            <img src="@Url.Content("~/Assets/img/logos/ASECCC_LOGO_1.png")" alt="ASECCC" class="login-brand-logo" />

            <div class="login-brand-copy">
                <h1>ASECCC Digital</h1>
                <p>Acceda de forma segura a sus servicios de ahorro, aportes, prestamos, beneficios y notificaciones.</p>
                <div class="login-brand-meta" aria-label="Servicios disponibles">
                    <span><i class="bi bi-shield-check"></i> Acceso seguro</span>
                    <span><i class="bi bi-bank"></i> Servicios asociados</span>
                </div>
            </div>
        </div>

        <div class="login-form-section">
            <div class="login-form-wrap">
                <div class="login-eyebrow">
                    <i class="bi bi-person-circle"></i>
                    Portal de asociados
                </div>
                <h2>Iniciar sesion</h2>
                <p class="login-subtitle">Ingrese sus credenciales para continuar.</p>

                @using (Html.BeginForm("Login", "Usuarios", FormMethod.Post, new { id = "loginForm", @class = "needs-validation", novalidate = "novalidate" }))
                {
                    @Html.AntiForgeryToken()

                    <div class="login-field">
                        @Html.Label("TipoIdentificacion", "Tipo de identificacion", new { @class = "form-label" })
                        @Html.DropDownList("TipoIdentificacion", new SelectList(new[] {
                            new { Value = "Cedula", Text = "Cedula Nacional" },
                            new { Value = "DIMEX", Text = "Identificacion DIMEX" }
                        }, "Value", "Text"), new { @class = "form-control", required = "required", id = "tipoIdentificacion" })
                        <div class="invalid-feedback">
                            Seleccione un tipo de identificacion.
                        </div>
                    </div>

                    <div class="login-field">
                        @Html.Label("identificacion", "Numero de identificacion", new { @class = "form-label" })
                        @Html.TextBox("identificacion", null, new { @class = "form-control", placeholder = "0-0000-0000", required = "required", maxlength = "12", id = "identificacion", autocomplete = "username" })
                        <div class="invalid-feedback" id="identificacionError">
                            Ingrese un número de identificacion válido.
                        </div>
                    </div>

                    <div class="login-field">
                        <label for="contrasena" class="form-label">Contrase&ntilde;a</label>
                        <div class="input-group login-password-group">
                            @Html.Password("contrasena", null, new { @class = "form-control", required = "required", id = "contrasena", autocomplete = "current-password", placeholder = "Ingrese su contraseña" })
                            <div class="input-group-append">
                                <button type="button" class="btn login-password-toggle" id="togglePassword" aria-label="Mostrar contraseña" title="Mostrar contraseña">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                            <div class="invalid-feedback">
                                Ingrese su contraseña.
                            </div>
                        </div>
                    </div>

                    <div class="login-actions">
                        <button type="button" class="login-forgot-link" data-toggle="modal" data-target="#forgotPasswordModal">
                            ¿Olvido su contraseña?
                        </button>
                    </div>

                    <button type="submit" class="btn btn-primary login-submit">
                        Iniciar sesion
                    </button>
                }
            </div>
        </div>
    </section>
</main>

<div class="modal fade login-modal" id="forgotPasswordModal" tabindex="-1" role="dialog" aria-labelledby="forgotPasswordModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="forgotPasswordModalLabel">Restablecer contraseña</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="forgotPasswordForm" class="needs-validation" novalidate>
                    <div class="form-group">
                        <label for="ResetTipoIdentificacion">Tipo de identificación</label>
                        <select id="ResetTipoIdentificacion" class="form-control" required>
                            <option value="Nacional">Cédula Nacional</option>
                            <option value="Dimex">Identificación DIMEX</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="ResetCedula">Número de identificación</label>
                        <input type="text" id="ResetCedula" class="form-control" placeholder="0-0000-0000" required maxlength="12" autocomplete="username">
                        <div class="invalid-feedback">
                            Ingrese un número de identificación válido.
                        </div>
                    </div>
                </form>
                <div id="resetPasswordMessage" class="mt-3"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="sendResetEmailBtn">Enviar instrucciones</button>
            </div>
        </div>
    </div>
</div>

<script>
    window.loginConfig = {
        loginError: '@System.Web.HttpUtility.JavaScriptStringEncode(Convert.ToString(TempData["LoginError"]))',
        resetPasswordUrl: '@Url.Action("ResetPassword","Usuarios")'
    };
</script>

<script src="~/Scripts/Asociados/login.js"></script>